{
  "title": "Camp Raid",
  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><p class=\"mw-empty-elt\">\n</p><aside role=\"region\" class=\"portable-infobox pi-background pi-border-color pi-theme-wikia pi-layout-stacked\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"title\">Camp Raid</h2>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"type\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Quest Type</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Side_Quests\" class=\"mw-redirect\" title=\"Side Quests\">Side</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"startLocation\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Starting Location</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Clouded_Cliffs\" title=\"Clouded Cliffs\">Clouded Cliffs</a>,&#32;<a href=\"/wiki/Gorges_of_Spirits\" title=\"Gorges of Spirits\">Gorges of Spirits</a>,&#32;<a href=\"/wiki/Huanglong\" title=\"Huanglong\">Huanglong</a></div>\n</div>\n<section class=\"pi-item pi-group pi-border-color\">\n\t\n\t<section class=\"pi-item pi-panel pi-border-color wds-tabber\">\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tabs__wrapper\">\n\t\t\t\t<ul class=\"wds-tabs\">\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab wds-is-current\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tRewards\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tCharacters\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tab__content wds-is-current\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"rewards\">\n\t\n\t<div class=\"pi-data-value pi-font\"><span class=\"card-list-container\"><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-5\"><span typeof=\"mw:File\"><a href=\"/wiki/Union_EXP\" title=\"Union EXP\"><img alt=\"Union EXP\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Union EXP.png\" data-image-key=\"Item_Union_EXP.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0b/Item_Union_EXP.png/revision/latest/scale-to-width-down/74?cb=20240525121935\" /></a></span></span><span class=\"card-text card-font\"> 500</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-5\"><span typeof=\"mw:File\"><a href=\"/wiki/Astrite\" title=\"Astrite\"><img alt=\"Astrite\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Astrite.png\" data-image-key=\"Item_Astrite.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/1/16/Item_Astrite.png/revision/latest/scale-to-width-down/74?cb=20240523021541\" /></a></span></span><span class=\"card-text card-font\"> 40</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-4\"><span typeof=\"mw:File\"><a href=\"/wiki/Advanced_Resonance_Potion\" title=\"Advanced Resonance Potion\"><img alt=\"Advanced Resonance Potion\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Advanced Resonance Potion.png\" data-image-key=\"Item_Advanced_Resonance_Potion.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/e/e2/Item_Advanced_Resonance_Potion.png/revision/latest/scale-to-width-down/74?cb=20240524152949\" /></a></span></span><span class=\"card-text card-font\"> 2</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-4\"><span typeof=\"mw:File\"><a href=\"/wiki/Advanced_Energy_Core\" title=\"Advanced Energy Core\"><img alt=\"Advanced Energy Core\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Advanced Energy Core.png\" data-image-key=\"Item_Advanced_Energy_Core.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/b/b5/Item_Advanced_Energy_Core.png/revision/latest/scale-to-width-down/74?cb=20240524153038\" /></a></span></span><span class=\"card-text card-font\"> 2</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-3\"><span typeof=\"mw:File\"><a href=\"/wiki/Shell_Credit\" title=\"Shell Credit\"><img alt=\"Shell Credit\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Shell Credit.png\" data-image-key=\"Item_Shell_Credit.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d1/Item_Shell_Credit.png/revision/latest/scale-to-width-down/74?cb=20240523132525\" /></a></span></span><span class=\"card-text card-font\"> 18,000</span></span></div></span></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t\t\t<div class=\"wds-tab__content\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"characters\">\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Cunren\" title=\"Cunren\">Cunren</a>, <a href=\"/wiki/Lingdi\" title=\"Lingdi\">Lingdi</a></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t</section>\n\n\n\n\n</section>\n</aside>\n<b>Camp Raid</b> is a <a href=\"/wiki/Side_Quest\" title=\"Side Quest\">Side Quest</a> that occurs in <a href=\"/wiki/Gorges_of_Spirits\" title=\"Gorges of Spirits\">Gorges of Spirits</a>, <a href=\"/wiki/Huanglong\" title=\"Huanglong\">Huanglong</a>, [[{{{nation}}}]].\n<p class=\"mw-empty-elt\"></p>\n<div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Steps\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Steps</span></a></li>\n<li class=\"toclevel-1 tocsection-2\"><a href=\"#Gameplay_Notes\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">Gameplay Notes</span></a></li>\n<li class=\"toclevel-1 tocsection-3\"><a href=\"#Dialogue\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">Dialogue</span></a></li>\n<li class=\"toclevel-1 tocsection-4\"><a href=\"#Other_Languages\"><span class=\"tocnumber\">4</span> <span class=\"toctext\">Other Languages</span></a></li>\n<li class=\"toclevel-1 tocsection-5\"><a href=\"#Change_History\"><span class=\"tocnumber\">5</span> <span class=\"toctext\">Change History</span></a></li>\n<li class=\"toclevel-1 tocsection-6\"><a href=\"#Navigation\"><span class=\"tocnumber\">6</span> <span class=\"toctext\">Navigation</span></a></li>\n</ul>\n</div>\n\n<h2><span class=\"mw-headline\" id=\"Steps\">Steps</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ol><li>Head to the makeshift camp halfway up the mountain</li>\n<li>Inquire the team members about what happened</li>\n<li>Wait until 12:00 PM</li>\n<li>Ask Lingdi about the situation</li>\n<li>Head to the observation camp</li>\n<li>Rescue the \"hostages\" trapped in the camp</li>\n<li>Defeat the Exiles in the observation camp\n<ul><li>Defeat the Exiles at the elevated position in the camp</li>\n<li>Defeat the Exiles in the center of the camp</li></ul></li>\n<li>Talk to Cunren</li></ol>\n<h2><span class=\"mw-headline\" id=\"Gameplay_Notes\">Gameplay Notes</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ul><li>Completing this quest grants the <i><a href=\"/wiki/Huanglong_I\" class=\"mw-redirect\" title=\"Huanglong I\">Huanglong I</a></i> trophy <i><a href=\"/wiki/The_Brave_Wins_When_Paths_Cross!\" title=\"The Brave Wins When Paths Cross!\">The Brave Wins When Paths Cross!</a></i></li></ul>\n<h2><span class=\"mw-headline\" id=\"Dialogue\">Dialogue</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<dd><div class=\"description-wrapper\"><div class=\"description-title\"><b><span typeof=\"mw:File\"><span><img alt=\"UI Quest\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0f/UI_Quest.png/revision/latest/scale-to-width-down/20?cb=20260501180345\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element\" data-image-name=\"UI Quest.png\" data-image-key=\"UI_Quest.png\" data-relevant=\"0\" /></span></span> Quest Description</b></div><hr class=\"description-separator\" /><div class=\"description-content\">Outrider Cunren is recruiting new members for a plan to raid the observation camp at the mountaintop in the Gorges of Spirits. However, it seems that the Outriders were only assigned a reconnaissance mission. Why is Cunren acting on his own?</div></div></dd>\n<div class=\"dialogue\">\n<dl><dt>(Head to the makeshift camp halfway up the mountain)</dt>\n<dd><b>Cunren:</b> A bunch of Exiles? What's there to fear?</dd>\n<dd><b>Lingdi:</b> We've been told to investigate. Don't rush in.</dd>\n<dd><b>Cunren:</b> I say we storm in, and take'em down. All of 'em.</dd>\n<dd><b>Lingdi:</b> H-Have you lost your mind? I'm not going with you!</dd></dl>\n<hr />\n<dl><dt>(Inquire the team members about what happened)</dt>\n<dd><b>Cunren:</b> We can take that camp down today with just a few soldiers.</dd>\n<dd><b>Lingdi:</b> But we're just here for reconnaissance...</dd>\n<dd><b>Cunren:</b> Just a pack of thieves inside. What's there to fear? They're getting in the way of our scouts' ability to watch the frontlines!</dd>\n<dd><b>Lingdi:</b> The captain's orders were clear. No unsanctioned ops. Violators won't get away scot free. If he finds out, I don't even want to imagine...</dd>\n<dd><b>Cunren:</b> If he finds out what? He'll only hear of our victory and heap praise upon us.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" /></span></span> What are you talking about?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" /></span></span> What commendation?</dd>\n<dd><b>Lingdi:</b> Ah! It's an Exile, p-please, leave me be...</dd>\n<dd><b>Cunren:</b> What Exile... Look at his attire, does that scream thief to you?</dd>\n<dd><b>Lingdi:</b> Then... what are you?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> I was just passing by.\n<dl><dd><b>Cunren:</b> Just passing through? Not many wander these hills... but it's good timing. I'm in need of some help.</dd></dl></dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> I'm here to join you.\n<dl><dd><b>Cunren:</b> Sharp eyes, I like that. I'm a man of action. You seem like the capable sort, so let me introduce myself.</dd></dl></dd>\n<dd><b>Cunren:</b> We're a makeshift team, Outrider Squad. I'm Cunren, and this is Lingdi. We came to scout out the camp.</dd>\n<dd><b>Cunren:</b> But I've already figured out the situation. It's just a group of Exiles, so I'm launching the first attack!</dd>\n<dd><b>Cunren:</b> So, what's it gonna be? You in? Let's fight for the Midnight Rangers.</dd>\n<dd><b>Lingdi:</b> I don't want the captain giving me a tongue lashing. Don't drag me into this...</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Don't I need to ask your captain?\n<dl><dd><b>Cunren:</b> Why bother asking? We hit the camp early, give him a surprise. What's better than that?</dd></dl></dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> I'll think about it.</dd>\n<dd><span class=\"text-error\">Transcription missing</span></dd>\n<dd><b>Cunren:</b> Forget it. You two are too hesitant. I can't rely on you.</dd>\n<dd><b>Cunren:</b> I'll lead the charge at the set time. You just sit tight and wait for my victory lap.</dd>\n<dd><b>Lingdi:</b> Don't be so impulsive...</dd>\n<dd><b>Cunren:</b> Look at you, all scared. You'll regret not joining when you see me become a full-fledged Midnight Ranger.</dd></dl>\n<hr />\n<dl><dt>(Ask Lingdi about the situation)</dt>\n<dd><b>Lingdi:</b> Ah, you're here! Cunren has already led an attack on the camp, but...</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Just what?</dd>\n<dd><b>Lingdi:</b> Looks like they got tangled up in the Exiles' infighting. Haven't heard from them in a while.</dd>\n<dd><b>Lingdi:</b> The captain's still not back... I've got no idea what to do.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> It's time for me to step up.</dd>\n<dd><b>Lingdi:</b> You gonna head up there to help? But those Exiles...</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Don't worry, I'm strong.</dd>\n<dd><b>Lingdi:</b> Hmm... you do seem more reliable than Cunren, I believe in you.</dd>\n<dd><b>Lingdi:</b> Follow the path and you'll hit the camp. Some of our crew should be out front. You ask them for the details.</dd>\n<dd><b>Lingdi:</b> When the captain's back, I'll come with him to back you up. I'm counting on you.</dd></dl>\n<hr />\n<dl><dt>(Head to the observation camp)</dt>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Is he alright?</dd>\n<dd><b>Logistics Specialist:</b> It's just a scratch. I'm cleaning it up. Tough it out!</dd>\n<dd><b>Injured Passerby:</b> Oh, Uncle... Auntie! Next time, pick your own herbs! AGH-!</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Was he attacked by the Exiles?</dd>\n<dd><b>Logistics Specialist:</b> He's from the village at the foot of the mountain. Scratched himself on a branch while in the fields, that's all... The boy is dramatic.</dd>\n<dd><b>Logistics Specialist:</b> The camp's that way. I'll stay behind. Yes, yes, stop screaming! It's already bandaged!</dd>\n<dd><b>Injured Passerby:</b> Uncle... Auntie!</dd></dl>\n<hr />\n<dl><dt>(Rescue Unsatisfied Team Member)</dt>\n<dd><b>Unsatisfied Team Member:</b> Thank you... it seems that some of my brothers have been captured! I'd give anything to fight alongside them again...</dd></dl>\n<dl><dt>(Rescue Furious Team Member)</dt>\n<dt>(Idle speech)</dt>\n<dd><b>Fury Team Member:</b> When I get outta here... You're going to regret it...</dd>\n<dt>(When rescued)</dt>\n<dd><b>Fury Team Member:</b> I, Black Cyclone, have returned! Exiles, tremble!</dd></dl>\n<dl><dt>(Rescue Nervous Exile)</dt>\n<dd><b>Nervous Exile:</b> Finally rescued! You idiots, how did you end up locking up your own?</dd></dl>\n<hr />\n<dl><dt>(Talk to Cunren)</dt>\n<dd><b>Cunren:</b> It's finally finished. These cunning Exiles...</dd>\n<dd><b>Lingdi:</b> Phew... guess we dodged a bullet there.</dd>\n<dd><b>Lingdi:</b> Of course there is!</dd>\n<dd><b>Lingdi:</b> Thank you, that fight might've ended differently without you.</dd>\n<dd><b>Cunren:</b> Shouldn't you praise me for taking the initiative?</dd>\n<dd><b>Lingdi:</b> If it weren't for <span>(&#8205;&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"his\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">his</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for male Rover</span></span>&#8205;/<wbr />&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"her\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">her</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for female Rover</span></span>&#8205;&#8205;)</span> help, you might also be locked up right now.</dd>\n<dd><b>Lingdi:</b> The captain has already reported this to Jinzhou...</dd>\n<dd><b>Cunren:</b> Reported my outstanding combat performance?</dd>\n<dd><b>Lingdi:</b> Reported your negligence.</dd>\n<dd><b>Cunren:</b> What?! I thought doing this would be my ticket into the Midnight Rangers...</dd>\n<dd><b>Lingdi:</b> Forget a promotion into the Rangers. You'll be lucky to even stay in the Outriders.</dd>\n<dd><b>Cunren:</b> This... this can't be! Lingdi, can you help me plead with the captain?</dd>\n<dd><b>Lingdi:</b> You... The next time you rush in, think first, okay?</dd>\n<dd><b>Cunren:</b> Please, Lingdi! I have to join the Midnight Rangers. The future of the Midnight Rangers can't be without me!</dd>\n<dd><b>Lingdi:</b> Fine, I'll give it a shot... but you know the captain. Afterward, you'd better make sure you apologize. On your hands and knees, if need be.</dd>\n<dd><b>Cunren:</b> Thank you, Lingdi! When I become an official member, I'll owe you a feast.</dd>\n<dd><b>Lingdi:</b> Let's talk about that later. For now, just keep your head down.</dd>\n<dd><b>Cunren:</b> Relax, I won't move without the captain's word.</dd>\n<dd><b>Lingdi:</b> Sorry to bother you. The captain sent these spoils for you. Said he hopes they help.</dd>\n<dt>(Quest Complete)</dt></dl>\n</div>\n<h2><span class=\"mw-headline\" id=\"Other_Languages\">Other Languages</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<table class=\"article-table alternating-colors-table\"><tbody><tr><th>Language</th><th>Official Name</th></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji EN Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji EN Flag.png\" data-image-key=\"Emoji_EN_Flag.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/f/f5/Emoji_EN_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221541\" /></span></span></span>&#160;&#160;English</b></td><td>Camp Raid</td></tr><tr><td style=\"line-height:1em\"><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ZHS Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ZHS Flag.png\" data-image-key=\"Emoji_ZHS_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/5/5f/Emoji_ZHS_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221618\" /></span></span></span>&#160;&#160;Chinese <abbr title=\"Simplified\"><small>(S)</small></abbr></b></td><td><span lang=\"zh-Hans\">营地突袭</span></td></tr><tr><td style=\"line-height:1em\"><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ZHT Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ZHT Flag.png\" data-image-key=\"Emoji_ZHT_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/02/Emoji_ZHT_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221733\" /></span></span></span>&#160;&#160;Chinese <abbr title=\"Traditional\"><small>(T)</small></abbr></b></td><td><span lang=\"zh-Hant\">營地突襲</span></td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji JA Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji JA Flag.png\" data-image-key=\"Emoji_JA_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/8/84/Emoji_JA_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221804\" /></span></span></span>&#160;&#160;Japanese</b></td><td><span lang=\"ja\">拠点急襲</span></td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji KO Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji KO Flag.png\" data-image-key=\"Emoji_KO_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/5/5d/Emoji_KO_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221837\" /></span></span></span>&#160;&#160;Korean</b></td><td><span lang=\"ko\">캠프</span> <span lang=\"ko\">급습</span></td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji FR Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji FR Flag.png\" data-image-key=\"Emoji_FR_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/c/c6/Emoji_FR_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221935\" /></span></span></span>&#160;&#160;French</b></td><td>Le raid</td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji DE Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji DE Flag.png\" data-image-key=\"Emoji_DE_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/3/3b/Emoji_DE_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221959\" /></span></span></span>&#160;&#160;German</b></td><td>Lagerüberfall</td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ES Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ES Flag.png\" data-image-key=\"Emoji_ES_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d2/Emoji_ES_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221908\" /></span></span></span>&#160;&#160;Spanish</b></td><td>Incursión al campamento</td></tr></tbody></table>\n<h2><span class=\"mw-headline\" id=\"Change_History\">Change History</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<div class=\"change-history\"><div class=\"change-history-header\"><div>Released in <b><a href=\"/wiki/Version/1.0\" title=\"Version/1.0\">Version 1.0</a></b></div><div>[<a target=\"_blank\" rel=\"noreferrer noopener\" class=\"text\" href=\"https://wutheringwaves.fandom.com/wiki/Camp_Raid/Change_History?action=edit&amp;preload=Template:Change_History/Preload&amp;preloadparams%5b%5d=1.0&amp;preloadparams%5b%5d=Camp+Raid\">Create New History</a>]</div></div></div><div style=\"clear:both; margin:0; padding:0;\"></div>\n<h2><span class=\"mw-headline\" id=\"Navigation\">Navigation</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2></div>",
