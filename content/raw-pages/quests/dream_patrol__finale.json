{
  "title": "Dream Patrol: Finale",
  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><p class=\"mw-empty-elt\">\n</p><aside role=\"region\" class=\"portable-infobox pi-background pi-border-color pi-theme-wikia pi-layout-stacked\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"title\">Dream Patrol: Finale</h2>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"type\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Quest Type</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Tutorial_Quests\" class=\"mw-redirect\" title=\"Tutorial Quests\">Tutorial</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"requirement\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Requirements</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Defeat all Nightmare Echo.</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"description\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Description</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">The dust of Ragunna's Dreamscape Nodes incident has settled for now. Go talk to the white cat in Ragunna City.</div>\n</div>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<table class=\"pi-horizontal-group\">\n\t\n\t\n\t<thead>\n\t\t<tr>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"prev\">Previous Quest</th>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"next\">Next Quest</th>\n\t\t\n\t\t</tr>\n\t</thead>\n\t\n\t<tbody>\n\t<tr>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"prev\"><a href=\"/wiki/Dream_Patrol_II\" title=\"Dream Patrol II\">Dream Patrol II</a></td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"next\">N/A</td>\n\t\n\t</tr>\n\t</tbody>\n</table>\n\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n\t\n\t<section class=\"pi-item pi-panel pi-border-color wds-tabber\">\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tabs__wrapper\">\n\t\t\t\t<ul class=\"wds-tabs\">\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab wds-is-current\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tRewards\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tCharacters\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tab__content wds-is-current\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"rewards\">\n\t\n\t<div class=\"pi-data-value pi-font\"><span class=\"card-list-container\"><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-4\"><span typeof=\"mw:File\"><a href=\"/wiki/Advanced_Resonance_Potion\" title=\"Advanced Resonance Potion\"><img alt=\"Advanced Resonance Potion\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Advanced Resonance Potion.png\" data-image-key=\"Item_Advanced_Resonance_Potion.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/e/e2/Item_Advanced_Resonance_Potion.png/revision/latest/scale-to-width-down/74?cb=20240524152949\" /></a></span></span><span class=\"card-text card-font\"> 2</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-4\"><span typeof=\"mw:File\"><a href=\"/wiki/Advanced_Energy_Core\" title=\"Advanced Energy Core\"><img alt=\"Advanced Energy Core\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Advanced Energy Core.png\" data-image-key=\"Item_Advanced_Energy_Core.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/b/b5/Item_Advanced_Energy_Core.png/revision/latest/scale-to-width-down/74?cb=20240524153038\" /></a></span></span><span class=\"card-text card-font\"> 2</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-4\"><span typeof=\"mw:File\"><a href=\"/wiki/Advanced_Sealed_Tube\" title=\"Advanced Sealed Tube\"><img alt=\"Advanced Sealed Tube\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Advanced Sealed Tube.png\" data-image-key=\"Item_Advanced_Sealed_Tube.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d6/Item_Advanced_Sealed_Tube.png/revision/latest/scale-to-width-down/74?cb=20240529094344\" /></a></span></span><span class=\"card-text card-font\"> 1</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-3\"><span typeof=\"mw:File\"><a href=\"/wiki/Shell_Credit\" title=\"Shell Credit\"><img alt=\"Shell Credit\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Shell Credit.png\" data-image-key=\"Item_Shell_Credit.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d1/Item_Shell_Credit.png/revision/latest/scale-to-width-down/74?cb=20240523132525\" /></a></span></span><span class=\"card-text card-font\"> 10,000</span></span></div></span></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t\t\t<div class=\"wds-tab__content\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"characters\">\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Rover\" title=\"Rover\">Rover</a>, <a href=\"/wiki/Strange_White_Cat\" title=\"Strange White Cat\">Strange White Cat</a></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t</section>\n\n\n\n\n</section>\n</aside>\n\n<b>Dream Patrol: Finale</b> is a <a href=\"/wiki/Tutorial_Quest\" title=\"Tutorial Quest\">Tutorial Quest</a> that occurs in <a href=\"/wiki/Ragunna_City\" title=\"Ragunna City\">Ragunna City</a>, <a href=\"/wiki/Rinascita\" title=\"Rinascita\">Rinascita</a>, [[{{{nation}}}]].\n<p class=\"mw-empty-elt\"></p>\n<div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Steps\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Steps</span></a></li>\n<li class=\"toclevel-1 tocsection-2\"><a href=\"#Gameplay_Notes\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">Gameplay Notes</span></a></li>\n<li class=\"toclevel-1 tocsection-3\"><a href=\"#Dialogue\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">Dialogue</span></a></li>\n<li class=\"toclevel-1 tocsection-4\"><a href=\"#Other_Languages\"><span class=\"tocnumber\">4</span> <span class=\"toctext\">Other Languages</span></a></li>\n<li class=\"toclevel-1 tocsection-5\"><a href=\"#Change_History\"><span class=\"tocnumber\">5</span> <span class=\"toctext\">Change History</span></a></li>\n</ul>\n</div>\n\n<h2><span class=\"mw-headline\" id=\"Steps\">Steps</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ol><li>Talk to the strange white cat in Ragunna City</li></ol>\n<h2><span class=\"mw-headline\" id=\"Gameplay_Notes\">Gameplay Notes</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ul><li>Completing the quest awards the player <span class=\"item\"><span class=\"item-image\"><span class=\"hidden\" style=\"height:30px;width:30px\"><span typeof=\"mw:File\"><a href=\"/wiki/Loneliness_of_the_Deep_Sea\" title=\"Loneliness of the Deep Sea\"><img alt=\"Loneliness of the Deep Sea\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/a/ab/Item_Loneliness_of_the_Deep_Sea.png/revision/latest/scale-to-width-down/30?cb=20250111003739\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" class=\"mw-file-element\" data-image-name=\"Item Loneliness of the Deep Sea.png\" data-image-key=\"Item_Loneliness_of_the_Deep_Sea.png\" data-relevant=\"1\" /></a></span></span><span class=\"mobile-only\"><span typeof=\"mw:File\"><a href=\"/wiki/Loneliness_of_the_Deep_Sea\" title=\"Loneliness of the Deep Sea\"><img alt=\"Loneliness of the Deep Sea\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/a/ab/Item_Loneliness_of_the_Deep_Sea.png/revision/latest/scale-to-width-down/30?cb=20250111003739\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" class=\"mw-file-element\" data-image-name=\"Item Loneliness of the Deep Sea.png\" data-image-key=\"Item_Loneliness_of_the_Deep_Sea.png\" data-relevant=\"1\" /></a></span></span></span><span class=\"item-text\"> <a href=\"/wiki/Loneliness_of_the_Deep_Sea\" title=\"Loneliness of the Deep Sea\">Loneliness of the Deep Sea</a></span></span> and <i><a href=\"/wiki/Footprints_in_Rinascita_II\" title=\"Footprints in Rinascita II\">Footprints in Rinascita II</a></i> trophy <i><a href=\"/wiki/Why_Is_a_Raven_Like_a_Writing_Desk\" title=\"Why Is a Raven Like a Writing Desk\">Why Is a Raven Like a Writing Desk</a></i>.</li></ul>\n<h2><span class=\"mw-headline\" id=\"Dialogue\">Dialogue</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<dd><div class=\"description-wrapper\"><div class=\"description-title\"><b><span typeof=\"mw:File\"><span><img alt=\"UI Quest\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0f/UI_Quest.png/revision/latest/scale-to-width-down/20?cb=20260501180345\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element\" data-image-name=\"UI Quest.png\" data-image-key=\"UI_Quest.png\" data-relevant=\"0\" /></span></span> Quest Description</b></div><hr class=\"description-separator\" /><div class=\"description-content\">The dust of Ragunna's Dreamscape Nodes incident has settled for now. Go talk to the white cat in Ragunna City.</div></div></dd>\n<div class=\"dialogue\">\n<dl><dd><b>Strange White Cat:</b> Well done, (&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Rover\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Rover</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">The player's chosen name for Rover</span></span>&#8205;). I can feel that all the Dreamscape nodes are now connected.</dd>\n<dd><b>Strange White Cat:</b> The hidden threats have been cleared... I've prepared your rewards, meow. Let's discuss the details in person.</dd></dl>\n<hr />\n<dl><dt>(Talk to the Strange White Cat)</dt>\n<dd><b>Strange White Cat:</b> Good job, (&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Rover\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Rover</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">The player's chosen name for Rover</span></span>&#8205;)! I knew you could do it.</dd>\n<dd><b>Strange White Cat:</b> Now the dream frequency in the Ragunna region is stable... Hmm, how should I say this... It feels very... Rinascita.</dd>\n<dd><b>Strange White Cat:</b> Just like people from Jinzhou often dream of the Moon-Chasing Festival or Loong Whiskers Crisp, the most common dreams in Ragunna are about prayers, pizza, opera, and the Carnevale.</dd>\n<dd><b>Strange White Cat:</b> From these dreams, it seems the people in Ragunna live quite happily... So why is there such a turbulent subconscious lurking beneath the surface?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Are deep-sea monster stories popular lately?\n<dl><dd><b>Strange White Cat:</b>  I really don't get it, meow, why would anyone like such terrifying things?! The deep sea is so dark, and I can't even swim, meow.</dd></dl></dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Maybe the Order is hiding something...\n<dl><dd><b>Strange White Cat:</b> I'm not sure about that... but there are surprisingly few dreams from Order members in these samples... What's going on?</dd></dl></dd>\n<dd><b>Strange White Cat:</b> Let's leave that for later. In time, the Somnoire in Ragunna will be fully established.</dd>\n<dd><b>Strange White Cat:</b> Thank you again for all your help (&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Rover\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Rover</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">The player's chosen name for Rover</span></span>&#8205;). By the way, in addition to the agreed reward, I want to give you this as a keepsake.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> What is this?</dd>\n<dd><b>Strange White Cat:</b> This is a unique sample I found in a Dreamscape Node. I'm not sure what it's for yet, but it certainly looks exquisite.</dd>\n<dd><b>Strange White Cat:</b> Maybe one day it will come in handy.</dd>\n<dt>(Quest Complete)</dt></dl>\n</div>\n<h2><span class=\"mw-headline\" id=\"Other_Languages\">Other Languages</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<table class=\"article-table alternating-colors-table\"><tbody><tr><th>Language</th><th>Official Name</th></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji EN Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji EN Flag.png\" data-image-key=\"Emoji_EN_Flag.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/f/f5/Emoji_EN_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221541\" /></span></span></span>&#160;&#160;English</b></td><td>Dream Patrol: Finale</td></tr><tr><td style=\"line-height:1em\"><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ZHS Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ZHS Flag.png\" data-image-key=\"Emoji_ZHS_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/5/5f/Emoji_ZHS_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221618\" /></span></span></span>&#160;&#160;Chinese <abbr title=\"Simplified\"><small>(S)</small></abbr></b></td><td><span lang=\"zh-Hans\">巡礼之梦・尾声</span></td></tr><tr><td style=\"line-height:1em\"><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ZHT Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ZHT Flag.png\" data-image-key=\"Emoji_ZHT_Flag.png\" data-rel