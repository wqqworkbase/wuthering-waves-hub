{
  "title": "Restore Plushie Village IV",
  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><div class=\"mbox stub\" style=\"border-left-width:8px;margin-bottom:5px;border-left-color:#d6d6d6;position:relative;display:flex;border-radius:3px;border:1px solid #d6d6d6;min-height:32px\"><div class=\"mbox&#95;&#95;content\" style=\"display:table;padding:8px 15px;width:100%;box-sizing:border-box\"><div class=\"mbox&#95;&#95;content&#95;&#95;image mw-collapsible\" id=\"mw-customcollapsible-mbox\" style=\"text-align:center;padding-right:15px;display:table-cell;height:100%;vertical-align:middle;width:40px\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/wutheringwaves/images/e/e8/Baizhi_Sticker_Slice_of_Life_01_08.png/revision/latest?cb=20240703174053\" class=\"mw-file-description image\"><img alt=\"Baizhi Sticker Slice of Life 01 08\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/e/e8/Baizhi_Sticker_Slice_of_Life_01_08.png/revision/latest/scale-to-width-down/65?cb=20240703174053\" decoding=\"async\" loading=\"lazy\" width=\"65\" height=\"65\" class=\"mw-file-element\" data-image-name=\"Baizhi Sticker Slice of Life 01 08.png\" data-image-key=\"Baizhi_Sticker_Slice_of_Life_01_08.png\" data-relevant=\"1\" /></a></span></div><div class=\"mbox&#95;&#95;content&#95;&#95;wrapper\" style=\"display:table-cell;vertical-align:middle\"><div class=\"mbox&#95;&#95;content&#95;&#95;header\" style=\"display:block;font-weight:bold\">This <a href=\"/wiki/Category:Article_Stubs\" title=\"Category:Article Stubs\">page</a> is in need of information.</div><div class=\"mbox&#95;&#95;content&#95;&#95;text mw-collapsible\" id=\"mw-customcollapsible-mbox\" style=\"display:block\">Can you help out? <a target=\"_blank\" rel=\"noreferrer noopener\" class=\"text\" href=\"https://wutheringwaves.fandom.com/wiki/Restore_Plushie_Village_IV?action=edit\">Click here to add more.</a></div><span class=\"mbox&#95;&#95;close mw-customtoggle-mbox\" title=\"Dismiss\" style=\"color:#bbb;right:0;cursor:pointer;font-size:16px;top:0;transition:all .15s ease-in;position:absolute;padding:2px 7px;font-weight:bold\"></span></div></div></div><p class=\"mw-empty-elt\">\n</p><aside role=\"region\" class=\"portable-infobox pi-background pi-border-color pi-theme-wikia pi-layout-stacked\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"title\">Restore Plushie Village IV</h2>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"type\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Quest Type</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Side_Quests\" class=\"mw-redirect\" title=\"Side Quests\">Side</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"requirement\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Requirements</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Reach <a href=\"/wiki/Rinascita_Sonance_Casket_Collector\" title=\"Rinascita Sonance Casket Collector\">Rinascita Sonance Casket Collector</a> Level 10.</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"startLocation\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Starting Location</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Garden_of_the_Lost\" title=\"Garden of the Lost\">Garden of the Lost</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"description\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Description</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Finally, the restoration of the Plushie Village is complete! There will be a small celebration party and you're invited!</div>\n</div>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<table class=\"pi-horizontal-group\">\n\t\n\t\n\t<thead>\n\t\t<tr>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"prev\">Previous Quest</th>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"next\">Next Quest</th>\n\t\t\n\t\t</tr>\n\t</thead>\n\t\n\t<tbody>\n\t<tr>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"prev\"><a href=\"/wiki/Restore_Plushie_Village_III\" title=\"Restore Plushie Village III\">Restore Plushie Village III</a></td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"next\">N/A</td>\n\t\n\t</tr>\n\t</tbody>\n</table>\n\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n\t\n\t<section class=\"pi-item pi-panel pi-border-color wds-tabber\">\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tabs__wrapper\">\n\t\t\t\t<ul class=\"wds-tabs\">\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab wds-is-current\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tRewards\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tCharacters\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tab__content wds-is-current\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"rewards\">\n\t\n\t<div class=\"pi-data-value pi-font\"><span class=\"card-list-container\"><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-5\"><span typeof=\"mw:File\"><a href=\"/wiki/Astrite\" title=\"Astrite\"><img alt=\"Astrite\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Astrite.png\" data-image-key=\"Item_Astrite.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/1/16/Item_Astrite.png/revision/latest/scale-to-width-down/74?cb=20240523021541\" /></a></span></span><span class=\"card-text card-font\"> 20</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-4\"><span typeof=\"mw:File\"><a href=\"/wiki/Advanced_Resonance_Potion\" title=\"Advanced Resonance Potion\"><img alt=\"Advanced Resonance Potion\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Advanced Resonance Potion.png\" data-image-key=\"Item_Advanced_Resonance_Potion.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/e/e2/Item_Advanced_Resonance_Potion.png/revision/latest/scale-to-width-down/74?cb=20240524152949\" /></a></span></span><span class=\"card-text card-font\"> 2</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-4\"><span typeof=\"mw:File\"><a href=\"/wiki/Advanced_Sealed_Tube\" title=\"Advanced Sealed Tube\"><img alt=\"Advanced Sealed Tube\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Advanced Sealed Tube.png\" data-image-key=\"Item_Advanced_Sealed_Tube.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d6/Item_Advanced_Sealed_Tube.png/revision/latest/scale-to-width-down/74?cb=20240529094344\" /></a></span></span><span class=\"card-text card-font\"> 1</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-3\"><span typeof=\"mw:File\"><a href=\"/wiki/Shell_Credit\" title=\"Shell Credit\"><img alt=\"Shell Credit\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Shell Credit.png\" data-image-key=\"Item_Shell_Credit.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d1/Item_Shell_Credit.png/revision/latest/scale-to-width-down/74?cb=20240523132525\" /></a></span></span><span class=\"card-text card-font\"> 24,000</span></span></div></span></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t\t\t<div class=\"wds-tab__content\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"characters\">\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Fulmine\" title=\"Fulmine\">Fulmine</a>, <a href=\"/wiki/Rover\" title=\"Rover\">Rover</a></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t</section>\n\n\n\n\n</section>\n</aside>\n<b>Restore Plushie Village IV</b> is a <a href=\"/wiki/Side_Quest\" title=\"Side Quest\">Side Quest</a> that occurs in <a href=\"/wiki/Thessaleo_Fells\" title=\"Thessaleo Fells\">Thessaleo Fells</a>, <a href=\"/wiki/Rinascita\" title=\"Rinascita\">Rinascita</a>, [[{{{nation}}}]].\n<p class=\"mw-empty-elt\"></p><div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Steps\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Steps</span></a></li>\n<li class=\"toclevel-1 tocsection-2\"><a href=\"#Gameplay_Notes\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">Gameplay Notes</span></a></li>\n<li class=\"toclevel-1 tocsection-3\"><a href=\"#Dialogue\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">Dialogue</span></a></li>\n<li class=\"toclevel-1 tocsection-4\"><a href=\"#Other_Languages\"><span class=\"tocnumber\">4</span> <span class=\"toctext\">Other Languages</span></a></li>\n<li class=\"toclevel-1 tocsection-5\"><a href=\"#Change_History\"><span class=\"tocnumber\">5</span> <span class=\"toctext\">Change History</span></a></li>\n</ul>\n</div>\n\n<h2><span class=\"mw-headline\" id=\"Steps\">Steps</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ol><li>Return to Plushie Village in two days</li>\n<li>(Optional) Talk to the bakery apprentice</li>\n<li>Talk to Fulmine</li></ol>\n<h2><span class=\"mw-headline\" id=\"Gameplay_Notes\">Gameplay Notes</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ul><li>Completing this quest awards <span class=\"item\"><span class=\"item-image\"><span class=\"hidden\" style=\"height:30px;width:30px\"><span typeof=\"mw:File\"><a href=\"/wiki/Bell_of_Resonance\" title=\"Bell of Resonance\"><img alt=\"Bell of Resonance\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/74/Item_Bell_of_Resonance.png/revision/latest/scale-to-width-down/30?cb=20250111202956\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" class=\"mw-file-element\" data-image-name=\"Item Bell of Resonance.png\" data-image-key=\"Item_Bell_of_Resonance.png\" data-relevant=\"1\" /></a></span></span><span class=\"mobile-only\"><span typeof=\"mw:File\"><a href=\"/wiki/Bell_of_Resonance\" title=\"Bell of Resonance\"><img alt=\"Bell of Resonance\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/74/Item_Bell_of_Resonance.png/revision/latest/scale-to-width-down/30?cb=20250111202956\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" class=\"mw-file-element\" data-image-name=\"Item Bell of Resonance.png\" data-image-key=\"Item_Bell_of_Resonance.png\" data-relevant=\"1\" /></a></span></span></span><span class=\"item-text\"> <a href=\"/wiki/Bell_of_Resonance\" title=\"Bell of Resonance\">Bell of Resonance</a></span></span> and <i><a href=\"/wiki/Footprints_in_Rinascita_I\" title=\"Footprints in Rinascita I\">Footprints in Rinascita I</a></i> trophy <i><a href=\"/wiki/Plushie_Village\" title=\"Plushie Village\">Plushie Village</a></i>.</li></ul>\n<h2><span class=\"mw-headline\" id=\"Dialogue\">Dialogue</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<dd><div class=\"description-wrapper\"><div class=\"description-title\"><b><span typeof=\"mw:File\"><span><img alt=\"UI Quest\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"UI Quest.png\" data-image-key=\"UI_Quest.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0f/UI_Quest.png/revision/latest/scale-to-width-down/20?cb=20260501180345\" /></span></span> Quest Description</b></div><hr class=\"description-separator\" /><div class=\"description-content\">Finally, the restoration of the Plushie Village is complete! There will be a small celebration party and you're invited!</div></div></dd><div class=\"dialogue\">\n<dl><dd><b>Rover:</b> (This frequency feels warm and strong. It seems the painting has been fully restored.)</dd>\n<dd><b>Fulmine:</b> <span>(&#8205;&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Mr.\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Mr.</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for male Rover</span></span>&#8205;/<wbr />&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Mrs.\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Mrs.</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for female Rover</span></span>&#8205;&#8205;)</span> (&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Rover\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Rover</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">The player's chosen name for Rover</span></span>&#8205;), happen to have any time to spare?</dd>\n<dd><b>Fulmine:</b> Thanks to all your hard work, Plushie Village is completely restored! I'm throwing a party for the Echoes in two days. Be sure to come!</dd></dl>\n<hr />\n<dl><dt>(Optional - Talk to the bakery apprentice)</dt>\n<dd><b>Apprentice:</b> Hey, don't waste food, you naughty Plushies!</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Old Bake is not coming back with you.</dd>\n<dd><b>Apprentice:</b> Oh, it's you. No need to be so serious—I'm just here to thank you for bringing Old Bake to this place the other day.</dd>\n<dd><b>Apprentice:</b> I was worried Old bake might feel bad for not being able to make bread, but it turns out I was overthinking it.</dd>\n<dd><b>Apprentice:</b> This is great! Now it can really enjoy its retirement, living with the Plushies in the village like a grandpa surrounded by his grandchildren.</dd>\n<dd><b>Apprentice:</b> Anyway, please take all the Baton Bread, or the Plushies are just gonna waste it all.</dd></dl>\n<hr />\n<dl><dt>(Talk to Fulmine)</dt>\n<dd><b>Fulmine:</b> Ah, <span>(&#8205;&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Mr.\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Mr.</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for male Rover</span></span>&#8205;/<wbr />&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Mrs.\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Mrs.</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for female Rover</span></span>&#8205;&#8205;)</span> (&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Rover\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Rover</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">The player's chosen name for Rover</span></span>&#8205;), here you are.</dd>\n<dd><b>Rover:</b> Are you doing this remotely now?</dd>\n<dd><b>Fulmine:</b> You see, some Echoes are still acting strange, even though we've restored the painting to its full power. I'm asking HQ to send more field investigators to get it sorted out.</dd>\n<dd><b>Fulmine:</b> Honestly, things could have been a lot worse without your help!</dd>\n<dd><b>Fulmine:</b> The Sonance Caskets you've collected have kept the village from falling apart along with the weakening painting. Otherwise, a lot more Echoes would be acting weird.</dd>\n<dd><b>Fulmine:</b> You gave me the chance to witness this beautiful scene where humans and Echoes live together in harmony.</dd>\n<dd><b>Fulmine:</b> No, I need to look at it with a new perspective.</dd>\n<dd><b>Fulmine:</b> Maybe it's a bit arrogant to think Echoes need to be tied to humans. The Echoes in Plushie Village have been supporting each other and have already found their own purpose in life.</dd>\n<dd><b>Fulmine:</b> Oh, by the way, I have something for you, <span>(&#8205;&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Mr.\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Mr.</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for male Rover</span></span>&#8205;/<wbr />&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Mrs.\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Mrs.</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for female Rover</span></span>&#8205;&#8205;)</span> (&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Rover\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Rover</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">The player's chosen name for Rover</span></span>&#8205;).</dd>\n<dd><b>Fulmine:</b> The Bells of Echoing Heart. The Plushies found them in the morph painting today.</dd>\n<dd><b>Fulmine:</b> They're a pair. When you ring one, the other will echo, no matter how far apart they are.</dd>\n<dd><b>Somehow, the Plushies are gathering around you.</b></dd>\n<dd><b>Fulmine:</b> Oh, looks like these little ones have figured out you're about to leave.</dd>\n<dd><b>Fulmine:</b> I think they gave you these bells to remind you that they'll always be here for you, no matter how far you go. The bells will keep echoing the bond between you.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> You're really making me cry now!</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Come on, this is not the last goodbye.</dd>\n<dd><b>Fulmine:</b> Haha, perhaps it's Rinascita's plays that have made me a little more dramatic.</dd>\n<dd><b>Fulmine:</b> Anyway, Plushie Village will always welcome you.</dd>\n<dd><b>Fulmine:</b> For now, let's just enjoy the party together!</dd>\n<dt>(Quest Complete)</dt></dl>\n</div>\n<h2><span class=\"mw-headline\" id=\"Other_Languages\">Other Languages</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<table class=\"article-table alternating-colors-table\"><tbody><tr><th>Language</th><th>Official Name</th></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji EN Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji EN Flag.png\" data-image-key=\"Emoji_EN_Flag.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/f/f5/Emoji_EN_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221541\" /></span></span></span>&#160;&#160;English</b></td><td>Restore Plushie Village IV</td></tr><tr><td style=\"line-height:1em\"><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ZHS Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ZHS Flag.png\" data-image-key=\"Emoji_ZHS_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/5/5f/Emoji_ZHS_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221618\" /></span></span></span>&#160;&#160;Chinese <abbr title=\"Simplified\"><small>(S)</small></abbr></b></td><td><span lang=\"zh-Hans\">重建布偶村・四期</span></td></tr><tr><td style=\"line-height:1em\"><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ZHT Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ZHT Flag.png\" data-image-key=\"Emoji_ZHT_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/ima