{
  "title": "The Best Audience",
  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><p class=\"mw-empty-elt\">\n</p><aside role=\"region\" class=\"portable-infobox pi-background pi-border-color pi-theme-wikia pi-layout-stacked\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"title\">The Best Audience</h2>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"type\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Quest Type</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Side_Quests\" class=\"mw-redirect\" title=\"Side Quests\">Side</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"requirement\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Requirements</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Complete <a href=\"/wiki/Main_Quest\" title=\"Main Quest\">Main Quest</a> <i><a href=\"/wiki/What_Yesterday_Wept,_Today_Doth_Sing\" title=\"What Yesterday Wept, Today Doth Sing\">What Yesterday Wept, Today Doth Sing</a></i> in <a href=\"/wiki/Chapter_II\" title=\"Chapter II\">Chapter II</a>&#58; Act III</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"startLocation\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Starting Location</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Egla_Town\" title=\"Egla Town\">Egla Town</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"description\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Description</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Lorenzo from Egla Town seems in need of help.</div>\n</div>\n<section class=\"pi-item pi-group pi-border-color\">\n\t\n\t<section class=\"pi-item pi-panel pi-border-color wds-tabber\">\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tabs__wrapper\">\n\t\t\t\t<ul class=\"wds-tabs\">\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab wds-is-current\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tRewards\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tCharacters\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tab__content wds-is-current\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"rewards\">\n\t\n\t<div class=\"pi-data-value pi-font\"><span class=\"card-list-container\"><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-5\"><span typeof=\"mw:File\"><a href=\"/wiki/Union_EXP\" title=\"Union EXP\"><img alt=\"Union EXP\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Union EXP.png\" data-image-key=\"Item_Union_EXP.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0b/Item_Union_EXP.png/revision/latest/scale-to-width-down/74?cb=20240525121935\" /></a></span></span><span class=\"card-text card-font\"> 200</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-5\"><span typeof=\"mw:File\"><a href=\"/wiki/Astrite\" title=\"Astrite\"><img alt=\"Astrite\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Astrite.png\" data-image-key=\"Item_Astrite.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/1/16/Item_Astrite.png/revision/latest/scale-to-width-down/74?cb=20240523021541\" /></a></span></span><span class=\"card-text card-font\"> 20</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-4\"><span typeof=\"mw:File\"><a href=\"/wiki/Advanced_Energy_Core\" title=\"Advanced Energy Core\"><img alt=\"Advanced Energy Core\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Advanced Energy Core.png\" data-image-key=\"Item_Advanced_Energy_Core.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/b/b5/Item_Advanced_Energy_Core.png/revision/latest/scale-to-width-down/74?cb=20240524153038\" /></a></span></span><span class=\"card-text card-font\"> 2</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-4\"><span typeof=\"mw:File\"><a href=\"/wiki/Advanced_Resonance_Potion\" title=\"Advanced Resonance Potion\"><img alt=\"Advanced Resonance Potion\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Advanced Resonance Potion.png\" data-image-key=\"Item_Advanced_Resonance_Potion.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/e/e2/Item_Advanced_Resonance_Potion.png/revision/latest/scale-to-width-down/74?cb=20240524152949\" /></a></span></span><span class=\"card-text card-font\"> 2</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-3\"><span typeof=\"mw:File\"><a href=\"/wiki/Shell_Credit\" title=\"Shell Credit\"><img alt=\"Shell Credit\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Shell Credit.png\" data-image-key=\"Item_Shell_Credit.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d1/Item_Shell_Credit.png/revision/latest/scale-to-width-down/74?cb=20240523132525\" /></a></span></span><span class=\"card-text card-font\"> 18,000</span></span></div></span></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t\t\t<div class=\"wds-tab__content\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"characters\">\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Chalulu\" title=\"Chalulu\">Chalulu</a>, <a href=\"/wiki/Lorenzo\" title=\"Lorenzo\">Lorenzo</a>, <span class=\"new\" title=\"Painter (page does not exist)\" data-uncrawlable-url=\"L3dpa2kvUGFpbnRlcj9hY3Rpb249ZWRpdCZyZWRsaW5rPTE=\">Painter</span>, <a href=\"/wiki/Rover\" title=\"Rover\">Rover</a></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t</section>\n\n\n\n\n</section>\n</aside>\n<b>The Best Audience</b> is a <a href=\"/wiki/Side_Quest\" title=\"Side Quest\">Side Quest</a> that occurs in <a href=\"/wiki/Whisperwind_Haven\" title=\"Whisperwind Haven\">Whisperwind Haven</a>, <a href=\"/wiki/Rinascita\" title=\"Rinascita\">Rinascita</a>, [[{{{nation}}}]].\n<p class=\"mw-empty-elt\"></p>\n<div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Steps\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Steps</span></a></li>\n<li class=\"toclevel-1 tocsection-2\"><a href=\"#Gameplay_Notes\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">Gameplay Notes</span></a></li>\n<li class=\"toclevel-1 tocsection-3\"><a href=\"#Dialogue\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">Dialogue</span></a></li>\n<li class=\"toclevel-1 tocsection-4\"><a href=\"#Note\"><span class=\"tocnumber\">4</span> <span class=\"toctext\">Note</span></a></li>\n<li class=\"toclevel-1 tocsection-5\"><a href=\"#Other_Languages\"><span class=\"tocnumber\">5</span> <span class=\"toctext\">Other Languages</span></a></li>\n<li class=\"toclevel-1 tocsection-6\"><a href=\"#Change_History\"><span class=\"tocnumber\">6</span> <span class=\"toctext\">Change History</span></a></li>\n</ul>\n</div>\n\n<h2><span class=\"mw-headline\" id=\"Steps\">Steps</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ol><li>Take five photos of graffiti with Chalulu (0/5)</li>\n<li>Follow Chalulu to find Painter</li></ol>\n<h2><span class=\"mw-headline\" id=\"Gameplay_Notes\">Gameplay Notes</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ul><li>Completing the quest awards <a href=\"/wiki/Crushed_Candy\" title=\"Crushed Candy\">Crushed Candy</a> and the <i><a href=\"/wiki/Footprints_in_Rinascita_I\" title=\"Footprints in Rinascita I\">Footprints in Rinascita I</a></i> trophy <i><a href=\"/wiki/Graffiti_Artist\" title=\"Graffiti Artist\">Graffiti Artist</a></i>.</li></ul>\n<h2><span class=\"mw-headline\" id=\"Dialogue\">Dialogue</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<dd><div class=\"description-wrapper\"><div class=\"description-title\"><b><span typeof=\"mw:File\"><span><img alt=\"UI Quest\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0f/UI_Quest.png/revision/latest/scale-to-width-down/20?cb=20260501180345\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element\" data-image-name=\"UI Quest.png\" data-image-key=\"UI_Quest.png\" data-relevant=\"0\" /></span></span> Quest Description</b></div><hr class=\"description-separator\" /><div class=\"description-content\">Lorenzo from Egla Town seems in need of help.</div></div></dd>\n<div class=\"dialogue\">\n<dl><dd><b>Lorenzo:</b> Ah, (&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Rover\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Rover</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">The player's chosen name for Rover</span></span>&#8205;)! What wind blows you here today?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" /></span></span> And what wind blows you here?</dd>\n<dd><b>Lorenzo:</b> Egla Town is where I grew up. I always come back during the troupe's off-seasons.</dd>\n<dd><b>Lorenzo:</b> And this time, I've invited someone special to join me. Chalulu, go ahead and say hello to (&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Rover\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Rover</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">The player's chosen name for Rover</span></span>&#8205;)!</dd>\n<dd><b>Chalulu:</b> Eeya&#8212;ha!</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" /></span></span> We've met in the troupe.</dd>\n<dd><b>Lorenzo:</b> Chalulu really seems to fancy you, (&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Rover\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Rover</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">The player's chosen name for Rover</span></span>&#8205;). You must have a charm that speaks to Echoes.</dd>\n<dd><b>Chalulu:</b> Eeya&#8212;eeya!</dd>\n<dd><b>Lorenzo:</b> Easy there, easy. Seems like she can't wait to share her new discoveries with you. Look&#8212;</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Is that… graffiti?</dd>\n<dd><b>Lorenzo:</b> There are more of them, and they aren't just any graffiti. I can feel a unique frequency lingering on them, likely from an Echo.</dd>\n<dd><i>Chalulu seems to be fascinated by the graffiti, her eyes studying every mark with an intense curiosity.</i></dd>\n<dd><b>Lorenzo:</b> If anyone tries to clean up the graffiti, Chalulu will dash over to stop them.</dd>\n<dd><b>Chalulu:</b> Ooh-la ooh-la ooh-la&#8212;ya-ha!</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> I never knew Echoes could paint.</dd>\n<dd><b>Lorenzo:</b> For Echoes with a strong urge to express themselves, graffiti might just be the easiest way.</dd>\n<dd><b>Lorenzo:</b> The question is, what is this kid trying to express? Makes you wonder, doesn't it?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Kid... that's an unusual way to put it.</dd>\n<dd><b>Lorenzo:</b> Ah, excuse me! Let's call this one \"Painter\" then.</dd>\n<dd><b>Lorenzo:</b> Speaking of Echoes, your connection with them is truly something else. You probably understand their \"thoughts\" better than I ever could.</dd>\n<dd><b>Lorenzo:</b> Could you photograph the artworks by Painter before they get wiped off? We might find something intriguing.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Alright, let's get started.</dd></dl>\n<hr />\n<dd><div class=\"description-wrapper\"><div class=\"description-title\"><b><span typeof=\"mw:File\"><span><img alt=\"UI Quest\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"UI Quest.png\" data-image-key=\"UI_Quest.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0f/UI_Quest.png/revision/latest/scale-to-width-down/20?cb=20260501180345\" /></span></span> Quest Description</b></div><hr class=\"description-separator\" /><div class=\"description-content\">Chalulu has reached the ideal spot for photographing the graffiti. Find her and follow her guidance to take photos.</div></div></dd>\n<hr />\n<dl><dd><b>Chalulu:</b> Eeya-ha!</dd>\n<dd>Chalulu points at the graffiti, as if reminding you to take a look at it now.</dd>\n<dt>(Take a photo)</dt>\n<dd><i>A moon and a sword.</i></dd>\n<dd><b>Lorenzo:</b> This one seems to be depicting the \"Night Reveries\" of Egla Town.</dd>\n<dd><b>Lorenzo:</b> At night, the villagers lock themselves away, while the knight Tacet Discord rises, sword in hand, under the pale moonlight.</dd></dl>\n<hr />\n<dl><dt>(Idle Chat from Background NPC)</dt>\n<dd>\n<dl><dt>Remarkable... it's almost as if the expressive graffiti has brought these dull stone walls to life.</dt>\n<dt>Grandpa, isn't calling graffiti \"remarkable\" a bit much? And it's in such a dangerous spot!</dt></dl></dd>\n<dd><b>Chalulu:</b> Ooh... Ooh-la, ooh-la...</dd>\n<dd>Chalulu's expression turns sad all of a sudden... What's troubling her?</dd>\n<dt>(Take photo)</dt></dl>\n<hr />\n<dl><dt>(Idle Chat from Background NPC)</dt>\n<dd>\n<dl><dt>Such fine strokes and daring colors. Who could be the artist?</dt>\n<dt>I say we just leave them as they are.</dt></dl></dd>\n<dd><b>Chalulu:</b> Eeya&#8212;eeya!</dd>\n<dd>Chalulu looks very excited! The truth could be at hand now.</dd>\n<dt>(Take a photo)</dt>\n<dd><i>A knight's mask and swords on one side, a black mask and brushes on the other.</i></dd>\n<dd><b>Lorenzo:</b> The knight is the only hero in the story, and the black mask likely stands for the side characters.</dd>\n<dd><b>Lorenzo:</b> I'd bet three Pizza Classica that the black mask symbolizes the evil giant's underling.</dd></dl>\n<hr />\n<dl><dd><b>Chalulu:</b> Ooh-la ooh-la?</dd>\n<dd>Chalulu is studying the graffiti, as if something's on her mind...</dd>\n<dt>(Take a photo)</dt>\n<dd><i>A sparkling eye... with a sword at its center?</i></dd>\n<dd><b>Lorenzo:</b> The sword must mean something important to Painter.</dd>\n<dd><b>Lorenzo:</b> And the sparkling eye might be a symbol of hope, or admiration.</dd></dl>\n<hr />\n<dl><dd><b>Chalulu:</b> Ya-hah!</dd>\n<dd>Chalulu's expression brightens. Did she just realize something?</dd>\n<dt>(Take a photo)</dt>\n<dd><i>A knight's mask, with crossing brush and sword.</i></dd>\n<dd><b>Lorenzo:</b> It seems to mean a face-off. The knight has to defeat the underling before the final battle with the giant.</dd></dl>\n<hr />\n<dl><dd><b>Lorenzo:</b> That's all the graffiti Chalulu wanted you to see. Let's meet at the usual place, (&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Rover\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Rover</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">The player's chosen name for Rover</span></span>&#8205;).</dd></dl>\n<hr />\n<dl><dd><b>Lorenzo:</b> What kind of role do you imagine Painter plays in the \"Night Reveries\"?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> A villain who clashes with the knight.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> A lovable, charming antagonist.</dd>\n<dd><b>Chalulu:</b> Ooh-la ooh-la!</dd>\n<dd><b>Lorenzo:</b> Glad we agree on that. Painter here is the classic villain in this story.</dd>\n<dd><b>Lorenzo:</b> Turns out the Cuddle Wuddle that plays the giant's underling is Painter himself...</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> You've seen this Painter before?</dd>\n<dd><b>Lorenzo:</b> Well… I was lucky enough to catch a glimpse of the \"Night Reveries.\"</dd>\n<dd><b>Lorenzo:</b> A valiant knight, an evil giant, and a crazed, cunning underling. The Echoes played their part so vividly. It all felt real.</dd>\n<dd><b>Lorenzo:</b> Eventually, as the first light of dawn broke, the knight felled the giant and his cursed underling. The Echoes then escorted the knight out of the town in cheers.</dd>\n<dd><b>Lorenzo:</b> But in a shadowed corner, the \"felled\" underling slowly rose, fumbling to remove his simple costume. Beneath it was no crazed minion&#8212;just a large, lonely Cuddle Wuddle.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> It's a little heartbreaking.</dd>\n<dd><b>Lorenzo:</b> Through tireless practice, day in and day out, Painter mastered the role of the villain, so convincingly that even the Mad Knight was fooled, believing he faced the true underling.</dd>\n<dd><b>Lorenzo:</b> However, flowers, applause, and cheers... are never meant for those who play the villains.</dd>\n<dd><b>Lorenzo:</b> \"If I could be the knight, the hero, would they cheer for me, too?\"</dd>\n<dd><b>Lorenzo:</b> Troubled by these thoughts, the Cuddle Wuddle picked up a brush and painted his feelings.</dd>\n<dd><b>Lorenzo:</b> The desire to play the knight and become the hero is but a reflection of something deeper. So, tell me, (&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Rover\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Rover</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">The player's chosen name for Rover</span></span>&#8205;), what do you think the Cuddle Wuddle truly wants?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Attention and recognition!</dd>\n<dd><b>Lorenzo:</b> And maybe a heartfelt \"Your performance was brilliant.\"</dd>\n<dd><b>Lorenzo:</b> (&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Rover\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Rover</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">The player's chosen name for Rover</span></span>&#8205;), would you help me find our dear Painter?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> We'll find him and shower him with compliments.</dd></dl>\n<hr />\n<dl><dd><i>Chalulu seems to have sensed \"Painter\"&#8212;better keep up with her!</i></dd></dl>\n<hr />\n<dd><div class=\"description-wrapper\"><div class=\"description-title\"><b><span typeof=\"mw:File\"><span><img alt=\"UI Quest\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"UI Quest.png\" data-image-key=\"UI_Quest.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0f/UI_Quest.png/revision/latest/scale-to-width-down/20?cb=20260501180345\" /></span></span> Quest Description</b></div><hr class=\"description-separator\" /><div class=\"description-content\">Lorenzo from Egla Town seems in need of help.</div></div></dd>\n<dl><dt>(Talk with \"Painter\")</dt>\n<dd><b>\"Painter\":</b> Hmm?</dd>\n<dd><b>Chalulu:</b> Ooh-la ooh-la! Eeya-ha&#8212;gulululululu!</dd>\n<dd><i>(Chalulu seems to have explained your intentions, and the Cuddle Wuddle waves its hands bashfully.)</i></dd>\n<dd><b>Lorenzo:</b> \"A villain is never a shadow on stage; it's the spotlight cast upon the hero.\" Your performance as the villain was brilliant, dear Painter.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> You were fantastic in your role!</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> I'd be honored to be your audience.</dd>\n<dd><b>\"Painter\":</b> Hmm&#8212;mmm mmm mmm mmm!</dd>\n<dd><i>Painter flushes, then rummages through a tear in his body, looking for something.</i></dd>\n<dd><i>Suddenly, he pauses, as if he has found what he sought. He clenches the item tightly in his palm, carefully extending it toward you&#8212;</i></dd>\n<dd><i>In his hand lies a flattened piece of candy, possibly a Carnevale giveaway. He tries, awkwardly, to speak like a human&#8212;</i></dd>\n<dd><b>\"Painter\":</b> Th-th (Thank), guh (you), ee-eh (very), muh (much).</dd>\n<dt>(Quest Complete)</dt></dl>\n</div>\n<h2><span class=\"mw-headline\" id=\"Note\">Note</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ul><li>For the Painting of the Mask and Waves, Lorenzo doesn't say anything about it. This could be a missing dialogue error.</li></ul>\n<h2><span class=\"mw-headline\" id=\"Other_Languages\">Other Languages</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<table class=\"article-table alternating-colors-table\"><tbody><tr><th>Language</th><th>Official Name</th></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji EN Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji EN Flag.png\" data-image-key=\"Emoji_EN_Flag.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/f/f5/Emoji_EN_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221541\" /></span></span></span>&#160;&#160;English</b></td><td>The Best Audience</td></tr><tr><td style=\"line-height:1em\"><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ZHS Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ZHS Flag.png\" data-image-key=\"Emoji_ZHS_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/5/5f/Emoji_ZHS_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221618\" /></span></span></span>&#160;&#160;Chinese <abbr title=\"Simplified\"><small>(S)</small></abbr></b></td><td><span lang=\"zh-Hans\">最佳观众</span></td></tr><tr><td style=\"line-height:1em\"><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ZHT Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ZHT Flag.png\" data-image-key=\"Emoji_ZHT_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/02/Emoji_ZHT_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221733\" /></span></span></span>&#160;&#160;Chinese <abbr title=\"Traditional\"><small>(T)</small></abbr></b></td><td><span lang=\"zh-Hant\">最佳觀眾</span></td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji JA Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji JA Flag.png\" data-image-key=\"Emoji_JA_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/8/84/Emoji_JA_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221804\" /></span></span></span>&#160;&#160;Japanese</b></td><td><span lang=\"ja\">ベス</span> <span lang=\"ja\">トオーディ</span> <span lang=\"ja\">エンス</span></td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji KO Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji KO Flag.png\" data-image-key=\"Emoji_KO_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/5/5d/Emoji_KO_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221837\" /></span></span></span>&#160;&#160;Korean</b></td><td><span lang=\"ko\">최고의</span> <span lang=\"ko\">관객</span></td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji FR Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji FR Flag.png\" data-image-key=\"Emoji_FR_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/c/c6/Emoji_FR_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221935\" /></span></span></span>&#160;&#160;French</b></td><td>Mielleur spectateur</td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji DE Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji DE Flag.png\" data-image-key=\"Emoji_DE_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/3/3b/Emoji_DE_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221959\" /></span></span></span>&#160;&#160;German</b></td><td>Die besten Zuschauer</td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ES Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ES Flag.png\" data-image-key=\"Emoji_ES_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d2/Emoji_ES_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221908\" /></span></span></span>&#160;&#160;Spanish</b></td><td>Mejor audiencia</td></tr></tbody></table>\n<h2><span class=\"mw-headline\" id=\"Change_History\">Change History</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<div class=\"change-history\"><div class=\"change-history-header\"><div>Released in <b><a href=\"/wiki/Version/2.0\" title=\"Version/2.0\">Version 2.0</a></b></div><div>[<a target=\"_blank\" rel=\"noreferrer noopener\" class=\"text\" href=\"https://wutheringwaves.fandom.com/wiki/The_Best_Audience/Change_History?action=edit&amp;preload=Template:Change_History/Preload&amp;preloadparams%5b%5d=2.0&amp;preloadparams%5b%5d=The+Best+Audience\">Create New History</a>]</div></div></div>