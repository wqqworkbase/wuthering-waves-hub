if;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji JA Flag.png\" data-image-key=\"Emoji_JA_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/8/84/Emoji_JA_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221804\" /></span></span></span>&#160;&#160;Japanese</b></td><td><span lang=\"ja\">千の扉の奇想</span></td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji KO Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji KO Flag.png\" data-image-key=\"Emoji_KO_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/5/5d/Emoji_KO_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221837\" /></span></span></span>&#160;&#160;Korean</b></td><td><span lang=\"ko\">수많은</span> <span lang=\"ko\">문의</span> <span lang=\"ko\">환상</span></td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji FR Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji FR Flag.png\" data-image-key=\"Emoji_FR_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/c/c6/Emoji_FR_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221935\" /></span></span></span>&#160;&#160;French</b></td><td>Fantasmes des mille portes</td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji DE Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decodin