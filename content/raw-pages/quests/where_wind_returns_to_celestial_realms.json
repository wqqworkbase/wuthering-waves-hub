{
  "title": "Where Wind Returns to Celestial Realms",
  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><p class=\"mw-empty-elt\">\n</p><aside role=\"region\" class=\"portable-infobox pi-background pi-border-color pi-theme-wikia pi-layout-stacked\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"title\">Where Wind Returns to Celestial Realms</h2>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"type\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Quest Type</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Exploration</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"startLocation\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Starting Location</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Shores_of_Last_Breath\" title=\"Shores of Last Breath\">Shores of Last Breath</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"description\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Description</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">The northernmost edge of the Shores of Last Breath was said to be where Sentinel Imperator made Their last appearance. As you arrive, you find the area ravaged by relentless storms...</div>\n</div>\n<section class=\"pi-item pi-group pi-border-color\">\n\t\n\t<section class=\"pi-item pi-panel pi-border-color wds-tabber\">\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tabs__wrapper\">\n\t\t\t\t<ul class=\"wds-tabs\">\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab wds-is-current\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tRewards\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tCharacters\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tab__content wds-is-current\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"rewards\">\n\t\n\t<div class=\"pi-data-value pi-font\"><span class=\"card-list-container\"><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-5\"><span typeof=\"mw:File\"><a href=\"/wiki/Union_EXP\" title=\"Union EXP\"><img alt=\"Union EXP\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Union EXP.png\" data-image-key=\"Item_Union_EXP.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0b/Item_Union_EXP.png/revision/latest/scale-to-width-down/74?cb=20240525121935\" /></a></span></span><span class=\"card-text card-font\"> 500</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-5\"><span typeof=\"mw:File\"><a href=\"/wiki/Astrite\" title=\"Astrite\"><img alt=\"Astrite\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Astrite.png\" data-image-key=\"Item_Astrite.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/1/16/Item_Astrite.png/revision/latest/scale-to-width-down/74?cb=20240523021541\" /></a></span></span><span class=\"card-text card-font\"> 40</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-4\"><span typeof=\"mw:File\"><a href=\"/wiki/Advanced_Resonance_Potion\" title=\"Advanced Resonance Potion\"><img alt=\"Advanced Resonance Potion\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Advanced Resonance Potion.png\" data-image-key=\"Item_Advanced_Resonance_Potion.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/e/e2/Item_Advanced_Resonance_Potion.png/revision/latest/scale-to-width-down/74?cb=20240524152949\" /></a></span></span><span class=\"card-text card-font\"> 3</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-4\"><span typeof=\"mw:File\"><a href=\"/wiki/Advanced_Sealed_Tube\" title=\"Advanced Sealed Tube\"><img alt=\"Advanced Sealed Tube\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Advanced Sealed Tube.png\" data-image-key=\"Item_Advanced_Sealed_Tube.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d6/Item_Advanced_Sealed_Tube.png/revision/latest/scale-to-width-down/74?cb=20240529094344\" /></a></span></span><span class=\"card-text card-font\"> 3</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-3\"><span typeof=\"mw:File\"><a href=\"/wiki/Shell_Credit\" title=\"Shell Credit\"><img alt=\"Shell Credit\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Shell Credit.png\" data-image-key=\"Item_Shell_Credit.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d1/Item_Shell_Credit.png/revision/latest/scale-to-width-down/74?cb=20240523132525\" /></a></span></span><span class=\"card-text card-font\"> 36,000</span></span></div></span></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t\t\t<div class=\"wds-tab__content\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"characters\">\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Abby\" title=\"Abby\">Abby</a></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t</section>\n\n\n\n\n</section>\n</aside>\n\n<b>Where Wind Returns to Celestial Realms</b> is a <a href=\"/wiki/Exploration_Quest\" title=\"Exploration Quest\">Exploration Quest</a> that occurs in <a href=\"/wiki/Fagaceae_Peninsula\" title=\"Fagaceae Peninsula\">Fagaceae Peninsula</a>, <a href=\"/wiki/Rinascita\" title=\"Rinascita\">Rinascita</a>, [[{{{nation}}}]].\n<p class=\"mw-empty-elt\"></p>\n<div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Steps\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Steps</span></a></li>\n<li class=\"toclevel-1 tocsection-2\"><a href=\"#Gameplay_Notes\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">Gameplay Notes</span></a></li>\n<li class=\"toclevel-1 tocsection-3\"><a href=\"#Dialogue\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">Dialogue</span></a></li>\n<li class=\"toclevel-1 tocsection-4\"><a href=\"#Other_Languages\"><span class=\"tocnumber\">4</span> <span class=\"toctext\">Other Languages</span></a></li>\n<li class=\"toclevel-1 tocsection-5\"><a href=\"#Change_History\"><span class=\"tocnumber\">5</span> <span class=\"toctext\">Change History</span></a></li>\n</ul>\n</div>\n\n<h2><span class=\"mw-headline\" id=\"Steps\">Steps</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ol><li>Complete charging the steles at the first altar</li>\n<li>Complete charging the steles at the second altar</li>\n<li>Complete charging the steles at the third altar</li>\n<li>Find the right angle to fix the steles</li>\n<li>Complete charging the steles at the third altar</li>\n<li>Return to inspect the remains of the Lumiscale Construct</li>\n<li>Defeat the Lumiscale Construct</li>\n<li>Pursue the Lumiscale Construct</li>\n<li>Defeat the enemies blocking your path</li>\n<li>Pursue the Lumiscale Construct</li>\n<li>Defeat the Lumiscale Construct</li>\n<li>Defeat the enemies</li></ol>\n<h2><span class=\"mw-headline\" id=\"Gameplay_Notes\">Gameplay Notes</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ul><li>Completing this quest grants the <i><a href=\"/wiki/Footprints_in_Rinascita_I\" title=\"Footprints in Rinascita I\">Footprints in Rinascita I</a></i> trophy <i><a href=\"/wiki/The_Wind_Ends_Here\" title=\"The Wind Ends Here\">The Wind Ends Here</a></i>.</li></ul>\n<h2><span class=\"mw-headline\" id=\"Dialogue\">Dialogue</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<div class=\"dialogue\">\n<dl><dt>(Try to enter Shores of Last Breath)</dt>\n<dd><b>You lost your way in the heavy storm...</b></dd></dl>\n<hr />\n<dl><dd><i>Scattered debris from a Lumiscale Construct lies on the ground.</i></dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Option\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/9/9a/Icon_Dialogue_Option.png/revision/latest/scale-to-width-down/20?cb=20240529051958\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element\" data-image-name=\"Icon Dialogue Option.png\" data-image-key=\"Icon_Dialogue_Option.png\" data-relevant=\"0\" /></span></span> Why would a Lumiscale Construct be here?\n<dl><dd><b>Abby:</b> *yawn* Huh... A familiar smell!</dd>\n<dd><b>Rover:</b> Finally awake, are we?</dd>\n<dd><b>Abby:</b> Hey! I've been on guard this whole time!</dd>\n<dd><b>Abby:</b> These scraps look just like that thing we saw back on <a href=\"/wiki/Mt._Firmament\" title=\"Mt. Firmament\">Mt. Firmament</a>. The name is... right! <a href=\"/wiki/Lumiscale_Construct\" title=\"Lumiscale Construct\">Lumiscale Construct</a>!</dd>\n<dd><b>Abby:</b> Except... this one smells different, like it's been broken since a long time ago.</dd>\n<dd><b>Abby:</b> And... it smells burnt.</dd></dl></dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Option\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/9/9a/Icon_Dialogue_Option.png/revision/latest/scale-to-width-down/20?cb=20240529051958\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element\" data-image-name=\"Icon Dialogue Option.png\" data-image-key=\"Icon_Dialogue_Option.png\" data-relevant=\"0\" /></span></span> There's something carved on the ground...\n<dl><dd><b>Oracles on the Tablet:</b> \"...Once Their people were safe, <a href=\"/wiki/Imperator\" title=\"Imperator\">Imperator</a> left the old capital and journeyed northeast...\"</dd>\n<dd><b>Oracles on the Tablet:</b> \"...On the shore, the faithful watched as Imperator rode the waves and wind, until Their presence dissolved into the clouds...\"</dd>\n<dd><b>Rover:</b> \"Dissolved into the clouds\"... If this inscription speaks true, then this shore is where Sentinel Imperator was last seen?</dd></dl></dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Arrow\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/4/41/Icon_Dialogue_Arrow.png/revision/latest/scale-to-width-down/20?cb=20240529052033\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element\" data-image-name=\"Icon Dialogue Arrow.png\" data-image-key=\"Icon_Dialogue_Arrow.png\" data-relevant=\"0\" /></span></span> Touch it.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Exit\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Exit.png\" data-image-key=\"Icon_Dialogue_Exit.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/6/66/Icon_Dialogue_Exit.png/revision/latest/scale-to-width-down/20?cb=20240526052042\" /></span></span> Leave.</dd></dl>\n<hr />\n<dl><dd><b>Abby:</b> What happened? An earthquake? Ugh, I feel giddy...</dd></dl>\n<hr />\n<dl><dt>(Head to the first altar)</dt>\n<dd><b>Rover:</b> This pattern on the ground is identical to the one we found near the Lumiscale Construct.</dd>\n<dd><b>Abby:</b> Looks like the work of those <a href=\"/wiki/Order_of_the_Deep\" title=\"Order of the Deep\">Order</a> folks.</dd></dl>\n<hr />\n<dl><dt>(Interact with the first altar)</dt>\n<dd><b>Abby:</b> Tacet Discords incoming!</dd>\n<dd><b>Abby:</b> It seems these patterns on the altar light up gradually when you stand in this giant circle.</dd>\n<dd><b>Rover:</b> Is this some kind of ritual...</dd></dl>\n<hr />\n<dl><dt>(Complete challenge)</dt>\n<dd><b>Abby:</b> Is it... offering us a ride?</dd>\n<dd><b>Rover:</b> We'll catch this ride, then.</dd></dl>\n<hr />\n<dl><dt>(Head to the second altar)</dt>\n<dd><b>Rover:</b> Here's another altar.</dd>\n<dd><b>Abby:</b> Maybe we should light it up like last time?</dd></dl>\n<hr />\n<dl><dt>(Interact with the second altar)</dt>\n<dd><b>Abby:</b> More enemies here!</dd>\n<dd><b>Abby:</b> Ugh, these pesky Tacet Discord... Stay away from us!</dd></dl>\n<hr />\n<dl><dt>(Complete challenge)</dt>\n<dd><b>Abby:</b> Look! It's here to pick us up again!</dd></dl>\n<hr />\n<dl><dt>(Head to the third altar)</dt>\n<dd><b>Rover:</b> These steles are even more worn out than the last ones...</dd></dl>\n<hr />\n<dl><dt>(Interact with the second altar)</dt>\n<dd><b>Rover:</b> Hmm... Need a better angle to piece them together.</dd></dl>\n<hr />\n<dl><dt>(Interact with the second altar)</dt>\n<dd><b>Abby:</b> This is the last altar!</dd>\n<dd><b>Abby:</b> Let's finish this in one go!</dd></dl>\n<hr />\n<dl><dt>(Complete challenge)</dt>\n<dd><b>Abby:</b> (&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Rover\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Rover</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">The player's chosen name for Rover</span></span>&#8205;), the smell of those scraps have changed... I don't like the feel of this.</dd></dl>\n<hr />\n<dd><div class=\"description-wrapper\"><div class=\"description-title\"><b><span typeof=\"mw:File\"><span><img alt=\"UI Quest\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"UI Quest.png\" data-image-key=\"UI_Quest.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0f/UI_Quest.png/revision/latest/scale-to-width-down/20?cb=20260501180345\" /></span></span> Quest Description</b></div><hr class=\"description-separator\" /><div class=\"description-content\">The northernmost edge of the Shores of Last Breath was said to be where Sentinel Imperator made Their last appearance. As you arrive, you find the area ravaged by relentless storms...</div></div></dd>\n<dl><dt>(Head to the designated location)</dt>\n<dd><b>Abby:</b> Ahhh! Why is it moving now?!</dd></dl>\n<hr />\n<dl><dt>(Lumiscale Construct at 50% HP)</dt>\n<dd><b>Abby:</b> It just ran off! Over there!</dd></dl>\n<hr />\n<dl><dt>(Head to the designated location)</dt>\n<dd><b>Abby:</b> The inscription says the Order believes this is where Imperator was last seen.</dd>\n<dd><b>Rover:</b> So, they made these steles to honor the Sentinel... That's pretty impressive!</dd>\n<dd><b>Abby:</b> But the wind is really strong here. We need to watch our steps.</dd></dl>\n<hr />\n<dl><dt>(Head to the designated location)</dt>\n<dd><b>Abby:</b> Can we slow down a bit? Seriously, I'm feeling dizzy...</dd>\n<dd><b>Rover:</b> How about you just get off me and fly on your own?</dd>\n<dd><b>Abby:</b> No, never mind. Wouldn't wanna get swept away by the wind...</dd></dl>\n<hr />\n<dl><dt>(Head to the designated location)</dt>\n<dd><b>Abby:</b> Ahhhhhhh!</dd>\n<dd><b>Abby:</b> This is too dangerous! Careful to not fall into it!</dd></dl>\n<hr />\n<dl><dt>(Head to the designated location)</dt>\n<dd><b>Abby:</b> It's coming at us!</dd>\n<dd><b>Abby:</b> That was so close!</dd></dl>\n<hr />\n<dl><dt>(Head to the designated location)</dt>\n<dd><b>Abby:</b> Haha, gotcha! Now you'll behave!</dd></dl>\n<hr />\n<dl><dt>(Lumiscale Construct at low HP)</dt>\n<dd><b>Abby:</b> Woah! Seriously?! Where did this big guy even come from?!</dd></dl>\n<hr />\n<dl><dt>(Defeat the TD)</dt>\n<dd><b>Abby:</b> So this is it, huh?</dd>\n<dd><b>Abby:</b> Those Order folks really worked hard to get here. Not my kind of thing.</dd>\n<dd><b>Rover:</b> ...</dd>\n<dd><b>Abby:</b> (&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Rover\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Rover</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">The player's chosen name for Rover</span></span>&#8205;)? What's wrong?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Nothing.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> I'm just wondering...</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Is this suffering really what Imperator desires for Their people?</dd>\n<dt>(Quest Complete)</dt></dl>\n</div>\n<h2><span class=\"mw-headline\" id=\"Other_Languages\">Other Languages</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<table class=\"article-table alternating-colors-table\"><tbody><tr><th>Language</th><th>Official Name</th></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji EN Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji EN Flag.png\" data-image-key=\"Emoji_EN_Flag.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/f/f5/Emoji_EN_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221541\" /></span></span></span>&#160;&#160;English</b></td><td>Where Wind Returns to Celestial Realms</td></tr><tr><td style=\"line-height:1em\"><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ZHS Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ZHS Flag.png\" data-image-key=\"Emoji_ZHS_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/5/5f/Emoji_ZHS_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221618\" /></span></span></span>&#160;&#160;Chinese <abbr title=\"Simplified\"><small>(S)</small></abbr></b></td><td><span lang=\"zh-Hans\">风归高天之所</span></td></tr><tr><td style=\"line-height:1em\"><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ZHT Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ZHT Flag.png\" data-image-key=\"Emoji_ZHT_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/02/Emoji_ZHT_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221733\" 