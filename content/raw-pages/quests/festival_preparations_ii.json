  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><p class=\"mw-empty-elt\">\n</p><aside role=\"region\" class=\"portable-infobox pi-background pi-border-color pi-theme-wikia pi-layout-stacked\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"title\">Festival Preparations II</h2>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"type\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Quest Type</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Main_Quests\" class=\"mw-redirect\" title=\"Main Quests\">Main</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"chapter\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Event</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/By_Moon%27s_Grace\" title=\"By Moon&#39;s Grace\">By Moon's Grace</a><br /><b>Chapter</b><br /><a href=\"/wiki/Tale_of_Moontree_Lodge\" class=\"mw-redirect\" title=\"Tale of Moontree Lodge\">Tale of Moontree Lodge</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"requirement\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Requirements</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><ul><li>Complete <a href=\"/wiki/Wish_Upon_the_Moon_I:_Cry_of_the_Soul\" title=\"Wish Upon the Moon I: Cry of the Soul\">Wish Upon the Moon I: Cry of the Soul</a></li></ul></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"description\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Description</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Begin the early stage festival preparation at Taoyuan Vale</div>\n</div>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<table class=\"pi-horizontal-group\">\n\t\n\t\n\t<thead>\n\t\t<tr>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"prev\">Previous Quest</th>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"next\">Next Quest</th>\n\t\t\n\t\t</tr>\n\t</thead>\n\t\n\t<tbody>\n\t<tr>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"prev\"><a href=\"/wiki/Wish_Upon_the_Moon_I:_Cry_of_the_Soul\" title=\"Wish Upon the Moon I: Cry of the Soul\">Wish Upon the Moon I: Cry of the Soul</a></td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"next\"><a href=\"/wiki/Decode_corrupted_wishes:_II\" class=\"mw-redirect\" title=\"Decode corrupted wishes: II\">Decode corrupted wishes: II</a></td>\n\t\n\t</tr>\n\t</tbody>\n</table>\n\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n\t\n\t<section class=\"pi-item pi-panel pi-border-color wds-tabber\">\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tabs__wrapper\">\n\t\t\t\t<ul class=\"wds-tabs\">\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab wds-is-current\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tRewards\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tab__content wds-is-current\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"rewards\">\n\t\n\t<div class=\"pi-data-value pi-font\"><span class=\"card-list-container\"><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-5\"><span typeof=\"mw:File\"><a href=\"/wiki/Astrite\" title=\"Astrite\"><img alt=\"Astrite\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Astrite.png\" data-image-key=\"Item_Astrite.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/1/16/Item_Astrite.png/revision/latest/scale-to-width-down/74?cb=20240523021541\" /></a></span></span><span class=\"card-text card-font\"> 30</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-4\"><span typeof=\"mw:File\"><a href=\"/wiki/Advanced_Energy_Core\" title=\"Advanced Energy Core\"><img alt=\"Advanced Energy Core\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Advanced Energy Core.png\" data-image-key=\"Item_Advanced_Energy_Core.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/b/b5/Item_Advanced_Energy_Core.png/revision/latest/scale-to-width-down/74?cb=20240524153038\" /></a></span></span><span class=\"card-text card-font\"> 2</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-4\"><span typeof=\"mw:File\"><a href=\"/wiki/Advanced_Resonance_Potion\" title=\"Advanced Resonance Potion\"><img alt=\"Advanced Resonance Potion\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Advanced Resonance Potion.png\" data-image-key=\"Item_Advanced_Resonance_Potion.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/e/e2/Item_Advanced_Resonance_Potion.png/revision/latest/scale-to-width-down/74?cb=20240524152949\" /></a></span></span><span class=\"card-text card-font\"> 1</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-3\"><span typeof=\"mw:File\"><a href=\"/wiki/Preparation_Credits\" title=\"Preparation Credits\"><img alt=\"Preparation Credits\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Preparation Credits.png\" data-image-key=\"Item_Preparation_Credits.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/1/12/Item_Preparation_Credits.png/revision/latest/scale-to-width-down/74?cb=20240817093618\" /></a></span></span><span class=\"card-text card-font\"> 40</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-3\"><span typeof=\"mw:File\"><a href=\"/wiki/Shell_Credit\" title=\"Shell Credit\"><img alt=\"Shell Credit\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Shell Credit.png\" data-image-key=\"Item_Shell_Credit.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d1/Item_Shell_Credit.png/revision/latest/scale-to-width-down/74?cb=20240523132525\" /></a></span></span><span class=\"card-text card-font\"> 6,000</span></span></div></span></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t</section>\n\n\n\n\n</section>\n</aside>\n\n<p class=\"mw-empty-elt\"></p>\n<div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Steps\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Steps</span></a></li>\n<li class=\"toclevel-1 tocsection-2\"><a href=\"#Gameplay_Notes\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">Gameplay Notes</span></a></li>\n<li class=\"toclevel-1 tocsection-3\"><a href=\"#Other_Languages\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">Other Languages</span></a></li>\n<li class=\"toclevel-1 tocsection-4\"><a href=\"#Change_History\"><span class=\"tocnumber\">4</span> <span class=\"toctext\">Change History</span></a></li>\n</ul>\n</div>\n\n<h2><span class=\"mw-headline\" id=\"Steps\">Steps</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ol><li>Go to the Wishing Stall and continue to prepare for the Moon-Chasing Festival.\n<ol><li>Build \"Yumyum Haven\"</li>\n<li>Build \"Fan Drawing Stall\"</li>\n<li>Build \"Moon Shooter\"</li></ol></li></ol>\n<h2><span class=\"mw-headline\" id=\"Gameplay_Notes\">Gameplay Notes</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ul><li>This quest is limited.</li></ul>\n<h2><span class=\"mw-headline\" id=\"Other_Languages\">Other Languages</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<table class=\"article-table alternating-colors-table\"><tbody><tr><th>Language</th><th>Official Name</th></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji EN Flag\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/f/f5/Emoji_EN_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221541\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element\" data-image-name=\"Emoji EN Flag.png\" data-image-key=\"Emoji_EN_Flag.png\" data-relevant=\"1\" /></span></span></span>&#160;&#160;English</b></td