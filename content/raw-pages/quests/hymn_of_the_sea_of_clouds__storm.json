{
  "title": "Hymn of the Sea of Clouds: Storm",
  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><div class=\"mbox stub\" style=\"border-left-width:8px;margin-bottom:5px;border-left-color:#d6d6d6;position:relative;display:flex;border-radius:3px;border:1px solid #d6d6d6;min-height:32px\"><div class=\"mbox&#95;&#95;content\" style=\"display:table;padding:8px 15px;width:100%;box-sizing:border-box\"><div class=\"mbox&#95;&#95;content&#95;&#95;image mw-collapsible\" id=\"mw-customcollapsible-mbox\" style=\"text-align:center;padding-right:15px;display:table-cell;height:100%;vertical-align:middle;width:40px\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/wutheringwaves/images/e/e8/Baizhi_Sticker_Slice_of_Life_01_08.png/revision/latest?cb=20240703174053\" class=\"mw-file-description image\"><img alt=\"Baizhi Sticker Slice of Life 01 08\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/e/e8/Baizhi_Sticker_Slice_of_Life_01_08.png/revision/latest/scale-to-width-down/65?cb=20240703174053\" decoding=\"async\" loading=\"lazy\" width=\"65\" height=\"65\" class=\"mw-file-element\" data-image-name=\"Baizhi Sticker Slice of Life 01 08.png\" data-image-key=\"Baizhi_Sticker_Slice_of_Life_01_08.png\" data-relevant=\"1\" /></a></span></div><div class=\"mbox&#95;&#95;content&#95;&#95;wrapper\" style=\"display:table-cell;vertical-align:middle\"><div class=\"mbox&#95;&#95;content&#95;&#95;header\" style=\"display:block;font-weight:bold\">This <a href=\"/wiki/Category:Article_Stubs\" title=\"Category:Article Stubs\">page</a> is in need of information.</div><div class=\"mbox&#95;&#95;content&#95;&#95;text mw-collapsible\" id=\"mw-customcollapsible-mbox\" style=\"display:block\">Can you help out? <a target=\"_blank\" rel=\"noreferrer noopener\" class=\"text\" href=\"https://wutheringwaves.fandom.com/wiki/Hymn_of_the_Sea_of_Clouds:_Storm?action=edit\">Click here to add more.</a><div class=\"mbox&#95;&#95;content&#95;&#95;text&#95;&#95;comment\" style=\"font-size:small\">verify Mrover dialogue + requirements</div></div><span class=\"mbox&#95;&#95;close mw-customtoggle-mbox\" title=\"Dismiss\" style=\"color:#bbb;right:0;cursor:pointer;font-size:16px;top:0;transition:all .15s ease-in;position:absolute;padding:2px 7px;font-weight:bold\"></span></div></div></div>\n<p class=\"mw-empty-elt\">\n</p><aside role=\"region\" class=\"portable-infobox pi-background pi-border-color pi-theme-wikia pi-layout-stacked\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"title\">Hymn of the Sea of Clouds: Storm</h2>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"type\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Quest Type</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Exploration</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"description\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Description</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">The time has come to unravel the secrets of the Forbidden Archive...</div>\n</div>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<table class=\"pi-horizontal-group\">\n\t\n\t\n\t<thead>\n\t\t<tr>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"prev\">Previous Quest</th>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"next\">Next Quest</th>\n\t\t\n\t\t</tr>\n\t</thead>\n\t\n\t<tbody>\n\t<tr>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"prev\"><a href=\"/wiki/Hymn_of_the_Sea_of_Clouds:_Rainbow\" title=\"Hymn of the Sea of Clouds: Rainbow\">Hymn of the Sea of Clouds: Rainbow</a></td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"next\">N/A</td>\n\t\n\t</tr>\n\t</tbody>\n</table>\n\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n\t\n\t<section class=\"pi-item pi-panel pi-border-color wds-tabber\">\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tabs__wrapper\">\n\t\t\t\t<ul class=\"wds-tabs\">\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab wds-is-current\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tRewards\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tCharacters\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tab__content wds-is-current\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"rewards\">\n\t\n\t<div class=\"pi-data-value pi-font\"><span class=\"card-list-container\"><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-5\"><span typeof=\"mw:File\"><a href=\"/wiki/Union_EXP\" title=\"Union EXP\"><img alt=\"Union EXP\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Union EXP.png\" data-image-key=\"Item_Union_EXP.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0b/Item_Union_EXP.png/revision/latest/scale-to-width-down/74?cb=20240525121935\" /></a></span></span><span class=\"card-text card-font\"> 250</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-5\"><span typeof=\"mw:File\"><a href=\"/wiki/Astrite\" title=\"Astrite\"><img alt=\"Astrite\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Astrite.png\" data-image-key=\"Item_Astrite.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/1/16/Item_Astrite.png/revision/latest/scale-to-width-down/74?cb=20240523021541\" /></a></span></span><span class=\"card-text card-font\"> 30</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-0\"><span typeof=\"mw:Error mw:File\"><a href=\"/wiki/Special:Upload?wpDestFile=Item_PhantomVitreum_Dancer.png\" class=\"new\" title=\"File:Item PhantomVitreum Dancer.png\"><span class=\"mw-file-element mw-broken-media\" data-width=\"74\" data-height=\"74\">Phantom:Vitreum Dancer</span></a></span></span><span class=\"card-text card-font\"> 1</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-0\"><span typeof=\"mw:Error mw:File\"><a href=\"/wiki/Special:Upload?wpDestFile=Item_Fables_of_Wisdom_Crafting_Recipe.png\" class=\"new\" title=\"File:Item Fables of Wisdom Crafting Recipe.png\"><span class=\"mw-file-element mw-broken-media\" data-width=\"74\" data-height=\"74\">Fables of Wisdom Crafting Recipe</span></a></span></span><span class=\"card-text card-font\"> 1</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-0\"><span typeof=\"mw:Error mw:File\"><a href=\"/wiki/Special:Upload?wpDestFile=Item_The_Nimbus_Chorale.png\" class=\"new\" title=\"File:Item The Nimbus Chorale.png\"><span class=\"mw-file-element mw-broken-media\" data-width=\"74\" data-height=\"74\">The Nimbus Chorale</span></a></span></span><span class=\"card-text card-font\"> 1</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-4\"><span typeof=\"mw:File\"><a href=\"/wiki/Advanced_Resonance_Potion\" title=\"Advanced Resonance Potion\"><img alt=\"Advanced Resonance Potion\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Advanced Resonance Potion.png\" data-image-key=\"Item_Advanced_Resonance_Potion.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/e/e2/Item_Advanced_Resonance_Potion.png/revision/latest/scale-to-width-down/74?cb=20240524152949\" /></a></span></span><span class=\"card-text card-font\"> 2</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-4\"><span typeof=\"mw:File\"><a href=\"/wiki/Advanced_Sealed_Tube\" title=\"Advanced Sealed Tube\"><img alt=\"Advanced Sealed Tube\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Advanced Sealed Tube.png\" data-image-key=\"Item_Advanced_Sealed_Tube.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d6/Item_Advanced_Sealed_Tube.png/revision/latest/scale-to-width-down/74?cb=20240529094344\" /></a></span></span><span class=\"card-text card-font\"> 2</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-3\"><span typeof=\"mw:File\"><a href=\"/wiki/Shell_Credit\" title=\"Shell Credit\"><img alt=\"Shell Credit\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Shell Credit.png\" data-image-key=\"Item_Shell_Credit.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d1/Item_Shell_Credit.png/revision/latest/scale-to-width-down/74?cb=20240523132525\" /></a></span></span><span class=\"card-text card-font\"> 24,000</span></span></div></span></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t\t\t<div class=\"wds-tab__content\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"characters\">\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Abby\" title=\"Abby\">Abby</a>, <a href=\"/wiki/Lenore\" title=\"Lenore\">Lenore</a></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t</section>\n\n\n\n\n</section>\n</aside>\n\n<b>Hymn of the Sea of Clouds: Storm</b> is a <a href=\"/wiki/Exploration_Quest\" title=\"Exploration Quest\">Exploration Quest</a> that occurs in <a href=\"/wiki/Nimbus_Sanctum\" title=\"Nimbus Sanctum\">Nimbus Sanctum</a>, <a href=\"/wiki/Rinascita\" title=\"Rinascita\">Rinascita</a>, [[{{{nation}}}]].\n<p class=\"mw-empty-elt\"></p>\n<div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Steps\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Steps</span></a></li>\n<li class=\"toclevel-1 tocsection-2\"><a href=\"#Gameplay_Notes\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">Gameplay Notes</span></a></li>\n<li class=\"toclevel-1 tocsection-3\"><a href=\"#Dialogue\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">Dialogue</span></a></li>\n<li class=\"toclevel-1 tocsection-4\"><a href=\"#Other_Languages\"><span class=\"tocnumber\">4</span> <span class=\"toctext\">Other Languages</span></a></li>\n<li class=\"toclevel-1 tocsection-5\"><a href=\"#Change_History\"><span class=\"tocnumber\">5</span> <span class=\"toctext\">Change History</span></a></li>\n</ul>\n</div>\n\n<h2><span class=\"mw-headline\" id=\"Steps\">Steps</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ol><li>Enter the Forbidden Archive</li>\n<li>Proceed to the marked area</li>\n<li>Continue forward</li>\n<li>Touch the water crystal</li>\n<li>Defeat the Vitreum Dancers</li>\n<li>Defeat the Vitreum Dancer</li>\n<li>Continue forward</li>\n<li>Touch the water crystal</li>\n<li>Defeat the enemies</li>\n<li>Continue forward</li>\n<li>Touch the water crystal again</li>\n<li>Complete Tactical Hologram: Vitreum Dancer</li>\n<li>Continue forward</li>\n<li>Touch the water crystal again</li>\n<li>Challenge the Vitreum Dancer: Warden of Archive</li>\n<li>Chase the Vitreum Dancer: Warden of Archive</li>\n<li>Reach the last platform</li>\n<li>Defeat the Vitreum Dancer: Warden of Archive</li>\n<li>Retrieve the last record</li>\n<li>Leave the Major Forbidden Archive</li>\n<li>Return to the Aria Mummer</li>\n<li>Play the complete Nimbus Chorale</li></ol>\n<h2><span class=\"mw-headline\" id=\"Gameplay_Notes\">Gameplay Notes</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ul><li>Completing the step \"Retrieve the last record\" will award the player <span class=\"item\"><span class=\"item-image\"><span class=\"hidden\" style=\"height:30px;width:30px\"><span typeof=\"mw:File\"><a href=\"/wiki/The_Nimbus_Chorale:_Glory_to_Humanity\" title=\"The Nimbus Chorale: Glory to Humanity\"><img alt=\"The Nimbus Chorale Glory to Humanity\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/4/42/Item_Nimbus_Chorale.png/revision/latest/scale-to-width-down/30?cb=20250111002714\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" class=\"mw-file-element\" data-image-name=\"Item Nimbus Chorale.png\" data-image-key=\"Item_Nimbus_Chorale.png\" data-relevant=\"1\" /></a></span></span><span class=\"mobile-only\"><span typeof=\"mw:File\"><a href=\"/wiki/The_Nimbus_Chorale:_Glory_to_Humanity\" title=\"The Nimbus Chorale: Glory to Humanity\"><img alt=\"The Nimbus Chorale Glory to Humanity\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/4/42/Item_Nimbus_Chorale.png/revision/latest/scale-to-width-down/30?cb=20250111002714\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" class=\"mw-file-element\" data-image-name=\"Item Nimbus Chorale.png\" data-image-key=\"Item_Nimbus_Chorale.png\" data-relevant=\"1\" /></a></span></span></span><span class=\"item-text\"> <a href=\"/wiki/The_Nimbus_Chorale:_Glory_to_Humanity\" title=\"The Nimbus Chorale: Glory to Humanity\">The Nimbus Chorale: Glory to Humanity</a></span></span>.</li>\n<li>Completing this quest will award the player the <i><a href=\"/wiki/Footprints_in_Rinascita_I\" title=\"Footprints in Rinascita I\">Footprints in Rinascita I</a></i> trophy <i><a href=\"/wiki/Faith_is_Dead\" title=\"Faith is Dead\">Faith is Dead</a></i>.</li></ul>\n<h2><span class=\"mw-headline\" id=\"Dialogue\">Dialogue</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<dd><div class=\"description-wrapper\"><div class=\"description-title\"><b><span typeof=\"mw:File\"><span><img alt=\"UI Quest\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"UI Quest.png\" data-image-key=\"UI_Quest.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0f/UI_Quest.png/revision/latest/scale-to-width-down/20?cb=20260501180345\" /></span></span> Quest Description</b></div><hr class=\"description-separator\" /><div class=\"description-content\">The time has come to unravel the secrets of the Forbidden Archive...</div></div></dd>\n<div class=\"dialogue\">\n<dl><dt>(During flight)</dt>\n<dd><b>Tacet Discord in the Forbidden Archive:</b> The <a href=\"/wiki/Imperator\" title=\"Imperator\">Sentinel</a> is indisputable. The Sentinel is beyond question.</dd>\n<dd><b>Tacet Discord in the Forbidden Archive:</b> The Sentinel is impervious to flaws. The Sentinel cannot err.</dd>\n<dd><b>Tacet Discord in the Forbidden Archive:</b> All teachings, writings, and even thoughts against the Sentinel are heresy and must be banned!</dd></dl>\n<hr />\n<dl><dt>(Custscene plays)</dt>\n<dt>(Cutscene ends)</dt></dl>\n<hr />\n<dl><dt>(During flight)</dt>\n<dd><b>Phantom:</b> The Sentinel is our guide, not our master!</dd>\n<dd><b>Tacet Discord in the Forbidden Archive:</b> Incorrect. The Sentinel's power reigns above all else!</dd>\n<dd><b>Phantom:</b> The Sentinel brought us to Rinascita, but the future... that is ours to claim!</dd>\n<dd><b>Tacet Discord in the Forbidden Archive:</b> Incorrect. All we are, all we have, is by the Sentinel's grace!</dd>\n<dd><b>Tacet Discord in the Forbidden Archive:</b> All meritorious deeds are the fruits of Their blessings. All virtue flows from Their will.</dd>\n<dd><b>Tacet Discord in the Forbidden Archive:</b> Repent for your arrogance!</dd>\n<dd><b>Tacet Discord in the Forbidden Archive:</b> Repent for your rebellion against the will of the <a href=\"/wiki/Order_of_the_Deep\" title=\"Order of the Deep\">Order!</a></dd></dl>\n<hr />\n<dl><dt>(Defeat the Vitreum Dancer</dt>\n<dd>Warden of Archive)</dd>\n<dd><b>Phantom of a Little Girl:</b> Father! Mother! Grandpa! Grandma! We've reached land! See? We're finally home!</dd>\n<dd><b>Phantom of a Little Girl:</b> The Sentinel showed us the way. Thank you, kind Sentinel!</dd>\n<dd><b>Phantom of a Little Girl:</b> Thank you to the brave uncles who fixed our ship in the rain! Thank you to the sailors who brought us here, and to the heroes who fought the scary monsters!</dd>\n<dd><b>Phantom of a Little Girl:</b> Thank you to the grannies who made yummy fish! Thank you to the big sisters who sang me to sleep while they sewed and the kind aunties who helped everyone when they were sick!</dd>\n<dd><b>Phantom of a Little Girl:</b> We found our new home! Do you see it? Thank you all so, so much!</dd></dl>\n<hr />\n<dl><dt>(Leave the Major Forbidden Archive)</dt>\n<dd><b>Lenore:</b> <span>(&#8205;&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Mr.\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Mr.</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for male Rover</span></span>&#8205;/<wbr />&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Ms.\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Ms.</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for female Rover</span></span>&#8205;&#8205;)</span> (&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Rover\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Rover</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">The player's chosen name for Rover</span></span>&#8205;), you're back! Are you all right?</dd>\n<dd><b>Rover:</b> Is this it?</dd>\n<dd><b>Lenore:</b> This... this is the last part for the Nimbus Chorale! Wonderful! I knew you could do it!</dd>\n<dd><b>Lenore:</b> Now, the last section should represent our ancestors' reverence for the Sentinel... Wait. It's titled... \"Glory to Humanity\"?</dd>\n<dd><b>Lenore:</b> But... why? Why does the most important part of the Chorale have nothing to do with Sentinel?&#32;&#91;<i><a href=\"https://en.wikipedia.org/wiki/sic\" class=\"extiw\" title=\"wikipedia:sic\">sic</a></i>&#93;</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Option\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Option.png\" data-image-key=\"Icon_Dialogue_Option.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/9/9a/Icon_Dialogue_Option.png/revision/latest/scale-to-width-down/20?cb=20240529051958\" /></span></span> Gently express your opinion.\n<dl><dd><b>Rover:</b> Maybe your ancestors knew the Sentinel was important, but they also knew that the ones who crossed the sea, the generations who built all this, deserved gratitude too.</dd>\n<dd><b>Lenore:</b> Of course our ancestors are important! Without their devotion, how could we have ever won the Sentinel's favor?</dd>\n<dd><b>Lenore:</b> They lived in a time when the Sentinel was closer to us. Why couldn't they see Their grace as we do?</dd>\n<dd><b>Rover:</b> Maybe it's because they understood the Sentinel's true nature better than you do, and they knew what it took to create the kind of life you now enjoy today.</dd>\n<dd><b>Lenore:</b> <span>(&#8205;&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Mr.\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Mr.</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for male Rover</span></span>&#8205;/<wbr />&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Ms.\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Ms.</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for female Rover</span></span>&#8205;&#8205;)</span> (&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Rover\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Rover</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">The player's chosen name for Rover</span></span>&#8205;)... do you think I've strayed from the path of my ancestors?</dd>\n<dd><b>Rover:</b> No, you're just following the Tenets of the Deep.</dd>\n<dd><b>Lenore:</b> I'm sorry, <span>(&#8205;&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Mr.\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Mr.</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for male Rover</span></span>&#8205;/<wbr />&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Ms.\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Ms.</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for female Rover</span></span>&#8205;&#8205;)</span> (&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Rover\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Rover</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">The player's chosen name for Rover</span></span>&#8205;). I don't understand.</dd>\n<dd><b>Lenore:</b> All I know is that the Sentinel gave us Rinascita as a home and the Common Echoes that help us live our lives. The order, guided by the Sentinel, saved me from the Dark Tide and gave me a name, a new life, and a place to belong.</dd></dl></dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Option\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Option.png\" data-image-key=\"Icon_Dialogue_Option.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/9/9a/Icon_Dialogue_Option.png/revision/latest/scale-to-width-down/20?cb=20240529051958\" /></span></span> Be direct with her.\n<dl><dd><b>Rover:</b> What you've been told has been twisted by the Order to suit its own ends. The true song of your ancestors is locked away, and you, like so many others, choose not to see it.</dd>\n<dd><b>Lenore:</b> I still don't understand...</dd>\n<dd><b>Rover:</b> The Order uses everyone's belief in the Sentinel to manipulate, deliberately erasing the history of Rinascita's first people.</dd>\n<dd><b>Lenore:</b> <span>(&#8205;&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Mr.\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Mr.</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for male Rover</span></span>&#8205;/<wbr />&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Ms.\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Ms.</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for female Rover</span></span>&#8205;&#8205;)</span> (&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Rover\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Rover</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">The player's chosen name for Rover</span></span>&#8205;), this is very serious slander against the Order! According to the Tenets of the Deep...</dd>\n<dd><b>Rover:</b> Hasn't your <a href=\"/wiki/Fenrico\" title=\"Fenrico\">Primus</a> told you everything he wants you to do in Tenets of the Deep? You've followed those rules without question.</dd>\n<dd><b>Lenore:</b> <span>(&#8205;&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Mr.\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Mr.</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for male Rover</span></span>&#8205;/<wbr />&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Ms.\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Ms.</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for female Rover</span></span>&#8205;&#8205;)</span> (&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Rover\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Rover</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">The player's chosen name for Rover</span></span>&#8205;), why do you speak of the Order as if it were evil?</dd>\n<dd><b>Lenore:</b> Twenty years ago, the Order's Acolytes saved me from the Dark Tide, and the Order's orphanage became my second home. They gave me a name, a new life, a place to belong.</dd>\n<dd><b>Lenore:</b> Even when I wasn't wise enough to contribute much, the Order established the Minor Forbidden Archive just for me.</dd>\n<dd><b>Lenore:</b> They never asked for thanks. Only that I praise the Sentinel, pray daily, and live righteously. If that's the Order's manipulation... then I'm glad to be manipulated!</dd></dl></dd>\n<dd><b>Lenore:</b> As the opening lines of the Tenets states, \"All that the Order reveals is truth, and our duty is simply to follow.\"</dd>\n<dd><b>Lenore:</b> I suppose to you, I must seem like a blind follower of faith. I'm sorry for taking so much of your time, trying to convince me when I wouldn't listen.</dd>\n<dd><b>Lenore:</b> <span>(&#8205;&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Mr.\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Mr.</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for male Rover</span></span>&#8205;/<wbr />&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Ms.\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Ms.</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for female Rover</span></span>&#8205;&#8205;)</span> (&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Rover\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Rover</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">The player's chosen name for Rover</span></span>&#8205;), whether or not the Nimbus Chorale is heretical doesn't matter. It's not the music I wish to play at the Carnevale.</dd>\n<dd><b>Lenore:</b> I will never forget your kidness. If you ever need me, come to the Minor Forbidden Archive. I've had a long day, and now I need some time alone.</dd></dl>\n<hr />\n<dl><dd><b>Abby:</b> Wow, what's that in your hands? It smells so good! Wait, where are we? Did I miss out on something?</dd>\n<dd><b>Rover:</b> I don't even know where to start.</dd>\n<dd><b>Abby:</b> You look like you've been through a lot. What happened? Get any cool stuff?</dd>\n<dd><b>Rover:</b> Hmm... I have a song, you want to listen?</dd>\n<dd><b>Abby:</b> I really wanna go get something to eat first... But by the look on your face, fine. Let's listen!</dd></dl>\n<hr />\n<dl><dt>(Play the complete Nimbus Chorale)</dt>\n<dd><b>Lenore:</b> <span>(&#8205;&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Mr.\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Mr.</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for male Rover</span></span>&#8205;/<wbr />&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Ms.\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Ms.</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for female Rover</span></span>&#8205;&#8205;)</span> (&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Rover\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Rover</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">The player's chosen name for Rover</span></span>&#8205;), why...</dd>\n<dd><b>Lenore:</b> This music... with its disrespect, its blasphemy that ignores the Sentinel's grace... Why does it move me so?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Because this is the real song of Rinascita's people.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Because this song was always buried deep within you.</dd>\n<dd><b>Lenore:</b> O Sentinel, please forgive this humble, wandering servant. Forgive me for being moved by such a forbidden thing.</dd>\n<dd><b>Abby:</b> (&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Rover\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Rover</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">The player's chosen name for Rover</span></span>&#8205;), does the Sentinel here care about such little problems?</dd>\n<dd><b>Rover:</b> We'll talk about that later..</dd>\n<dd><b>Lenore:</b> <span>(&#8205;&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Mr.\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Mr.</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for male Rover</span></span>&#8205;/<wbr />&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Ms.\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Ms.</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for female Rover</span></span>&#8205;&#8205;)</span> (&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Rover\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Rover</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">The player's chosen name for Rover</span></span>&#8205;), what should I do? Should I report this music as heretical to the Order? Why do I hesitate? Am I losing my faith?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Why don't you ask yourself this time?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> How about we listen to this song a few more times?</dd></dl>\n<hr />\n<dl><dt>(Idle)</dt>\n<dd><b>Lenore:</b> What am I supposed to do...? This feeling within me...</dd>\n<dd><b>Lenore:</b> I want to listen to the Chorale again... just a few more times...</dd></dl>\n<hr />\n<dl><dt>(Optional - Interact with \"A beautiful handwritten note\" next to Aria Mummer)</dt>\n<dd><b>Note:</b> Verse 9, Chapter 9 of the Tenets reminds us, \"Seek out the truth, for all that is good, the Sentinel shall grant unto you, and all that is beautiful, the Sentinel shall embrace.\"</dd>\n<dd><b>Note:</b> Stranger, this beautiful song belongs to you, too. Have a good time at the Carnevale!</dd>\n<dt>(Quest Complete)</dt></dl>\n</div>\n<h2><span class=\"mw-headline\" id=\"Other_Languages\">Other Languages</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<table class=\"article-table alternating-colors-table\"><tbody><tr><th>Language</th><th>Official Name</th></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji EN Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji EN Flag.png\" data-image-key=\"Emoji_EN_Flag.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/f/f5/Emoji_EN_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221541\" /></span></span></span>&#160;&#160;English</b></td><td>Hymn of the Sea of Clouds: Storm</td></tr><tr><td style=\"line-height:1em\"><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ZHS Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ZHS Flag.png\" data-image-key=\"Emoji_ZHS_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/5/5f/Emoji_ZHS_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221618\" /></span></span></span>&#160;&#160;Chinese <abbr title=\"Simplified\"><small>(S)</small></abbr></b></td><td><span lang=\"zh-Hans\">氤柔云海之歌・骤雨之章</span></td></tr><tr><td style=\"line-height:1em\"><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ZHT Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ZHT Flag.png\" data-image-key=\"Emoji_ZHT_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/02/Emoji_ZHT_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221733\" /></span></span></span>&#160;&#160;Chinese <abbr title=\"Traditional\"><small>(T)</small></abbr></b></td><td><span lang=\"zh-Hant\">氤柔雲海之歌・驟雨之章</span></td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji JA Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji JA Flag.png\" data-image-key=\"Emoji_JA_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/8/84/Emoji_JA_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221804\" /></span></span></span>&#160;&#160;Japanese</b></td><td><span lang=\"ja\">幽玄なる雲海の調べ・にわか雨の章</span></td></tr><tr><td><b><span class=\"fla