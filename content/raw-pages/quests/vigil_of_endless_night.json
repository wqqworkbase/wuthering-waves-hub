{
  "title": "Vigil of Endless Night",
  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><p class=\"mw-empty-elt\">\n</p><aside role=\"region\" class=\"portable-infobox pi-background pi-border-color pi-theme-wikia pi-layout-stacked\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"title\">Vigil of Endless Night</h2>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"type\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Quest Type</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Exploration</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"requirement\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Requirements</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><ul><li>Complete <a href=\"/wiki/Thaw_of_Eons\" title=\"Thaw of Eons\">Thaw of Eons</a></li></ul></div>\n</div>\n<section class=\"pi-item pi-group pi-border-color\">\n\t\n\t<section class=\"pi-item pi-panel pi-border-color wds-tabber\">\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tabs__wrapper\">\n\t\t\t\t<ul class=\"wds-tabs\">\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab wds-is-current\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tRewards\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tCharacters\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tab__content wds-is-current\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"rewards\">\n\t\n\t<div class=\"pi-data-value pi-font\"><span class=\"card-list-container\"><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-5\"><span typeof=\"mw:File\"><a href=\"/wiki/Union_EXP\" title=\"Union EXP\"><img alt=\"Union EXP\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Union EXP.png\" data-image-key=\"Item_Union_EXP.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0b/Item_Union_EXP.png/revision/latest/scale-to-width-down/74?cb=20240525121935\" /></a></span></span><span class=\"card-text card-font\"> 1,000</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-5\"><span typeof=\"mw:File\"><a href=\"/wiki/Astrite\" title=\"Astrite\"><img alt=\"Astrite\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Astrite.png\" data-image-key=\"Item_Astrite.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/1/16/Item_Astrite.png/revision/latest/scale-to-width-down/74?cb=20240523021541\" /></a></span></span><span class=\"card-text card-font\"> 80</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-4\"><span typeof=\"mw:File\"><a href=\"/wiki/Advanced_Resonance_Potion\" title=\"Advanced Resonance Potion\"><img alt=\"Advanced Resonance Potion\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Advanced Resonance Potion.png\" data-image-key=\"Item_Advanced_Resonance_Potion.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/e/e2/Item_Advanced_Resonance_Potion.png/revision/latest/scale-to-width-down/74?cb=20240524152949\" /></a></span></span><span class=\"card-text card-font\"> 5</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-4\"><span typeof=\"mw:File\"><a href=\"/wiki/Advanced_Sealed_Tube\" title=\"Advanced Sealed Tube\"><img alt=\"Advanced Sealed Tube\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Advanced Sealed Tube.png\" data-image-key=\"Item_Advanced_Sealed_Tube.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d6/Item_Advanced_Sealed_Tube.png/revision/latest/scale-to-width-down/74?cb=20240529094344\" /></a></span></span><span class=\"card-text card-font\"> 5</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-3\"><span typeof=\"mw:File\"><a href=\"/wiki/Shell_Credit\" title=\"Shell Credit\"><img alt=\"Shell Credit\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Shell Credit.png\" data-image-key=\"Item_Shell_Credit.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d1/Item_Shell_Credit.png/revision/latest/scale-to-width-down/74?cb=20240523132525\" /></a></span></span><span class=\"card-text card-font\"> 40,000</span></span></div></span></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t\t\t<div class=\"wds-tab__content\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"characters\">\n\t\n\t<div class=\"pi-data-value pi-font\"><span class=\"new\" title=\"Caleb (page does not exist)\" data-uncrawlable-url=\"L3dpa2kvQ2FsZWI/YWN0aW9uPWVkaXQmcmVkbGluaz0x\">Caleb</span>, <a href=\"/wiki/Chenpi\" title=\"Chenpi\">Chenpi</a>, <a href=\"/wiki/Rover\" title=\"Rover\">Rover</a></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t</section>\n\n\n\n\n</section>\n</aside>\n<b>Vigil of Endless Night</b> is a <a href=\"/wiki/Exploration_Quest\" title=\"Exploration Quest\">Exploration Quest</a> that occurs in <a href=\"/wiki/Huanglong\" title=\"Huanglong\">Huanglong</a>, <a href=\"/wiki/Mt._Firmament\" title=\"Mt. Firmament\">Mt. Firmament</a>, [[{{{nation}}}]].\n<p class=\"mw-empty-elt\"></p>\n<div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Steps\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Steps</span></a></li>\n<li class=\"toclevel-1 tocsection-2\"><a href=\"#Gameplay_Notes\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">Gameplay Notes</span></a></li>\n<li class=\"toclevel-1 tocsection-3\"><a href=\"#Dialogue\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">Dialogue</span></a></li>\n<li class=\"toclevel-1 tocsection-4\"><a href=\"#Other_Languages\"><span class=\"tocnumber\">4</span> <span class=\"toctext\">Other Languages</span></a></li>\n<li class=\"toclevel-1 tocsection-5\"><a href=\"#Change_History\"><span class=\"tocnumber\">5</span> <span class=\"toctext\">Change History</span></a></li>\n</ul>\n</div>\n\n<h2><span class=\"mw-headline\" id=\"Steps\">Steps</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ol><li>Seek Chenpi</li>\n<li>Go to the entrance of Woodveil Hall</li>\n<li>Enter \"Woodveil Hall\"</li>\n<li>Ski down the slope</li>\n<li>Freeze the time with \"Chrono Sign\" to activate the device</li>\n<li>Venture deeper</li>\n<li>Freeze the time with \"Chrono Sign\" to activate the device</li>\n<li>Pass through the tunnel and beware of the light beam security</li>\n<li>Venture deeper</li>\n<li>Freeze the time with \"Chrono Sign\" to activate the device</li>\n<li>Venture deeper</li>\n<li>Try to activate the Prototype Chronosorter</li>\n<li>Head to the first security node</li>\n<li>Reboot the first security node</li>\n<li>Head to the second security node</li>\n<li>Reboot the second security node</li>\n<li>Head to the upper tier of Woodveil Hall</li>\n<li>Create a path with Chronosorter</li>\n<li>Head to the upper tier of Woodveil Hall</li>\n<li>Head to the third security node</li>\n<li>Unlock the third security node</li>\n<li>Head to the fourth security node</li>\n<li>Unlock the fourth security node</li>\n<li>Go back to the Prototype Chronosorter</li>\n<li>Investigate the info tablet</li>\n<li>Head to the Prototype Chronosorter</li>\n<li>Defeat the rogue defense unit</li>\n<li>Activate the Prototype Chronosorter</li>\n<li>Tell Chenpi everything that happened in Woodveil Hall</li></ol>\n<h2><span class=\"mw-headline\" id=\"Gameplay_Notes\">Gameplay Notes</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ul><li>Completing the \"Seek Chenpi\" step awards the player <a href=\"/wiki/Chrono_Sign\" title=\"Chrono Sign\">Chrono Sign</a>.</li>\n<li>Completing the \"Ski down the slope\" step changes <a href=\"/wiki/Chrono_Sign\" title=\"Chrono Sign\">Chrono Sign</a> into <a href=\"/wiki/Activated_Chrono_Sign\" title=\"Activated Chrono Sign\">Activated Chrono Sign</a>.</li>\n<li>Completing the quest awards the player the <i><a href=\"/wiki/Exploration:_Huanglong\" title=\"Exploration: Huanglong\">Exploration: Huanglong</a></i> trophy <i><a href=\"/wiki/Lesson_Number_5:_Live_A_Bit\" title=\"Lesson Number 5: Live A Bit\">Lesson Number 5: Live A Bit</a></i>.</li></ul>\n<h2><span class=\"mw-headline\" id=\"Dialogue\">Dialogue</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<dd><div class=\"description-wrapper\"><div class=\"description-title\"><b><span typeof=\"mw:File\"><span><img alt=\"UI Quest\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0f/UI_Quest.png/revision/latest/scale-to-width-down/20?cb=20260501180345\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element\" data-image-name=\"UI Quest.png\" data-image-key=\"UI_Quest.png\" data-relevant=\"0\" /></span></span> Quest Description</b></div><hr class=\"description-separator\" /><div class=\"description-content\">You obtained a strange object from Chenpi, who implied it was a key to a long-forgotten secret.</div></div></dd>\n<div class=\"dialogue\">\n<dl><dt>(Talk to Chenpi)</dt>\n<dd><b>Chenpi:</b> You've come just at the right time, friend. I just got my hands on an antique.</dd>\n<dd><b>Chenpi:</b> It seems tied to a legend about Mt. Firmament, but the records have been lost over the years.</dd>\n<dd><b>Chenpi:</b> Now if you're interested, why don't you take a look at it for me?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" /></span></span> Is this... a creation of the <a href=\"/wiki/Court_of_Savantae\" title=\"Court of Savantae\">Court of Savantae</a>?</dd>\n<dd><b>Chenpi:</b> Ha, you've got a keen eye! This is indeed a CSC creation. A key specifically, I think. As for what door it opens and how it works, that's beyond my knowledge.</dd>\n<dd><b>Chenpi:</b> Rover, you are the one who have solved countless puzzles left by the CSC. I wonder how this strikes you.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" /></span></span> It looks like two parts that can fit together.</dd>\n<dd><b>Chenpi:</b> It does, and I've tried doing so, but it made no difference. Nothing special came out of it.</dd>\n<dd><b>Chenpi:</b> You can still try that yourself, though. Things might turn out differently.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Fit the two parts together.</dd>\n<dd><b>As you fit the two parts together, the assembled antique lets out a \"click,\" and projects a miniature image.</b></dd>\n<dd><b>Chenpi:</b> Oh? How fantastic. Looks like it's connected with you.</dd>\n<dd><b>Chenpi:</b> The projection seems to be a map. It points to... the Tianqu Tree, and has a note beside it, \"Woodveil Hall.\"</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Tianqu Tree... That giant, dying wood?</dd>\n<dd><b>Chenpi:</b> Precisely. I've also heard about this while I was in Hongzhen a few days ago trying to buy some good stuff.</dd>\n<dd><b>Chenpi:</b> In its prime, Tianqu Tree was luxuriant and worshipped as a protection of Hongzhen.</dd>\n<dd><b>Chenpi:</b> However, it started withering away in the late episode. The whole of Hongzhen pities.</dd>\n<dd><b>Chenpi:</b> Maybe Tianqu Tree's fate is sealed... Anyway, this key is yours, my friend.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Mine?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Really? For free?</dd>\n<dd><b>Chenpi:</b> I am a merchant, that's for sure, but I think I told you this when we first met...</dd>\n<dd><b>Chenpi:</b> ...I'm not stingy when it comes to money. It's more about serendipity and belief.</dd>\n<dd><b>Chenpi:</b> This key looked so ordinary in my hands, but now, its connection to you is clearly revealed.</dd>\n<dd><b>Chenpi:</b> In that case, why should I lock it away in my cabinet and make everything it stands for remain a mystery?</dd>\n<dd><b>Chenpi:</b> I cannot betray my belief simply out of greed. So take it, friend.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Got it.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> I will bring back the story behind it.</dd>\n<dd><b>Chenpi:</b> Ha. That sounds proper. Then I'll wait for your story.</dd></dl>\n<hr />\n<dl><dd><b>???:</b> \"Chrono Sign\" detected. Confirming identity... Welcome, ████ Civilization ██... Data error found. Searching secondary databases... Hello, Rover.</dd>\n<dd><b>Rover:</b> You... know me? Who are you?</dd>\n<dd><b>???:</b> You fit the descriptions in the profile titled \"Rover.\" Minor date discrepancies are ignored.</dd>\n<dd><b>Caleb:</b> I am Caleb, a research assistant AI created by the CSC. You now have the supreme authority over Woodveil Hall Laboratory. Best of luck with your research.</dd></dl>\n<hr />\n<dl><dt>(Head to the designated location)</dt>\n<dd><b>Caleb:</b> Apologies, Rover. Maintenance devices are severely damaged here. Deicing the slope is impossible.</dd>\n<dd><b>Caleb:</b> Skiing is recommended.</dd></dl>\n<hr />\n<dl><dt>(Head to the designated location)</dt>\n<dd><b>Caleb:</b> Rover, as you might have noticed, some areas in Woodveil Hall are blocked with rocks for security reasons.</dd>\n<dd><b>Caleb:</b> You can lift them by freezing the time around them with the Chronopin here.</dd>\n<dd><b>Caleb:</b> Access to the Chronopins is granted to your Terminal. Feel free to check the tutorials anytime.</dd></dl>\n<hr />\n<dl><dt>(Head to the designated location)</dt>\n<dd><b>Caleb:</b> Well done, Rover. You have found the trick to this.</dd>\n<dd><b>Caleb:</b> Please proceed carefully through the tunnel below, as I am unable to shut down the light-beam defense system due to a connection failure.</dd></dl>\n<hr />\n<dl><dt>(Head to the designated location)</dt>\n<dd><b>Caleb:</b> My creator, <span class=\"new\" title=\"Victor Christopher (page does not exist)\" data-uncrawlable-url=\"L3dpa2kvVmljdG9yX0NocmlzdG9waGVyP2FjdGlvbj1lZGl0JnJlZGxpbms9MQ==\">Victor</span>, was thrilled with these rocks. They seemed to somehow... fulfill some of his childhood dreams.</dd>\n<dd><b>Rover:</b> Victor...?</dd>\n<dd><b>Caleb:</b> ...Sorry. I can't retrieve relevant information since my database is down. I'm not sure why I mentioned that name.</dd></dl>\n<hr />\n<dl><dt>(Activate the device)</dt>\n<dd><b>Caleb:</b> Some Tacets Discords have broken into the Woodveil Hall lately, disabling the security nodes around.</dd>\n<dd><b>Caleb:</b> Worse still, even the energy core was damaged, and I can't fix it... Luckily, you are here now, Rover.</dd>\n<dd><b>Caleb:</b> A Prototype Chronosorter is deployed at the heart of the lab. Once activated, it will restore the entire facility.</dd></dl>\n<hr />\n<dl><dt>(Head to the designated location)</dt>\n<dd><b>Caleb:</b> This is the Prototype Chronosorter. Despite its designation, it was actually a blueprint, which the CSC kept building upon.</dd>\n<dd><b>Caleb:</b> As you can see, it is bonded to the energy core of Woodveil Hall.</dd>\n<dd><b>Caleb:</b> The tree roots surrounding the energy core belong to the massive tree above Woodveil Hall. Some of the energy emitted from the core nourishes the tree.</dd>\n<dd><b>Caleb:</b> However, the damage caused by the TDs to the energy core has led to excessive energy leakage, which is killing the organism... If this continues, the tree is estimated to perish in 10 days.</dd></dl>\n<hr />\n<dl><dt>(Interact with the Prototype Chronosorter)</dt>\n<dd><i>As you press the button on the Prototype Chronosorter, nothing happens.</i></dd>\n<dd><b>Caleb:</b> Running system test... Bad news, Rover. The Chronosorter is locked due to potential security risks within the facility.</dd>\n<dd><b>Caleb:</b> We must reboot and repair all the security nodes in the facility before the Chronosorter can be activated.</dd></dl>\n<hr />\n<dl><dt>(Interact with the first security node)</dt>\n<dd><b>Caleb:</b> Multiple Tacet Discords detected... On your guard, Rover. They have spotted us.</dd>\n<dd><b>Caleb:</b> We must buy the time for the node to reboot, or we are doing this in vain.</dd>\n<dd><b>Caleb:</b> Suggestion: Freeze time with the Chronopin to hinder the enemy and help our mission.</dd></dl>\n<hr />\n<dl><dt>(Reboot the first security node)</dt>\n<dd><b>Caleb:</b> Security node back online.</dd>\n<dd><b>Caleb:</b> Well done, Rover.</dd></dl>\n<hr />\n<dl><dt>(Head to the designated location)</dt>\n<dd><b>Caleb:</b> Arrived at the target security node. No traces of TD found. Speculation: The node is yet to discover for TDs.</dd>\n<dd><b>Caleb:</b> Now, we have to manually close up the energy circuit to power the security node.</dd></dl>\n<hr />\n<dl><dt>(Reboot the first security node)</dt>\n<dd><b>Caleb:</b> Self-test complete.</dd>\n<dd><b>Caleb:</b> We are ahead of schedule. Everything will be fixed soon if we keep the pace.</dd></dl>\n<hr />\n<dl><dt>(Create a path with Chronosorter)</dt>\n<dd><b>Rover:</b> Caleb, tell me what Woodveil Hall was built for.</dd>\n<dd><b>Caleb:</b> ...Sorry, I can't find the relevant data. Please consult a researcher with a higher access.</dd>\n<dd><b>Caleb:</b> Searching for the researcher payroll... Sorry, no valid results found in the database.</dd></dl>\n<hr />\n<dl><dt>(Approach the designated location)</dt>\n<dd><b>Caleb:</b> Interesting. Security node here is still running... Accessing log.</dd>\n<dd><b>Caleb:</b> TDs triggered the security node here. Prepare for combat, Rover.</dd></dl>\n<hr />\n<dl><dt>(Complete Clang Bang puzzle)</dt>\n<dd><b>Caleb:</b> Confirming node status...</dd>\n<dd><b>Caleb:</b> Backup energy ready. Available for activation.</dd></dl>\n<hr />\n<dl><dt>(Interact with the fourth security node)</dt>\n<dd><b>Caleb:</b> Great. All nodes are back online.</dd>\n<dd><b>Caleb:</b> Planning route... This way, Rover. A shortcut back to the Prototype Chronosorter.</dd></dl>\n<hr />\n<dl><dt>(Investigate the info tablet)</dt></dl>\n<i><div role=\"note\" data-nosnippet=\"\" class=\"notice hatnote context-link main dablink\">Main article: <a href=\"/wiki/Private_Journal_V\" title=\"Private Journal V\">Private Journal V</a></div></i>\n<hr />\n<dl><dt>(Head to the designated location)</dt>\n<dd><b>Caleb:</b> Energy circuit closed. Ready for activation. Wait, Rover, watch out.</dd>\n<dd><b>Caleb:</b> Abnormal frequencies detected... Anticipation: active defense device, Lumiscale Construct.</dd>\n<dd><b>Caleb:</b> It identifies us as intruders. It seems we need to neutralize it.</dd></dl>\n<hr />\n<dl><dt>(Defeat the enemies)</dt>\n<dd><b>Caleb:</b> ...Well done, Rover. Testing Prototype Chronosorter status...</dd>\n<dd><b>Caleb:</b> My mission is complete. All systems are operational. You may now activate it, Rover.</dd></dl>\n<hr />\n<dl><dt>(Activate the device)</dt>\n<dt>(Cutscene plays)</dt>\n<dt>(Cutscene ends)</dt>\n<dd><b>Caleb:</b> What a fantastic sight, Rover. I'm sure the frequency of this tree was... faint until just now.</dd>\n<dd><b>Caleb:</b> Analyzing... It appears the Prototype Chronosorter has positively impacted the local ecology, besides rewinding the time for the equipment in Woodveil Hall.</dd>\n<dd><b>Caleb:</b> It wasn't designed for this. It seems more like an accident, caused by unknown factors.</dd>\n<dd><b>Caleb:</b> It didn't resurrect the dead or grant immortality to the living, but it did reverse what should be a natural cycle of life.</dd>\n<dd><b>Caleb:</b> It's a pity my creators aren't here to witness this.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Did you remember who they were?</dd>\n<dd><b>Caleb:</b> Yes, Rover. My memory data has been corrupted over a long course of time. I've even lost their names.</dd>\n<dd><b>Caleb:</b> But since you restored Woodveil Hall, the data has... somehow come back to me.</dd>\n<dd><b>Caleb:</b> I thank you on behalf of the Research Director Prof. Bram S., Junior Researcher Victor Christopher, and the other thirty-three faculty members.</dd>\n<dd><b>Caleb:</b> I thank you for restoring the Lab, despite the failure of their research. You have given me the chance to continue their work and finish what they started.</dd>\n<dd><b>Caleb:</b> Whether it takes a century or even a millennium... I will continue this work. It is my mission, and it is Victor's wish.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Actually, their research was successful.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Their efforts didn't go fruitless.</dd>\n<dd><b>You tell Caleb the event at Mt. Firmament, and make clear the role Chronosorters played.</b></dd>\n<dd><b>Caleb:</b> So you're saying, the Chronosorters did save Mt. Firmament. Is that true, Rover?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> A tiny seed...</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> ...Has grown into a majestic tree.</dd>\n<dd><b>Caleb:</b> So it all paid off... Please forgive me Rover, what I'm feeling right now is beyond the capacity of my emotional module.</dd>\n<dd><b>Caleb:</b> Some of the researchers... grew doubtful of their work, thinking it was mission impossible.</dd>\n<dd><b>Caleb:</b> While those who stayed left this world with regret and unfulfilled wishes.</dd>\n<dd><b>Caleb:</b> Now it becomes all clear... Their work wasn't in vain. They would feel relieved too, if they were to learn this.</dd>\n<dd><b>Caleb:</b> Thank you Rover, for telling me all this.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> You mission is complete, Caleb.</dd>\n<dd><b>Caleb:</b> Maybe... With the supreme authority in hand, you are now in the place to determine my tasks going forward.</dd>\n<dd><b>Caleb:</b> Suggestion: You may instruct me to continue the research here. Many mysteries around Mt. Firmament remain unsolved. I'm confident we'll uncover the truth one day.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Go on then, if that is your wish.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> You may have your well-deserved rest.</dd>\n<dd><b>Caleb:</b> Order received... Thank you.</dd>\n<dd><b>Caleb:</b> I'd like to observe this tree for a bit longer, Rover. My work began the day it was just a seed.</dd>\n<dd><b>Caleb:</b> And now... it has become the shelter of the whole Lab. How time flies...</dd></dl>\n<hr />\n<dl><dt>(Talk to Chenpi)</dt>\n<dd><b>Chenpi:</b> How was your adventure, friend? I presume you have learned the secret of the key.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> I'm uplifted.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> I'm a bit upset.</dd>\n<dd><b>Chenpi:</b> Ah, I can tell by your look that you've met something extraordinary.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Yes, I did.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> The story I heard was impressive.</dd>\n<dd><b>Chenpi:</b> Oh? Then why don't you share it with me, now that neither of us is in a hurry?</dd>\n<dd><b>You tell Chenpi the event.</b></dd>\n<dd><b>Chenpi:</b> An AI left by the CSC? And it's been continuing the research its creator wanted, all these years since they passed away?</dd>\n<dd><b>Chenpi:</b> This isn't the weirdest story I've ever heard, friend, but it is... intriguing.</dd>\n<dd><b>Chenpi:</b> Don't overthink. Tragedy or comedy, it's always part of destiny.</dd>\n<dd><b>Chenpi:</b> Keep this key, friend, as a reminder.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Thank you.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> That's nice of you.</dd>\n<dd><b>Chenpi:</b> Haha! Just bring me some more good stuff next time!</dd>\n<dt>(Quest Complete)</dt></dl>\n</div>\n<h2><span class=\"mw-headline\" id=\"Other_Languages\">Other Languages</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<table class=\"article-table alternating-colors-table\"><tbody><tr><th>Language</th><th>Official Name</th></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji EN Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji EN Flag.png\" data-image-key=\"Emoji_EN_Flag.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/f/f5/Emoji_EN_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221541\" /></span></span></span>&#160;&#160;English</b></td><td>Vigil of Endless Night</td></tr><tr><td style=\"line-height:1em\"><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ZHS Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ZHS Flag.png\" data-image-key=\"Emoji_ZHS_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/5/5f/Emoji_ZHS_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221618\" /></span></span></span>&#160;&#160;Chinese <abbr title=\"Simplified\"><small>(S)</small></abbr></b></td><td><span lang=\"zh-Hans\">守望永恒</span></td></tr><tr><td style=\"line-height:1em\"><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ZHT Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ZHT Flag.png\" data-image-key=\"Emoji_ZHT_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/02/Emoji_ZHT_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221733\" /></span></span></span>&#160;&#160;Chinese <abbr title=\"Traditional\"><small>(T)</small></abbr></b></td><td><span lang=\"zh-Hant\">守望永恒</span></td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji JA Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji JA Flag.png\" data-image-key=\"Emoji_JA_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/8/84/Emoji_JA_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221804\" /></span></span></span>&#160;&#160;Japanese</b></td><td><span lang=\"ja\">永遠の見守り人</span></td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji KO Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji KO Flag.png\" data-image-key=\"Emoji_KO_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/5/5d/Emoji_KO_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221837\" /></span></span></span>&#160;&#160;Korean</b></td><td><span lang=\"ko\">영원을</span> <span lang=\"ko\