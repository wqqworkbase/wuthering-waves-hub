{
  "title": "Avinoleum Footsteps",
  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><p class=\"mw-empty-elt\">\n</p><aside role=\"region\" class=\"portable-infobox pi-background pi-border-color pi-theme-wikia pi-layout-stacked\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"title\">Avinoleum Footsteps</h2>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"type\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Quest Type</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Side_Quests\" class=\"mw-redirect\" title=\"Side Quests\">Side</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"chapter\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Event</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Acropolis_Documentarian\" title=\"Acropolis Documentarian\">Acropolis Documentarian</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"requirement\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Requirements</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><ul><li>Complete <a href=\"/wiki/Main_Quest\" title=\"Main Quest\">Main Quest</a> <i><a href=\"/wiki/The_Maiden,_The_Defier,_The_Death_Crier\" title=\"The Maiden, The Defier, The Death Crier\">The Maiden, The Defier, The Death Crier</a></i> in <a href=\"/wiki/Chapter_II\" title=\"Chapter II\">Chapter II</a>&#58; Act IV</li><li>Complete <span class=\"new\" title=\"Scale of Past (page does not exist)\" data-uncrawlable-url=\"L3dpa2kvU2NhbGVfb2ZfUGFzdD9hY3Rpb249ZWRpdCZyZWRsaW5rPTE=\">Scale of Past</span></li></ul></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"description\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Description</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">An elderly hermit is writing his memoirs by the seminary ruins. He would like some images of Avinoleum.</div>\n</div>\n<section class=\"pi-item pi-group pi-border-color\">\n\t\n\t<section class=\"pi-item pi-panel pi-border-color wds-tabber\">\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tabs__wrapper\">\n\t\t\t\t<ul class=\"wds-tabs\">\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab wds-is-current\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tRewards\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tCharacters\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tab__content wds-is-current\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"rewards\">\n\t\n\t<div class=\"pi-data-value pi-font\"><span class=\"card-list-container\"><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-3\"><span typeof=\"mw:File\"><a href=\"/wiki/Medium_Resonance_Potion\" title=\"Medium Resonance Potion\"><img alt=\"Medium Resonance Potion\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Medium Resonance Potion.png\" data-image-key=\"Item_Medium_Resonance_Potion.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d2/Item_Medium_Resonance_Potion.png/revision/latest/scale-to-width-down/74?cb=20240524152915\" /></a></span></span><span class=\"card-text card-font\"> 2</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-3\"><span typeof=\"mw:File\"><a href=\"/wiki/Medium_Energy_Core\" title=\"Medium Energy Core\"><img alt=\"Medium Energy Core\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Medium Energy Core.png\" data-image-key=\"Item_Medium_Energy_Core.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/1/18/Item_Medium_Energy_Core.png/revision/latest/scale-to-width-down/74?cb=20240524153056\" /></a></span></span><span class=\"card-text card-font\"> 2</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-3\"><span typeof=\"mw:File\"><a href=\"/wiki/Medium_Sealed_Tube\" title=\"Medium Sealed Tube\"><img alt=\"Medium Sealed Tube\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Medium Sealed Tube.png\" data-image-key=\"Item_Medium_Sealed_Tube.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/7e/Item_Medium_Sealed_Tube.png/revision/latest/scale-to-width-down/74?cb=20240529094325\" /></a></span></span><span class=\"card-text card-font\"> 1</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-3\"><span typeof=\"mw:File\"><a href=\"/wiki/Shell_Credit\" title=\"Shell Credit\"><img alt=\"Shell Credit\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Shell Credit.png\" data-image-key=\"Item_Shell_Credit.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d1/Item_Shell_Credit.png/revision/latest/scale-to-width-down/74?cb=20240523132525\" /></a></span></span><span class=\"card-text card-font\"> 3,000</span></span></div></span></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t\t\t<div class=\"wds-tab__content\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"characters\">\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Andrea\" title=\"Andrea\">Andrea</a></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t</section>\n\n\n\n\n</section>\n</aside>\n\n<b>Avinoleum Footsteps</b> is a <a href=\"/wiki/Side_Quest\" title=\"Side Quest\">Side Quest</a> that occurs in <a href=\"/wiki/Beohr_Waters\" title=\"Beohr Waters\">Beohr Waters</a>, <a href=\"/wiki/Rinascita\" title=\"Rinascita\">Rinascita</a>, [[{{{nation}}}]].\n<p class=\"mw-empty-elt\"></p>\n<div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Steps\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Steps</span></a></li>\n<li class=\"toclevel-1 tocsection-2\"><a href=\"#Gameplay_Notes\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">Gameplay Notes</span></a></li>\n<li class=\"toclevel-1 tocsection-3\"><a href=\"#Dialogue\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">Dialogue</span></a></li>\n<li class=\"toclevel-1 tocsection-4\"><a href=\"#Other_Languages\"><span class=\"tocnumber\">4</span> <span class=\"toctext\">Other Languages</span></a></li>\n<li class=\"toclevel-1 tocsection-5\"><a href=\"#Change_History\"><span class=\"tocnumber\">5</span> <span class=\"toctext\">Change History</span></a></li>\n</ul>\n</div>\n\n<h2><span class=\"mw-headline\" id=\"Steps\">Steps</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ol><li>Chat with the elderly man</li>\n<li>Reach the first marked location</li>\n<li>Photograph the Holy Spire of Confluence in the distance</li>\n<li>Investigate the frequency</li>\n<li>Reach the second photography location</li>\n<li>Photograph the sights by the waterway</li>\n<li>Listen carefully to the reverberations of the past</li>\n<li>Reach the third photography location</li>\n<li>Photograph the dome roof from inside the Titular Repository</li>\n<li>Use Sensor to look for clues in the Titular Library</li>\n<li>Investigate the lingering frequency in the letters here</li>\n<li>Head to the area around Zargon Garden</li>\n<li>Listen carefully to the reverberations of the past</li>\n<li>Leave the garden and head towards the Holy Spire of Confluence</li>\n<li>(Optional) Free \"Sloppy\"</li>\n<li>Follow the waterway to the Holy Spire of Confluence</li>\n<li>Ride the Gondola</li>\n<li>Investigate the frequency here</li>\n<li>Investigate the second frequency</li>\n<li>Investigate the third frequency</li>\n<li>Investigate the last frequency</li>\n<li>Deliver the images to Andrea</li></ol>\n<h2><span class=\"mw-headline\" id=\"Gameplay_Notes\">Gameplay Notes</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<h2><span class=\"mw-headline\" id=\"Dialogue\">Dialogue</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<dd><div class=\"description-wrapper\"><div class=\"description-title\"><b><span typeof=\"mw:File\"><span><img alt=\"UI Quest\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0f/UI_Quest.png/revision/latest/scale-to-width-down/20?cb=20260501180345\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element\" data-image-name=\"UI Quest.png\" data-image-key=\"UI_Quest.png\" data-relevant=\"0\" /></span></span> Quest Description</b></div><hr class=\"description-separator\" /><div class=\"description-content\">An elderly hermit is writing his memoirs by the seminary ruins. He would like some images of Avinoleum.</div></div></dd>\n<div class=\"dialogue\">\n<dl><dt>(Idle)</dt>\n<dd><b>Andrea:</b> The tower... It seems to have risen to where Avinoleum is.</dd>\n<dd><b>Andrea:</b> What happened? Was that my hallucination?</dd></dl>\n<hr />\n<dl><dt>(Talk to Andrea)</dt>\n<dd><b>Andrea:</b> Excuse me, (sir/madam), have you noticed something unusual in that sky?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" /></span></span> You've been observing the sky?</dd>\n<dd><b>Andrea:</b> Yes, just an old habit of mine.</dd>\n<dd><b>Andrea:</b> Once, Avinoleum was a marvel admired across all of Rinascita. But now, it's nothing more than an expanse of shadows, hanging in the sky.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" /></span></span> I've been there before.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Actually, I just returned from there.</dd>\n<dd><b>Andrea:</b> What? How did you...? Ah, I can sense that you are a powerful Resonator. There's no reason you would lie about such a thing.</dd>\n<dd><b>Andrea:</b> Forgive this old man's ramblings. I've been writing a memoir... a record of Ragunna's past.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Ragunna's past?</dd>\n<dd><b>Andrea:</b> Yes. Twenty years ago, the Dark Tide swept through and changed everything. It took too many things and people we held dear.</dd>\n<dd><b>Andrea:</b> Someone must write it down, lest the glory and triumphs of our past fade into nothing.</dd>\n<dd><b>Andrea:</b> But when I reached the part about Avinoleum, I realized I could barely remember what it looked like.</dd>\n<dd><b>Andrea:</b> I... My memories of the seminary are slipping away. The place where I spent my youth, where I strengthened my faith and devoted myself to self-discipline... it's all fading.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Are you an Acolyte?</dd>\n<dd><b>Andrea:</b> I was. But as you can see, I no longer wear the vestment.</dd>\n<dd><b>Andrea:</b> The current Order deems the study of the past forbidden, erasing all past records.</dd>\n<dd><b>Andrea:</b> But now I have an idea... If you can reach the seminary, could you capture some photos for me?</dd>\n<dd><b>Andrea:</b> Even if it has changed greatly, seeing it again might help me recall something... Anything.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Sure thing.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Sure, with the right compensation.</dd>\n<dd><b>Andrea:</b> Absolutely. I've managed to save a little over the years. You won't be doing this for nothing.</dd>\n<dd><b>Andrea:</b> Please take this map with you. I... no longer need it.</dd>\n<dd><b>The old man gives you a slightly yellowed map. You find some familiar places depicted on it.</b></dd>\n<dd><b>Andrea:</b> This was drawn back when Avinoleum was still on the ground. It marks the renowned places of that time.</dd>\n<dd><b>Andrea:</b> Even now, high in the heavens, I believe some traces of its former beauty remain.</dd>\n<dd><b>Andrea:</b> If you can... take some time to appreciate the sights and enjoy the Ragunna of old.</dd></dl>\n<hr />\n<dl><dt>Photograph the Holy Spire of Confluence in the distance)</dt>\n<dd><b>Rover:</b> (Hmm? Seems like a special frequency appeared nearby?)</dd></dl>\n<hr />\n<dl><dt>(Investigate the frequency)</dt>\n<dd><i>The lingering frequency turns into unfamiliar voices around you.</i></dd>\n<dd><b>\"Young Girl\":</b> Father... we've arrived? Is this Avinoleum?</dd>\n<dd><b>\"Father\":</b> Yes, my dear. We are here at Avinoleum.</dd>\n<dd><b>\"Father\":</b> A place blessed by the Sentinel, where divine glory converges&#8212;the Avinoleum Theological Seminary.</dd>\n<dd><b>\"Father\":</b> From this day forward, you shall study here and grow into an Acolyte strong enough to bear the burden, just as I once did.</dd>\n<dd><b>\"Young Girl\":</b> But Father, are you leaving again?</dd>\n<dd><b>\"Father\":</b> I'm sorry, sweethreath. There are still far-off corners where the Sentinel's blessings have yet to reach. I must continue my duties.</dd>\n<dd><b>\"Father\":</b> But know this, I'll return to you whenever you need me.</dd></dl>\n<hr />\n<dl><dt>(Photograph the sights by the waterway)</dt>\n<dd><b>Rover:</b> (Something feels familiar...)</dd>\n<dd><b>Rover:</b> (It must be that special frequency. What message will it carry this time?)</dd></dl>\n<hr />\n<dl><dt>(Listen carefully to the reverberations)</dt>\n<dd><i>Cheers from the crowds fill the air. The banks of the waterway are jammed with people.</i></dd>\n<dd><b>\"Young Girl\":</b> Ragunna City is always full of cheer and joy at such times, but I never expected to see the same festive spirit at the seminary.</dd>\n<dd><b>\"Young Girl\":</b> The banks are lined with Acolytes watching the festivities. Even our professors are dancing without a care in the world.</dd>\n<dd><b>\"Companion\":</b> It's the Carnevale, a time to forget all titles and ranks!</dd>\n<dd><b>\"Young Girl\":</b> You're right. The Carnevale is when differences and disputes are set aside.</dd>\n<dd><b>\"Companion\":</b> Hey, don't just stand there! Come join us! We might even catch a glimpse of the Blessed Maiden herself!</dd>\n<dd><b>\"Young Girl\":</b> Let's go!</dd></dl>\n<hr />\n<dl><dt>(Read)</dt>\n<dd><big><b>A Young Acolyte's Letter</b></big><hr />Dearest Father,<br /><br />I am writing this letter to you from a corner of the library. Over time, I have slowly adjusted to life at the seminary. During my free time, I often come to this library to read the ancient texts it holds and study the doctrine of Unity. But the deeper I delve into the history of Rinascita, the more I sense that it is shrouded by an unresolved mist. There are too many unanswered questions about our faith, the grace we have received, and the disaster that once befell us.<br /><br />Fortunately, many publicly sensitive topics and even discussions of taboos are regarded as subjects of academic interest in the seminary. I will take time to study and explore them. Of course, I haven't neglected the swordsmanship Mother taught me. Recently, I applied for sparring practice with the Divine Envoys... Don't worry, I won't hurt myself.<br /><br />I remember you once told me that Avinoleum is so vast you'll always get lost. This year, I've walked everywhere in the seminary, except for those places where I'm not allowed to go. I've drawn a <b>simple route map</b>, which is easier to read than the one in the Order. I'll send it to you later.<br /><br />With my sword and lantern, I press on through the fog.<br /><br />My Lord Imperator from above,<br /><br /><a href=\"/wiki/Rosalie\" title=\"Rosalie\">Rosalie</a></dd></dl>\n<hr />\n<dl><dd><b>Rover:</b> (A hand-drawn map of the seminary? Just like the one I carry.)</dd>\n<dd><b>Rover:</b> (Perhaps this is not a coincidence.)</dd></dl>\n<hr />\n<dl><dt>(Listen carefully to the reverberations)</dt>\n<dd><b>\"Young Girl\":</b> You call this dragon Echo... \"Sloppy?\"</dd>\n<dd><b>\"Senior Female Acolyte\":</b> That's right. It's known for its gentle, docile nature, loafing around all day. Not that it's shy. It's simply too lazy to move.</dd>\n<dd><b>\"Young Girl\":</b> May I come closer? I just want to pet it.</dd>\n<dd><b>\"Young Girl\":</b> Oh, it feels so cold.</dd>\n<dd><b>\"Senior Female Acolyte\":</b> Hahaha, feel free to spend as much time with it as you like.</dd>\n<dd><b>\"Young Girl\":</b> And what about that giant dragon over there?</dd>\n<dd><b>\"Senior Female Acolyte\":</b> First time seeing it? That's the Blessed Maiden's mount, <a href=\"/wiki/Gehinnom\" class=\"mw-redirect\" title=\"Gehinnom\">Gehinnom</a>. It might look intimidating, but it's actually a gentle soul.</dd>\n<dd><b>\"Senior Female Acolyte\":</b> Speaking of which, the Blessed Maiden's coronation is around the corner.</dd>\n<dd><b>\"Young Girl\":</b> Yeah, I can hardly wait.</dd></dl>\n<hr />\n<dl><dd><b>Rover:</b> (The Blessed Maiden's coronation? Wait, I sense a Tacet Discord's frequency.)</dd>\n<dd><b>Sloppy?:</b> *Fretful and depressed cry*</dd></dl>\n<hr />\n<dl><dt>(Head to the designated location)</dt>\n<dd><b>\"Young Girl\":</b> According to the schedule, the Blessed Maiden will be crowned under the dome soon...</dd>\n<dd><b>\"Young Girl\":</b> But why does the air feel so heavy?</dd></dl>\n<hr />\n<dl><dt>(Head to the designated location)</dt>\n<dd><i>The clamor of the crowd, their panicked shrieks, and an eerie hymn echo all around...</i></dd>\n<dd><b>\"Young Girl\":</b> The dark, suffocating fog that's swallowing the sky... Could this be the <a href=\"/wiki/Dark_Tide\" title=\"Dark Tide\">Dark Tide</a>?</dd>\n<dd><b>\"Young Girl\":</b> Don't be tempted by the songs! Run! Beware the Tacet Discords!</dd>\n<dd><b>\"Young Girl\":</b> Now is not the time to surrender. I still see the Blessed Maiden's light shining through. She hasn't given up yet!</dd>\n<dd><b>\"Young Girl\":</b> My lantern still burns bright, and my sword remains keen enough to fell any evil that dares approach!</dd></dl>\n<hr />\n<dl><dt>(Head to the designated location)</dt>\n<dd><i>The final words of the girl echo in the langering frequency.</i></dd>\n<dd><b>\"Young Girl\":</b> I, Rosalie Seneca, will never succumb to the Dark Tide.</dd>\n<dd><b>\"Young Girl\":</b> Heh, but if luck should spare me one last time, I want to live... I have so many dreams yet to fulfill...</dd>\n<dd><i>And then, silence falls once more.</i></dd>\n<dd><b>Rover:</b> ...</dd></dl>\n<hr />\n<dl><dt>(Talk to Andrea)</dt>\n<dd><b>Andrea:</b> <span>(&#8205;&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Sir\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Sir</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for male Rover</span></span>&#8205;/<wbr />&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Madam\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Madam</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for female Rover</span></span>&#8205;&#8205;)</span>, you just returned from Avinoleum?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> (Hand him the pictures of the seminary)</dd>\n<dd><b>Andrea:</b> ...</dd>\n<dd><b>Andrea:</b> This is indeed Avinoleum. These towers, these columns... They still shine with the brilliance of days gone by.</dd>\n<dd><b>Andrea:</b> ...<span>(&#8205;&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Sir\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Sir</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for male Rover</span></span>&#8205;/<wbr />&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Madam\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Madam</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for female Rover</span></span>&#8205;&#8205;)</span>, there's something I must ask, something I wasn't ready to inquire before.</dd>\n<dd><b>Andrea:</b> When the Dark Tide surged, my daughter, <span class=\"text-help\"><b>Rosalie</b></span>, was studying in the seminary. Like so many others there, she vanished from this world.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> ...</dd>\n<dd><b>Andrea:</b> Do you think it's possible that, after all these years, Rosalie still survives in those ruins, isolated from our world?</dd>\n<dd><i>You are instinctively aware of the weight of this question. About that girl's ending...</i></dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Actually, I encountered her lingering frequencies.\n<dl><dd><b>Andrea:</b> ...! Did she say anything? Please, tell me everything you saw and heard.</dd>\n<dd><b>You recount in detail what you saw and heard to the old man before you, her ending included.</b></dd>\n<dd><b>The old man's lips quiver ever so slightly. For a long, silent moment, he doesn't speak a word.</b></dd>\n<dd><b>Andrea:</b> I was meant to attend the coronation ceremony with her that day, but circumstances delayed me...</dd>\n<dd><b>Andrea:</b> By the time I arrived, it was too late. I couldn't protect my own child as a father, nor could I safeguard the sacred land as an Acolyte.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> It wasn't your fault.</dd>\n<dd><b>Andrea:</b> Thank you... for telling me.</dd>\n<dd><b>Andrea:</b> At least now I know that my daughter died a true Acolyte, her faith unwavering, her soul virtuous.</dd>\n<dd><b>Andrea:</b> I recall the dusk when I took Rosalie to Avinoleum. The golden light of the setting sun bathed the main tower's dome.</dd>\n<dd><b>Andrea:</b> And she asked me who built such a glorious place or if it was a blessing from the Sentinel.</dd>\n<dd><b>Andrea:</b> I forgot what I answered, but I believe she found her own answer.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> It was the work of those before us.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Along with our efforts that built this civilization.</dd>\n<dd><b>Andrea:</b> One day, on the land of Ragunna, such splendor will rise again.</dd>\n<dd><b>Andrea:</b> I promise, I'll finish this memoir and never let these precious things be lost to time.</dd>\n<dd><b>Andrea:</b> ...Until we meet again, <span>(&#8205;&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"sir\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">sir</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for male Rover</span></span>&#8205;/<wbr />&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"madam\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">madam</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for female Rover</span></span>&#8205;&#8205;)</span>.</dd></dl></dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> (Keep the truth a secret and remain silent)\n<dl><dd><b>Andrea:</b> …Thank you. I believe I already know your answer. That's enough.</dd>\n<dd><b>Andrea:</b> I promise, I'll finish this memoir and never let these precious things be lost to time.</dd>\n<dd><b>Andrea:</b> This long-overdue birthday gift…I know Rosalie would have cherished it.</dd>\n<dd><b>Andrea:</b> ...Until we meet again, <span>(&#8205;&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"sir\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">sir</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for male Rover</span></span>&#8205;/<wbr />&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"madam\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">madam</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">Text for female Rover</span></span>&#8205;&#8205;)</span>.</dd>\n<dd><i>(You remain silent, fixing your calm gaze on the old man.)</i></dd>\n<dd><b>You have left a spark of hope lingering in this old, withered heart.</b></dd>\n<dd><b>Rover:</b> ...</dd></dl></dd></dl>\n<dl><dt>(Quest Complete)</dt></dl>\n</div>\n<h2><span class=\"mw-headline\" id=\"Other_Languages\">Other Languages</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<table class=\"article-table alternating-colors-table\"><tbody><tr><th>Language</th><th>Official Name</th></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji EN Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji EN Flag.png\" data-image-key=\"Emoji_EN_Flag.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/f/f5/Emoji_EN_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221541\" /></span></span></span>&#160;&#160;English</b></td><td>Avinoleum Footsteps</td></tr><tr><td style=\"line-height:1em\"><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ZHS Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ZHS Flag.png\" data-image-key=\"Emoji_ZHS_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/5/5f/Emoji_ZHS_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221618\" /></span></span></span>&#160;&#160;Chinese <abbr title=\"Simplified\"><small>(S)</small></abbr></b></td><td><span lang=\"zh-Hans\">追迹阿维纽林</span></td></tr><tr><td style=\"line-height:1em\"><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ZHT Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ZHT Flag.png\" data-image-key=\"Emoji_ZHT_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/02/Emoji_ZHT_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221733\" /></span></span></span>&#160;&#160;Chinese <abbr title=\"Traditional\"><small>(T)</small></abbr></b></td><td><span lang=\"zh-Hant\">追跡阿維紐林</span></td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji JA Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji JA Flag.png\" data-image-key=\"Emoji_JA_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/8/84/Emoji_JA_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221804\" /></span></span></span>&#160;&#160;Japanese</b></td><td><span lang=\"ja\">アヴィノレームの過去を辿って</span></td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji KO Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji KO Flag.png\" data-image-key=\"Emoji_KO_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/5/5d/Emoji_KO_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221837\" /></span></span></span>&#160;&#160;Korean</b></td><td><span lang=\"ko\">아비놀륨의</span> <span lang=\"ko\">흔적을</span> <span lang=\"ko\">따라</span></td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji FR Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji FR Flag.png\" data-image-key=\"Emoji_FR_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/c/c6/Emoji_FR_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221935\" /></span></span></span>&#160;&#160;French</b></td><td>Sur les traces d'Avinoleum</td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji DE Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji DE Flag.png\" data-image-key=\"Emoji_DE_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/3/3b/Emoji_DE_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221959\" /></span></span></span>&#160;&#160;German</b></td><td>Avinoleum-Spuren</td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ES Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ES Flag.png\" data-image-key=\"Emoji_ES_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d2/Emoji_ES_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221908\" /></span></span></span>&#160;&#160;Spanish</b></td><td>Huellas de Avinoleum</td></tr></tbody></table>\n<h2><span class=\"mw-headline\" id=\"Change_History\">Change History</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<div class=\"change-history\"><div class=\"change-history-header\"><div>Released in <b><a href=\"/wiki/Version/2.2\" title=\"Version/2.2\">Version 2.2</a></b></div><div>[<a target=\"_blank\" rel=\"noreferrer noopener\" class=\"text\" href=\"https://wutheringwaves.fandom.com/wiki/Avinoleum_Footsteps/Change_History?action=edit&amp;preload=Template:Change_History/Preload&amp;preloadparams%5b%5d=2.2&amp;preloadparams%5b%5d=Avinoleum+Footsteps\">Create New History</a>]</div></div></div><div style=\"clear:both; margin:0; padding:0;\"></div></div>",
