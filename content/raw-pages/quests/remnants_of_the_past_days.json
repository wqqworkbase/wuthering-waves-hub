{
  "title": "Remnants of the Past Days",
  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><p class=\"mw-empty-elt\">\n</p><aside role=\"region\" class=\"portable-infobox pi-background pi-border-color pi-theme-wikia pi-layout-stacked\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"title\">Remnants of the Past Days</h2>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"type\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Quest Type</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Tutorial_Quests\" class=\"mw-redirect\" title=\"Tutorial Quests\">Tutorial</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"requirement\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Requirements</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Pick up a <a href=\"/wiki/Sonance_Casket\" title=\"Sonance Casket\">Sonance Casket</a></div>\n</div>\n<section class=\"pi-item pi-group pi-border-color\">\n\t\n\t<section class=\"pi-item pi-panel pi-border-color wds-tabber\">\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tabs__wrapper\">\n\t\t\t\t<ul class=\"wds-tabs\">\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab wds-is-current\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tRewards\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tCharacters\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tab__content wds-is-current\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"rewards\">\n\t\n\t<div class=\"pi-data-value pi-font\"><span class=\"card-list-container\"><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-5\"><span typeof=\"mw:File\"><a href=\"/wiki/Union_EXP\" title=\"Union EXP\"><img alt=\"Union EXP\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Union EXP.png\" data-image-key=\"Item_Union_EXP.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0b/Item_Union_EXP.png/revision/latest/scale-to-width-down/74?cb=20240525121935\" /></a></span></span><span class=\"card-text card-font\"> 150</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-5\"><span typeof=\"mw:File\"><a href=\"/wiki/Astrite\" title=\"Astrite\"><img alt=\"Astrite\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Astrite.png\" data-image-key=\"Item_Astrite.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/1/16/Item_Astrite.png/revision/latest/scale-to-width-down/74?cb=20240523021541\" /></a></span></span><span class=\"card-text card-font\"> 20</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-3\"><span typeof=\"mw:File\"><a href=\"/wiki/Medium_Resonance_Potion\" title=\"Medium Resonance Potion\"><img alt=\"Medium Resonance Potion\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Medium Resonance Potion.png\" data-image-key=\"Item_Medium_Resonance_Potion.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d2/Item_Medium_Resonance_Potion.png/revision/latest/scale-to-width-down/74?cb=20240524152915\" /></a></span></span><span class=\"card-text card-font\"> 3</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-3\"><span typeof=\"mw:File\"><a href=\"/wiki/Shell_Credit\" title=\"Shell Credit\"><img alt=\"Shell Credit\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Shell Credit.png\" data-image-key=\"Item_Shell_Credit.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d1/Item_Shell_Credit.png/revision/latest/scale-to-width-down/74?cb=20240523132525\" /></a></span></span><span class=\"card-text card-font\"> 12,000</span></span></div></span></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t\t\t<div class=\"wds-tab__content\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"characters\">\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Chenpi\" title=\"Chenpi\">Chenpi</a>, <a href=\"/wiki/Chixia\" title=\"Chixia\">Chixia</a>, <a href=\"/wiki/Rover\" title=\"Rover\">Rover</a></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t</section>\n\n\n\n\n</section>\n</aside>\n\n<p class=\"mw-empty-elt\"></p>\n<div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Steps\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Steps</span></a></li>\n<li class=\"toclevel-1 tocsection-2\"><a href=\"#Dialogue\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">Dialogue</span></a></li>\n<li class=\"toclevel-1 tocsection-3\"><a href=\"#Other_Languages\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">Other Languages</span></a></li>\n<li class=\"toclevel-1 tocsection-4\"><a href=\"#Change_History\"><span class=\"tocnumber\">4</span> <span class=\"toctext\">Change History</span></a></li>\n</ul>\n</div>\n\n<h2><span class=\"mw-headline\" id=\"Steps\">Steps</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ol><li>Talk to the Relic Merchant, <a href=\"/wiki/Chenpi\" title=\"Chenpi\">Chenpi</a>, to learn more about Sonance Caskets.</li></ol>\n<h2><span class=\"mw-headline\" id=\"Dialogue\">Dialogue</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<dd><div class=\"description-wrapper\"><div class=\"description-title\"><b><span typeof=\"mw:File\"><span><img alt=\"UI Quest\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"UI Quest.png\" data-image-key=\"UI_Quest.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0f/UI_Quest.png/revision/latest/scale-to-width-down/20?cb=20260501180345\" /></span></span> Quest Description</b></div><hr class=\"description-separator\" /><div class=\"description-content\">You've collected some \"Sonance Caskets\". It seems to fall in the interest of the local Relic Merchant Chenpi.</div></div></dd>\n<div class=\"dialogue\">\n<dl><dd><b>Chixia:</b> Rover, it's a <a href=\"/wiki/Sonance_Casket\" title=\"Sonance Casket\">Sonance Casket</a>! Hmm... Hang on to it. I know this old acquaintance who's a relic merchant. He knows a lot about stuff like this. I'll take you to him when we get to Jinzhou.</dd></dl>\n<hr />\n<dl><dd><b>Chenpi:</b> Hello, Xiaofang. You seem to be in a hurry. What's the matter today?</dd>\n<dd><b>Chixia:</b> Shh... Uncle Chenpi... Please don't call me that, remember?</dd>\n<dd><b>Chenpi:</b> Oops, my bad. I should call you Chixia, Patroller Chixia.</dd>\n<dd><b>Chenpi:</b> So... This youngling here must be a friend of our great Patroller Chixia, yes?</dd>\n<dd><b>Chixia:</b> Uncle Chenpi, please stop teasing me.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Hello.</dd>\n<dd><b>Chixia:</b> Uncle Chenpi, this is my friend Rover, hehe. I brought him/her here today for some help...</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> (Give the Sonance Casket to Chenpi.)</dd>\n<dd><b>Chenpi:</b> Wow, this thing is really hard to find. I've been out in the wild searching for something like this...</dd>\n<dd><b>Chenpi:</b> I'm so lucky to meet you today, Rover.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span>  What is a Sonance Casket.</dd>\n<dd><b>Chenpi:</b> It might look like a box, but it's actually some kind of energy entity that doesn't have a physical existence.</dd>\n<dd><b>Chenpi:</b> On the other hand... One could consider it a box, in a way. The usual boxes contain physical items, but the Sonance Caskets contain records of the past.</dd>\n<dd><b>Chenpi:</b> Simply put...</dd>\n<dd><b>Chenpi:</b> Well... my young friend, this is a data fragment that survived the collapse of Sonoro Spheres. The Sonance Caskets, just like the Sonoro Spheres, hold onto the sounds from the bygone days.</dd>\n<dd><b>Chenpi:</b> Within these Caskets, one can find the most treasured artifacts from the magnificient civilization that existed before the Lament, as well as the profound human emotions experienced during the catastrophe.</dd>\n<dd><b>Chenpi:</b> Ah... They represent the final remnants of the bygone era, washed away by the relentless tide of history.</dd>\n<dd><b>Chenpi:</b> I have a selfish request to make.</dd>\n<dd><b>Chenpi:</b> Could you please let me have this Sonance Casket?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Why?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> What's in it for me?\n<dl><dd><b>Chenpi:</b> Of course, I'll give you something in return.</dd></dl></dd>\n<dd><b>Chenpi:</b> To be frank, the Sonance Casket doesn't hold any financial worth.</dd>\n<dd><b>Chenpi:</b> Yet for those of us who are relic hunters, the information stored in these Sonance Caskets is highly coveted.</dd>\n<dd><b>Chenpi:</b> I can pay you will Shell Credits, or other valuable items.</dd>\n<dd><b>Chenpi:</b> Long story short, it's a sweet deal for you. I'll make sure you're happy with what you get.</dd>\n<dd><b>Chixia:</b> Rover, you can trust Uncle Chenpi. He is a famous treasure appraiser in Jinzhou, definitely not a bad person who'd try to slip one past you.</dd>\n<dd><b>Chixia:</b> Besides, I, Chixia, am a Patroller. If he ever lies to you... Hmph, justice will punish him.</dd>\n<dd><b>Chenpi:</b> Aww, Chixia... You know I'll never do something like that...</dd>\n<dd><b>Chixia:</b> Just kidding, Uncle Chenpi! You're so kind, no hard feelings, okay?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> It's a deal, then. (Hand over the Sonance Casket)</dd>\n<dd><b>Chenpi:</b> Great... Thank you, Rover.</dd>\n<dt>(Quest Complete)</dt></dl>\n<hr />\n<dl><dt>(Optional - Talk to Chenpi again and chose \"About Sonance Caskets\" option)</dt>\n<dd><b>Chenpi:</b> Now, if you have any other questions, please ask away.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Option\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Option.png\" data-image-key=\"Icon_Dialogue_Option.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/9/9a/Icon_Dialogue_Option.png/revision/latest/scale-to-width-down/20?cb=20240529051958\" /></span></span> (Ask about Chixia’s name change.)\n<dl><dd><b>Chenpi:</b> Haha, well... I’m afraid you should ask Patroller Chixia herself.</dd>\n<dd><b>Chixia:</b> Rover, you... Can we please not talk about this? My old name was cringy, that’s all…</dd>\n<dd><b>Chixia:</b> No, I don’t mean to hide anything from you...</dd>\n<dd><b>Chixia:</b> You see, “Ma Xiaofang” just sounds so lame. Heroes in the Hero Plays I watch never use any name like that.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> So your dream is to become a hero.</dd>\n<dd><b>Chixia:</b> Yeah, I’m not quite a hero yet, but I’m giving it my all.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> You’re gonna be the hero of Huanglong, Ma Xiaofang.\n<dl><dd><b>Chixia:</b> Aww… Please, spare me that, Rover.</dd>\n<dd><b>Chixia:</b> Okay... Because we’re besties, I’ll give in a little. You can call me Ma Xiaofang when it’s just us, but please don’t do that when there’s other people.</dd></dl></dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> You’re gonna be the hero of Huanglong, Chixia.\n<dl><dd><b>Chixia:</b> That’s right! Chixia, Chixia... oh, what a magnificent name! I came up with it all by myself. This is the culmination of all my life experiences and knowledge!</dd>\n<dd><b>Chixia:</b> Rover, feel free to call me by any name, but... Ahem, just so you know, that name is for our ears only, okay?</dd></dl></dd></dl></dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Option\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Option.png\" data-image-key=\"Icon_Dialogue_Option.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/9/9a/Icon_Dialogue_Option.png/revision/latest/scale-to-width-down/20?cb=20240529051958\" /></span></span> (Ask him why he is collecting Sonance Caskets.)\n<dl><dd><b>Chixia:</b> Yeah, I wanna know too. You’re all about exploring the past, but people always say we should be looking ahead, so what’s the deal?</dd>\n<dd><b>Chixia:</b> Yeah, I wanna know too. Why are you so keen on collecting Sonance Caskets, Uncle Chenpi? Those… Fragments of past data, are they really that important?</dd>\n<dd><b>Chenpi:</b> The past has influenced how things are today and will be in the future, as everything we see has changed a lot over many years.</dd>\n<dd><b>Chenpi:</b> The seeds of yesterday give root to the flowers of tomorrow. In the absence of historical knowledge, how can we engage in discussions about the future?</dd>\n<dd><b>Chenpi:</b> The past serves as a reminder of our origins, ensuring that we do not lose sight of our original intentions amidst the overwhelming current of history.</dd>\n<dd><b>Chixia:</b> Ah… I see. That sounds really cool. Thank you, Uncle Chenpi.</dd>\n<dd><b>Chenpi:</b> You’re welcome.</dd></dl></dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Option\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Option.png\" data-image-key=\"Icon_Dialogue_Option.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/9/9a/Icon_Dialogue_Option.png/revision/latest/scale-to-width-down/20?cb=20240529051958\" /></span></span> (Ask if he can teach you treasure appraisal.)\n<dl><dd><b>Chixia:</b> Oh right. Uncle Chenpi’s the best treasure appraiser in town.</dd>\n<dd><b>Chenpi:</b> I appreciate the compliment, Chixia. There are numerous talented individuals in Jinzhou, and I am far from being one of the best.</dd>\n<dd><b>Chenpi:</b> If the art of appraising treasure piques your interest, it may be worthwhile to seek guidance from a young girl known as “Master <a href=\"/wiki/Youhu\" title=\"Youhu\">Youhu</a>” if you cross paths with her in the future.</dd>\n<dd><b>Chenpi:</b> I am not nearly as skilled as her. Youngsters these days are seriously talented.</dd>\n<dd><b>Chenpi:</b> Ugh, speaking of that, I haven’t seen Youhu for a while now. Hopefully she didn’t get into trouble again…</dd></dl></dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Arrow\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Arrow.png\" data-image-key=\"Icon_Dialogue_Arrow.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/4/41/Icon_Dialogue_Arrow.png/revision/latest/scale-to-width-down/20?cb=20240529052033\" /></span></span> I've got nothing to ask.</dd>\n<dd><b>Chenpi:</b> If you ever find other Sonance Caskets, please consider selling them to me.</dd>\n<dd><b>Chenpi:</b> Don't worry, the pay will make it worth your while. I'm not stingy when it comes to money.</dd></dl>\n</div>\n<h2><span class=\"mw-headline\" id=\"Other_Languages\">Other Languages</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<table class=\"article-table alternating-colors-table\"><tbody><tr><th>Language</th><th>Official Name</th></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji EN Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji EN Flag.png\" data-image-key=\"Emoji_EN_Flag.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/f/f5/Emoji_EN_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221541\" /></span></span></span>&#160;&#160;English</b></td><td>Remnants of the Past Days</td></tr><tr><td style=\"line-height:1em\"><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ZHS Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ZHS Flag.png\" data-image-key=\"Emoji_ZHS_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/5/5f/Emoji_ZHS_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221618\" /></span></span></span>&#160;&#160;Chinese <abbr title=\"Simplified\"><small>(S)</small></abbr></b></td><td><span lang=\"zh-Hans\">旧日的余音</span></td></tr><tr><td style=\"line-height:1em\"><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ZHT Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ZHT Flag.png\" data-image-key=\"Emoji_ZHT_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/