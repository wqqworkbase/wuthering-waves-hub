  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><p class=\"mw-empty-elt\">\n</p><aside role=\"region\" class=\"portable-infobox pi-background pi-border-color pi-theme-wikia pi-layout-stacked\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"title\">Solaris Weather Forecast: Epilogue</h2>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"type\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Quest Type</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Side_Quests\" class=\"mw-redirect\" title=\"Side Quests\">Side</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"chapter\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Event</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Solaris_Weather_Forecast\" title=\"Solaris Weather Forecast\">Solaris Weather Forecast</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"requirement\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Requirements</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><ul><li>Clear Detection Point VII in <a href=\"/wiki/Solaris_Weather_Forecast\" title=\"Solaris Weather Forecast\">Solaris Weather Forecast</a></li></ul></div>\n</div>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<table class=\"pi-horizontal-group\">\n\t\n\t\n\t<thead>\n\t\t<tr>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"prev\">Previous Quest</th>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"next\">Next Quest</th>\n\t\t\n\t\t</tr>\n\t</thead>\n\t\n\t<tbody>\n\t<tr>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"prev\"><a href=\"/wiki/Solaris_Weather_Forecast_(Quest)\" title=\"Solaris Weather Forecast (Quest)\">Solaris Weather Forecast</a></td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"next\">N/A</td>\n\t\n\t</tr>\n\t</tbody>\n</table>\n\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n\t\n\t<section class=\"pi-item pi-panel pi-border-color wds-tabber\">\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tabs__wrapper\">\n\t\t\t\t<ul class=\"wds-tabs\">\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab wds-is-current\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tRewards\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tCharacters\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tab__content wds-is-current\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"rewards\">\n\t\n\t<div class=\"pi-data-value pi-font\"><span class=\"card-list-container\"><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-3\"><span typeof=\"mw:File\"><a href=\"/wiki/Medium_Resonance_Potion\" title=\"Medium Resonance Potion\"><img alt=\"Medium Resonance Potion\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Medium Resonance Potion.png\" data-image-key=\"Item_Medium_Resonance_Potion.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d2/Item_Medium_Resonance_Potion.png/revision/latest/scale-to-width-down/74?cb=20240524152915\" /></a></span></span><span class=\"card-text card-font\"> 2</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-3\"><span typeof=\"mw:File\"><a href=\"/wiki/Medium_Energy_Core\" title=\"Medium Energy Core\"><img alt=\"Medium Energy Core\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Medium Energy Core.png\" data-image-key=\"Item_Medium_Energy_Core.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/1/18/Item_Medium_Energy_Core.png/revision/latest/scale-to-width-down/74?cb=20240524153056\" /></a></span></span><span class=\"card-text card-font\"> 2</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-3\"><span typeof=\"mw:File\"><a href=\"/wiki/Medium_Sealed_Tube\" title=\"Medium Sealed Tube\"><img alt=\"Medium Sealed Tube\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Medium Sealed Tube.png\" data-image-key=\"Item_Medium_Sealed_Tube.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/7e/Item_Medium_Sealed_Tube.png/revision/latest/scale-to-width-down/74?cb=20240529094325\" /></a></span></span><span class=\"card-text card-font\"> 1</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-3\"><span typeof=\"mw:File\"><a href=\"/wiki/Shell_Credit\" title=\"Shell Credit\"><img alt=\"Shell Credit\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Shell Credit.png\" data-image-key=\"Item_Shell_Credit.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d1/Item_Shell_Credit.png/revision/latest/scale-to-width-down/74?cb=20240523132525\" /></a></span></span><span class=\"card-text card-font\"> 3,000</span></span></div></span></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t\t\t<div class=\"wds-tab__content\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"characters\">\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Arno\" title=\"Arno\">Arno</a></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t</section>\n\n\n\n\n</section>\n</aside>\n<b>Solaris Weather Forecast: Epilogue</b> is a <a href=\"/wiki/Side_Quest\" title=\"Side Quest\">Side Quest</a> that occurs in <a href=\"/wiki/Jinzhou\" title=\"Jinzhou\">Jinzhou</a>, <a href=\"/wiki/Huanglong\" title=\"Huanglong\">Huanglong</a>, [[{{{nation}}}]].\n<p class=\"mw-empty-elt\"></p>\n<div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Steps\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Steps</span></a></li>\n<li class=\"toclevel-1 tocsection-2\"><a href=\"#Gameplay_Notes\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">Gameplay Notes</span></a></li>\n<li class=\"toclevel-1 tocsection-3\"><a href=\"#Dialogue\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">Dialogue</span></a></li>\n<li class=\"toclevel-1 tocsection-4\"><a href=\"#Other_Languages\"><span class=\"tocnumber\">4</span> <span class=\"toctext\">Other Languages</span></a></li>\n<li class=\"toclevel-1 tocsection-5\"><a href=\"#Change_History\"><span class=\"tocnumber\">5</span> <span class=\"toctext\">Change History</span></a></li>\n</ul>\n</div>\n\n<h2><span class=\"mw-headline\" id=\"Steps\">Steps</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ol><li>Talk to <a href=\"/wiki/Arno\" title=\"Arno\">Arno</a></li></ol>\n<h2><span class=\"mw-headline\" id=\"Gameplay_Notes\">Gameplay Notes</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ul><li>This quest is limited.</li></ul>\n<h2><span class=\"mw-headline\" id=\"Dialogue\">Dialogue</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<dd><div class=\"description-wrapper\"><div class=\"description-title\"><b><span typeof=\"mw:File\"><span><img alt=\"UI Quest\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0f/UI_Quest.png/revision/latest/scale-to-width-down/20?cb=20260501180345\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element\" data-image-name=\"UI Quest.png\" data-image-key=\"UI_Quest.png\" data-relevant=\"0\" /></span></span> Quest Description</b></div><hr class=\"description-separator\" /><div class=\"description-content\">Having finished the data collection for Arno, you receive a message from him requesting a meeting in Jinzhou.</div></div></dd>\n<div class=\"dialogue\">\n<dl><dt>(Talk to Arno)</dt>\n<dd><b>Arno:</b> Thank you, (&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Rover\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Rover</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">The player's chosen name for Rover</span></span>&#8205;).</dd>\n<dd><b>Arno:</b> The surveillance data you collected has been analyzed and sent back to the <a href=\"/wiki/Black_Shores\" title=\"Black Shores\">Black Shores</a>.</dd>\n<dd><b>Arno:</b> The data is top-notch—maybe enough for us to add a new variable in our forecast model.</dd>\n<dd><b>Arno:</b> Hopefully, we'll be able to provide even better predictions soon.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" /></span></span> I'm happy I could help.</dd>\n<dd><b>Arno:</b> You're being too kind. We couldn't have done this without you...</dd>\n<dd><b>Arno:</b> <a href=\"/wiki/KU-Ryan\" title=\"KU-Ryan\">KU-Ryan</a> and I are not exactly the athletic type. It would've been nearly impossible to gather sufficient data in such a short time.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" /></span></span> And will that new variable improve your predictions a lot?</dd>\n<dd><b>Arno:</b> It may not have a huge impact. Maybe just a few seconds or milliseconds of difference.</dd>\n<dd><b>Arno:</b> But who knows what situations we'll face in the future? Our new model might be the key to unlocking any loopholes in the old one.</dd>\n<dd><b>Arno:</b> Many people may not understand why I collect data in such a tedious way.</dd>\n<dd><b>Arno:</b> But like they say in Huanglong, a miniscule error could lead to major consequences.</dd>\n<dd><b>Arno:</b> \"If only the forecast was one second closer...\" \"If only the projected spot was ten centimeters more precise...\"</dd>\n<dd><b>Arno:</b> ...But by then, it would be too tardy for regrets.</dd>\n<dd><b>Arno:</b> A few seconds or centimeters could mean life and death. I could've saved more lives with a more precise prediction—</dd>\n<dd><b>Arno:</b> The thought of that makes me unable to accept any error in the data I handle.</dd>\n<dd><b>Arno:</b> Oops. Sorry, I got ahead of myself.</dd>\n<dd><b>Arno:</b> Anyway, thank you so much, (&#8205;<span class=\"custom-tt-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed wuwa-collapsible\" data-tt-text=\"Rover\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-collapsed custom-tt toggle-tooltip\">Rover</span><span class=\"mw-collapsible-content custom-tt\" style=\"display:none\">The player's chosen name for Rover</span></span>&#8205;).</dd>\n<dd><b>Arno:</b> I look forward to working with you again!</dd>\n<dt>(Quest Complete)</dt></dl>\n</div>\n<h2><span class=\"mw-headline\" id=\"Other_Languages\">Other Languages</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<table class=\"article-table alternating-colors-table\"><tbody><tr><th>Language</th><th>Official Name</th></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji EN Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji EN Flag.png\" data-image-key=\"Emoji_EN_Flag.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/f/f5/Emoji_EN_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221541\" /></span></span></span>&#160;&#160;English</b></td><td>Solaris Weather Forecast: Epilogue</td></tr><tr><td style=\"line-height:1em\"><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ZHS Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ZHS Flag.png\" data-image-key=\"Emoji_ZHS_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/5/5f/Emoji_ZHS_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221618\" /></span></span></span>&#160;&#160;Chinese <abbr title=\"Simplified\"><small>(S)</small></abbr></b></td><td><span lang=\"zh-Hans\">索拉里斯气象前沿・尾声</span></td></tr><tr><td style=\"line-height:1em\"><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ZHT Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ZHT Flag.png\" data-image-key=\"Emoji_ZHT_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/02/Emoji_ZHT_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221733\" /></span></span></span>&#160;&#160;Chinese <abbr title=\"Traditional\"><small>(T)</small></abbr></b></td><td><span lang=\"zh-Hant\">索拉里斯氣象前沿・尾聲</span></td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji JA Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji JA Flag.png\" data-image-key=\"Emoji_JA_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/8/84/Emoji_JA_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221804\" /></span></span></span>&#160;&#160;Japanese</b></td><td><span lang=\"ja\">ソラリス気象学最前線・エピローグ</span></td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji KO Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji KO Flag.png\" data-image-key=\"Emoji_KO_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/5/5d/Emoji_KO_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221837\" /></span></span></span>&#160;&#160;Korean</b></td><td><span lang=\"ko\">솔라리스</span> <span lang=\"ko\">기상</span> <span lang=\"ko\">선구</span> <span lang=\"ko\">・</span> <span lang=\"ko\">에필로그</span></td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji FR Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji FR Flag.png\" data-image-key=\"Emoji_FR_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/c/c6/Emoji_FR_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221935\" /></span></span></span>&#160;&#160;French</b></td><td>Station météo Solaris&#160;: Épilogue</td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji DE Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji DE Flag.png\" data-image-key=\"Emoji_DE_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/3/3b/Emoji_DE_Flag.png/revision/late