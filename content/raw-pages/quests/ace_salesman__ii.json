{
  "title": "Ace Salesman: II",
  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><div class=\"mbox stub\" style=\"border-left-width:8px;margin-bottom:5px;border-left-color:#d6d6d6;position:relative;display:flex;border-radius:3px;border:1px solid #d6d6d6;min-height:32px\"><div class=\"mbox&#95;&#95;content\" style=\"display:table;padding:8px 15px;width:100%;box-sizing:border-box\"><div class=\"mbox&#95;&#95;content&#95;&#95;image mw-collapsible\" id=\"mw-customcollapsible-mbox\" style=\"text-align:center;padding-right:15px;display:table-cell;height:100%;vertical-align:middle;width:40px\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/wutheringwaves/images/e/e8/Baizhi_Sticker_Slice_of_Life_01_08.png/revision/latest?cb=20240703174053\" class=\"mw-file-description image\"><img alt=\"Baizhi Sticker Slice of Life 01 08\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/e/e8/Baizhi_Sticker_Slice_of_Life_01_08.png/revision/latest/scale-to-width-down/65?cb=20240703174053\" decoding=\"async\" loading=\"lazy\" width=\"65\" height=\"65\" class=\"mw-file-element\" data-image-name=\"Baizhi Sticker Slice of Life 01 08.png\" data-image-key=\"Baizhi_Sticker_Slice_of_Life_01_08.png\" data-relevant=\"1\" /></a></span></div><div class=\"mbox&#95;&#95;content&#95;&#95;wrapper\" style=\"display:table-cell;vertical-align:middle\"><div class=\"mbox&#95;&#95;content&#95;&#95;header\" style=\"display:block;font-weight:bold\">This <a href=\"/wiki/Category:Article_Stubs\" title=\"Category:Article Stubs\">page</a> is in need of information.</div><div class=\"mbox&#95;&#95;content&#95;&#95;text mw-collapsible\" id=\"mw-customcollapsible-mbox\" style=\"display:block\">Can you help out? <a target=\"_blank\" rel=\"noreferrer noopener\" class=\"text\" href=\"https://wutheringwaves.fandom.com/wiki/Ace_Salesman:_II?action=edit\">Click here to add more.</a><div class=\"mbox&#95;&#95;content&#95;&#95;text&#95;&#95;comment\" style=\"font-size:small\">images</div></div><span class=\"mbox&#95;&#95;close mw-customtoggle-mbox\" title=\"Dismiss\" style=\"color:#bbb;right:0;cursor:pointer;font-size:16px;top:0;transition:all .15s ease-in;position:absolute;padding:2px 7px;font-weight:bold\"></span></div></div></div><p class=\"mw-empty-elt\">\n</p><aside role=\"region\" class=\"portable-infobox pi-background pi-border-color pi-theme-wikia pi-layout-stacked\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"title\">Ace Salesman: II</h2>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"type\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Quest Type</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Daily_Quests\" class=\"mw-redirect\" title=\"Daily Quests\">Daily</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"startLocation\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Starting Location</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Hongzhen\" title=\"Hongzhen\">Hongzhen</a>,&#32;<a href=\"/wiki/Mt._Firmament\" title=\"Mt. Firmament\">Mt. Firmament</a>,&#32;<a href=\"/wiki/Huanglong\" title=\"Huanglong\">Huanglong</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"description\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Description</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Yongxin's first attempt ended tragically. Will a miracle arise on his second try?</div>\n</div>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<table class=\"pi-horizontal-group\">\n\t\n\t\n\t<thead>\n\t\t<tr>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"prev\">Previous Quest</th>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"next\">Next Quest</th>\n\t\t\n\t\t</tr>\n\t</thead>\n\t\n\t<tbody>\n\t<tr>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"prev\"><a href=\"/wiki/Ace_Salesman:_I\" title=\"Ace Salesman: I\">Ace Salesman: I</a></td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"next\"><a href=\"/wiki/Ace_Salesman:_III\" title=\"Ace Salesman: III\">Ace Salesman: III</a></td>\n\t\n\t</tr>\n\t</tbody>\n</table>\n\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n\t\n\t<section class=\"pi-item pi-panel pi-border-color wds-tabber\">\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tabs__wrapper\">\n\t\t\t\t<ul class=\"wds-tabs\">\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab wds-is-current\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tRewards\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tCharacters\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tab__content wds-is-current\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"rewards\">\n\t\n\t<div class=\"pi-data-value pi-font\"><span class=\"card-list-container\"><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-4\"><span typeof=\"mw:File\"><a href=\"/wiki/Intimacy\" title=\"Intimacy\"><img alt=\"Intimacy\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Intimacy.png\" data-image-key=\"Item_Intimacy.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/4/45/Item_Intimacy.png/revision/latest/scale-to-width-down/74?cb=20240528230213\" /></a></span></span><span class=\"card-text card-font\"> 480</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-3\"><span typeof=\"mw:File\"><a href=\"/wiki/Shell_Credit\" title=\"Shell Credit\"><img alt=\"Shell Credit\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Shell Credit.png\" data-image-key=\"Item_Shell_Credit.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d1/Item_Shell_Credit.png/revision/latest/scale-to-width-down/74?cb=20240523132525\" /></a></span></span><span class=\"card-text card-font\"> 3,000</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-2\"><span typeof=\"mw:File\"><a href=\"/wiki/Basic_Resonance_Potion\" title=\"Basic Resonance Potion\"><img alt=\"Basic Resonance Potion\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Basic Resonance Potion.png\" data-image-key=\"Item_Basic_Resonance_Potion.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/6/60/Item_Basic_Resonance_Potion.png/revision/latest/scale-to-width-down/74?cb=20240528230303\" /></a></span></span><span class=\"card-text card-font\"> 1</span></span></div></span></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t\t\t<div class=\"wds-tab__content\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"characters\">\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Xinyang\" title=\"Xinyang\">Xinyang</a>, <a href=\"/wiki/Yongxin\" title=\"Yongxin\">Yongxin</a>, <a href=\"/wiki/Zhonglin\" title=\"Zhonglin\">Zhonglin</a></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t</section>\n\n\n\n\n</section>\n</aside>\n<b>Ace Salesman: II</b> is a <a href=\"/wiki/Daily_Quest\" title=\"Daily Quest\">Daily Quest</a> that occurs in <a href=\"/wiki/Mt._Firmament\" title=\"Mt. Firmament\">Mt. Firmament</a>, <a href=\"/wiki/Huanglong\" title=\"Huanglong\">Huanglong</a>, [[{{{nation}}}]].\n<p class=\"mw-empty-elt\"></p><div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Steps\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Steps</span></a></li>\n<li class=\"toclevel-1 tocsection-2\"><a href=\"#Dialogue\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">Dialogue</span></a></li>\n<li class=\"toclevel-1 tocsection-3\"><a href=\"#Other_Languages\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">Other Languages</span></a></li>\n<li class=\"toclevel-1 tocsection-4\"><a href=\"#Change_History\"><span class=\"tocnumber\">4</span> <span class=\"toctext\">Change History</span></a></li>\n<li class=\"toclevel-1 tocsection-5\"><a href=\"#Navigation\"><span class=\"tocnumber\">5</span> <span class=\"toctext\">Navigation</span></a></li>\n</ul>\n</div>\n\n<h2><span class=\"mw-headline\" id=\"Steps\">Steps</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ol><li>Head to Spring's Taste</li>\n<li>Obtain herbs from Tongchuan Pharmacy</li>\n<li>Hand the herbs to Xinyang</li></ol>\n<h2><span class=\"mw-headline\" id=\"Dialogue\">Dialogue</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<dd><div class=\"description-wrapper\"><div class=\"description-title\"><b><span typeof=\"mw:File\"><span><img alt=\"UI Quest\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0f/UI_Quest.png/revision/latest/scale-to-width-down/20?cb=20260501180345\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element\" data-image-name=\"UI Quest.png\" data-image-key=\"UI_Quest.png\" data-relevant=\"0\" /></span></span> Quest Description</b></div><hr class=\"description-separator\" /><div class=\"description-content\">Yongxin's first attempt ended tragically. Will a miracle arise on his second try?</div></div></dd><div class=\"dialogue\">\n<dl><dt>(Head to Spring's Taste)</dt>\n<dd><b>Yongxin:</b> There you are, Rover</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" /></span></span> Your face is glowing red.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> And that's a lot of sweat</dd>\n<dd><b>Yongxin:</b> It... it's too hot here for sure. That's hot springs for you. Even the air feels hot...</dd>\n<dd><b>Yongxin:</b> Hello... I am...</dd>\n<dd><b>Xinyang:</b> Here you are, finally. Tongchuan Pharmacy sent you, right? Do you have any idea how busy I am today, and you just got here? Where's my shipment?</dd>\n<dd><b>Yongxin:</b> Shipment...?</dd>\n<dd><b>Xinyang:</b> The medicine I ordered for spa therapy. Wait, why are you empty-handed?</dd>\n<dd><b>Xinyang:</b> And Rover... when did you start working for Tongchuan Pharmacy?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> We're here to make sales.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> You got us mixed up with someone else.</dd>\n<dd>Yongxin quickly explains his intent.</dd>\n<dd><b>Xinyang:</b> Oops, my mistake. He didn't look familiar to me so I thought he was from Tongchuan Pharmacy.</dd>\n<dd><b>Xinyang:</b> But I don't have time for that right now. As you can see, I'm swamped here... And the fact that the medicine from Tongchuan Pharmacy still hasn't arrived yet makes it even worse.</dd>\n<dd><b>Xinyang:</b> Oh, right! Can you check on the delivery for me, Rover? If I don't have the spa ready soon, I'll get complaints.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> No problem.</dd>\n<dd><b>Xinyang:</b> Yes! I knew I could count on you!</dd>\n<dt>(Obtain herbs from Tongchuan Pharmacy)</dt>\n<dd><b>Zhonglin:</b> You're a rare sight, Rover.</dd>\n<dd><b>Zhonglin:</b> Here for some herbs? I just got a fine batch in from Jinzhou. They work wonders for both internal and external use.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> I'm here for the herbs for Spring's Taste.</dd>\n<dd><b>Zhonglin:</b> Oh my, can't believe that slipped my mind.</dd>\n<dd><b>Zhonglin:</b> I was going to send someone over this morning, but the guy called in sick. Xinyang must be getting impatient by now...</dd>\n<dd><b>Zhonglin:</b> Let me see... Yeah, should be these. Thanks for delivering them, Rover.</dd>\n<dt>(Hand the herbs to Xinyang)</dt>\n<dd><b>Xinyang:</b> You're back, Rover?</dd>\n<dd><b>Xinyang:</b> Yes, this is it. I spent a lot of money on this new recipe. Now, all I have to do is put it in the hot spring.</dd>\n<dd><b>Xinyang:</b> Dip in the hot spring just for fun, twice to dodge the flu and run, thrice for muscles feeling fine, four times to make sickness decline!</dd>\n<dd><b>Xinyang:</b> Oh, the fellow over there... What did you want to see me for again?</dd>\n<dd><b>Yongxin:</b> Excuse me, but... do you need stones for your hot spring?</dd>\n<dd><b>Xinyang:</b> Stones? You mean for renovating the pool? No, because we're in peak season so it will cost me a lot of money to renovate now.</dd>\n<dd><b>Xinyang:</b> How about rockery, got any of that?</dd>\n<dd><b>Yongxin:</b> Yes, yes! We... do...</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Tell me about your best product.</dd>\n<dd><b>Yongxin:</b> ...Well, our rockery comes in a variety of styles, such as the Jinzhou border style, the Mengzhou garden style, and the newest luxury style from <a href=\"/wiki/Mingting\" title=\"Mingting\">Huanglong capital</a>. We also offer customization based on your own design, dear customer!</dd>\n<dd><b>Yongxin:</b> Dear customer, you can order now for free shipping to Hongzhen, plus a three-year warranty! If you have any questions or need more information, please leave a message and I will...</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Ahem. You can stop right there.</dd>\n<dd><b>Xinyang:</b> ...Is this how people from Jinzhou sell stuff nowadays? Sounds a bit weird... but it's actually kind of appealing?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> The best bang for your buck, dear customer.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Your hot spring deserves the enticing look, dear customer.\n<dl><dd><b>Xinyang:</b> Hm... Indeed, I do think the spring is missing something, so if I added this...</dd></dl></dd>\n<dd><b>Yongxin:</b> Phew, I guess that's one deal closed. Now I can face the boss.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> You seem to be under a lot of stress.</dd>\n<dd><b>Yongxin:</b> Well, my boss was never optimistic about Honghzhen, or he would've never sent a low-man-on-the-totem-pole like me here.</dd>\n<dd><b>Yongxin:</b> But I did it... I've taken the first step, and that's because I have your encouragement and help...</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> So, what's up with the \"dear customer\" thing?</dd>\n<dd><b>Yongxin:</b> Didn't you want me to say what I say best? That's all I know...</dd>\n<dd><b>Yongxin:</b> I still came off a little nervous, but much better than before.</dd>\n<dd><b>Yongxin:</b> Then I'll have to keep working at it. Thank you, Rover.</dd>\n<dt>(Quest Complete)</dt></dl>\n</div>\n<h2><span class=\"mw-headline\" id=\"Other_Languages\">Other Languages</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<table class=\"article-table alternating-colors-table\"><tbody><tr><th>Language</th><th>Official Name</th></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji EN Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji EN Flag.png\" data-image-key=\"Emoji_EN_Flag.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/f/f5/Emoji_EN_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221541\" /></span></span></span>&#160;&#160;English</b></td><td>Ace Salesman: II</td></tr><tr><td style=\"line-height:1em\"><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ZHS Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ZHS Flag.png\" data-image-key=\"Emoji_ZHS_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/5/5f/Emoji_ZHS_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221618\" /></span></span></span>&#160;&#160;Chinese <abbr title=\"Simplified\"><small>(S)</small></abbr></b></td><td><span lang=\"zh-Hans\">金牌推销员・二</span></td></tr><tr><td style=\"line-height:1em\"><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ZHT Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ZHT Flag.png\" data-image-key=\"Emoji_ZHT_Flag.png\" data-relev