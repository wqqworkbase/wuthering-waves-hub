{
  "title": "When Moonlight Shines in the Forest",
  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><p class=\"mw-empty-elt\">\n</p><aside role=\"region\" class=\"portable-infobox pi-background pi-border-color pi-theme-wikia pi-layout-stacked\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"title\">When Moonlight Shines in the Forest</h2>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"type\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Quest Type</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Side_Quests\" class=\"mw-redirect\" title=\"Side Quests\">Side</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"requirement\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Requirements</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Complete <a href=\"/wiki/When_the_Forest_is_No_Longer_Dim\" title=\"When the Forest is No Longer Dim\">When the Forest is No Longer Dim</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"startLocation\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Starting Location</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Violet_Banyan\" title=\"Violet Banyan\">Violet Banyan</a>,&#32;<a href=\"/wiki/Dim_Forest\" title=\"Dim Forest\">Dim Forest</a>,&#32;<a href=\"/wiki/Huanglong\" title=\"Huanglong\">Huanglong</a></div>\n</div>\n<section class=\"pi-item pi-group pi-border-color\">\n\t\n\t<section class=\"pi-item pi-panel pi-border-color wds-tabber\">\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tabs__wrapper\">\n\t\t\t\t<ul class=\"wds-tabs\">\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab wds-is-current\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tRewards\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tCharacters\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tab__content wds-is-current\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"rewards\">\n\t\n\t<div class=\"pi-data-value pi-font\"><span class=\"card-list-container\"><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-5\"><span typeof=\"mw:File\"><a href=\"/wiki/Union_EXP\" title=\"Union EXP\"><img alt=\"Union EXP\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Union EXP.png\" data-image-key=\"Item_Union_EXP.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0b/Item_Union_EXP.png/revision/latest/scale-to-width-down/74?cb=20240525121935\" /></a></span></span><span class=\"card-text card-font\"> 500</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-5\"><span typeof=\"mw:File\"><a href=\"/wiki/Astrite\" title=\"Astrite\"><img alt=\"Astrite\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Astrite.png\" data-image-key=\"Item_Astrite.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/1/16/Item_Astrite.png/revision/latest/scale-to-width-down/74?cb=20240523021541\" /></a></span></span><span class=\"card-text card-font\"> 40</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-4\"><span typeof=\"mw:File\"><a href=\"/wiki/Advanced_Resonance_Potion\" title=\"Advanced Resonance Potion\"><img alt=\"Advanced Resonance Potion\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Advanced Resonance Potion.png\" data-image-key=\"Item_Advanced_Resonance_Potion.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/e/e2/Item_Advanced_Resonance_Potion.png/revision/latest/scale-to-width-down/74?cb=20240524152949\" /></a></span></span><span class=\"card-text card-font\"> 2</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-4\"><span typeof=\"mw:File\"><a href=\"/wiki/Advanced_Energy_Core\" title=\"Advanced Energy Core\"><img alt=\"Advanced Energy Core\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Advanced Energy Core.png\" data-image-key=\"Item_Advanced_Energy_Core.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/b/b5/Item_Advanced_Energy_Core.png/revision/latest/scale-to-width-down/74?cb=20240524153038\" /></a></span></span><span class=\"card-text card-font\"> 2</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-3\"><span typeof=\"mw:File\"><a href=\"/wiki/Shell_Credit\" title=\"Shell Credit\"><img alt=\"Shell Credit\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Shell Credit.png\" data-image-key=\"Item_Shell_Credit.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d1/Item_Shell_Credit.png/revision/latest/scale-to-width-down/74?cb=20240523132525\" /></a></span></span><span class=\"card-text card-font\"> 18,000</span></span></div></span></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t\t\t<div class=\"wds-tab__content\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"characters\">\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Qiaomu\" title=\"Qiaomu\">Qiaomu</a>, <a href=\"/wiki/Rover\" title=\"Rover\">Rover</a></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t</section>\n\n\n\n\n</section>\n</aside>\n<b>When Moonlight Shines in the Forest</b> is a <a href=\"/wiki/Side_Quest\" title=\"Side Quest\">Side Quest</a> that occurs in <a href=\"/wiki/Dim_Forest\" title=\"Dim Forest\">Dim Forest</a>, <a href=\"/wiki/Huanglong\" title=\"Huanglong\">Huanglong</a>, [[{{{nation}}}]].\n<p class=\"mw-empty-elt\"></p>\n<div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Steps\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Steps</span></a></li>\n<li class=\"toclevel-1 tocsection-2\"><a href=\"#Gameplay_Notes\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">Gameplay Notes</span></a></li>\n<li class=\"toclevel-1 tocsection-3\"><a href=\"#Dialogue\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">Dialogue</span></a></li>\n<li class=\"toclevel-1 tocsection-4\"><a href=\"#Video_Guides\"><span class=\"tocnumber\">4</span> <span class=\"toctext\">Video Guides</span></a></li>\n<li class=\"toclevel-1 tocsection-5\"><a href=\"#Other_Languages\"><span class=\"tocnumber\">5</span> <span class=\"toctext\">Other Languages</span></a></li>\n<li class=\"toclevel-1 tocsection-6\"><a href=\"#Change_History\"><span class=\"tocnumber\">6</span> <span class=\"toctext\">Change History</span></a></li>\n<li class=\"toclevel-1 tocsection-7\"><a href=\"#Navigation\"><span class=\"tocnumber\">7</span> <span class=\"toctext\">Navigation</span></a></li>\n</ul>\n</div>\n\n<h2><span class=\"mw-headline\" id=\"Steps\">Steps</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ol><li>Talk to Qiaomu</li>\n<li>Search for the artificial moons\n<ul><li>Tree Stump in the Eastern Forest</li>\n<li>Cave behind the Waterfall</li>\n<li>Moon-shaped pool next to Violet Banyan</li>\n<li>Cave by the Seaside</li></ul></li>\n<li>Talk to Qiaomu</li></ol>\n<h2><span class=\"mw-headline\" id=\"Gameplay_Notes\">Gameplay Notes</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ul><li>Completing this quest awards the <i><a href=\"/wiki/Huanglong_I\" class=\"mw-redirect\" title=\"Huanglong I\">Huanglong I</a></i> trophy <i><a href=\"/wiki/When_the_Forest_is_No_Longer_Dark\" title=\"When the Forest is No Longer Dark\">When the Forest is No Longer Dark</a></i>.</li></ul>\n<h2><span class=\"mw-headline\" id=\"Dialogue\">Dialogue</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<dd><div class=\"description-wrapper\"><div class=\"description-title\"><b><span typeof=\"mw:File\"><span><img alt=\"UI Quest\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0f/UI_Quest.png/revision/latest/scale-to-width-down/20?cb=20260501180345\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element\" data-image-name=\"UI Quest.png\" data-image-key=\"UI_Quest.png\" data-relevant=\"0\" /></span></span> Quest Description</b></div><hr class=\"description-separator\" /><div class=\"description-content\">Following the events of the Dim Forest, Qiaomu and Hoohoo decided to stay around the Violet Banyan. They seem particularly interested in the moons of the Violet Banyan.</div></div></dd>\n<div class=\"dialogue\">\n<dl><dd><b>Qiaomu:</b> Hey, Rover, nice to see you again!</dd>\n<dd><b>Qiaomu:</b> Thanks to you, we solved the issue in the Dim Forest last time! Hoohoo, say hi to Rover!</dd>\n<dd><b>Hoohoo:</b> *A happy hoohoo*</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" /></span></span> Hello.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" /></span></span> Hoohoo.</dd>\n<dd><b>Qiaomu:</b> It's been a while since we last met!</dd>\n<dd><b>Qiaomu:</b> By the way, ever thought about joining us for some moon-watching?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Moon-watching?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> In the Dim Forest?</dd>\n<dd><b>Qiaomu:</b> Yep! But not the real moon. We're gonna go look for the artificial ones!</dd>\n<dd><b>Qiaomu:</b> Look! There's a moon hanging there, like a small lamp.</dd>\n<dd><b>Qiaomu:</b> It's been hanging above the Violet Banyan for a long, long time.</dd>\n<dd><b>Qiaomu:</b> No clue who put it there, but it brightens up the place and lifts our spirits.</dd>\n<dd><b>Qiaomu:</b> Hoohoo and I are both interested in this moon, so we've been investigating it for a while.</dd>\n<dd><b>Hoohoo:</b> *A happy hoohoo*!</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> What have you found?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Sounds like you've made some discoveries.</dd>\n<dd><b>Qiaomu:</b> We found a booklet on the moon.</dd>\n<dd><b>Qiaomu:</b> Check it out. It's a bit worn, but the content is still clear to read.</dd>\n<dd><b>Qiaomu:</b> It's got a nursery rhyme about the moon. Quite intriguing. Take a look.</dd>\n<dt>(Obtain <span class=\"new\" title=\"Old Booklet (page does not exist)\" data-uncrawlable-url=\"L3dpa2kvT2xkX0Jvb2tsZXQ/YWN0aW9uPWVkaXQmcmVkbGluaz0x\">Old Booklet</span>, automatically opens)</dt></dl>\n<hr />\n<dl><dd><big><b>Tattered Booklet</b></big><hr />We went beneath the banyan tree, where darkness shrouded Grandma and me.<br />Grandma led me with knowing grace, to hang the moons in their rightful place.<br />A glowing orb above the leaves, banishing shadows, making forest so bright.<br />Moon O moon, where do you hide? <span class=\"text-help\">Behind a waterfall's cascading slide?</span><br />With gentle hands she'd guide my head, as we gathered moons before bed.<br />Moon O moon, where do you roam? <span class=\"text-help\">At the moon pool's alluring home?</span><br />Moon in hand I came back and read, by her side she taught me to heed.<br />Moon O moon, where do you rest? <span class=\"text-help\">Perched upon a tree stump's crest?</span><br />Naughty Hoochiefs watched in glee, trying to catch the moons so free.<br />Moon O moon, where do you play? <span class=\"text-help\">In a cave where dry branches sway?</span><br />All moons gathered but she was gone, leaving me an everlasting dawn.<br />I gazed at golden moons so bright, and left for the city that very night.</dd></dl>\n<hr />\n<dl><dt>(Talk to Qiaomu)</dt>\n<dd><b>Qiaomu:</b> What do you think? Anything caught your eye?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> It mentioned many places.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> It told a story.</dd>\n<dd><b>Qiaomu:</b> Yes, it's about a kid and their Grandma, traveling to find some moons to brighten up the forest.</dd>\n<dd><b>Qiaomu:</b> There's a good chance other artificial moons are still hiding in these locations. You see: <span class=\"text-help\">waterfall, moon pool, tree stump, and cave</span>...</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> I know.\n<dl><dd><b>Qiaomu:</b> Same here! I've marked all potential hiding spots on the map app. Can you go check them out?</dd></dl></dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> None of those rings any bells.\n<dl><dd><b>Qiaomu:</b> It's okay! I've marked potential hiding spots on the map. Can you go check them out?</dd></dl></dd>\n<dd><b>Qiaomu:</b> Once you spot a moon, let me know! Hoohoo and I will bring it back to this place. Let's come back here once we're doen checking all of the places.</dd>\n<dd><b>Hoohoo:</b> *A very happy hoohoo*</dd></dl>\n<hr />\n<dl><dt>(Moon-shaped pool next to Violet Banyan)</dt>\n<dd><b>Rover:</b> The moon pool... It should be a crescent-shaped pool nearby...\n<dl><dt>(Interact with the artifial moon)</dt>\n<dd><b>Rover:</b> It feels heavy to pull up. Not sure if it still works...</dd></dl></dd></dl>\n<dl><dd><b>Qiaomu and Hoohoo took the artificial moon you found back to the Violet Banyan.</b></dd></dl>\n<dl><dt>(Cave behind the Waterfall)</dt>\n<dd><b>Rover:</b> The waterfall from the nursery rhyme should be this one... I should go look behind it.\n<dl><dt>(Interact with the artifial moon)</dt>\n<dd><b>Rover:</b> Something seems carved on it... \"moon... tree... happiness..\"</dd></dl></dd></dl>\n<dl><dd><b>Qiaomu and Hoohoo took the artificial moon you found back to the Violet Banyan.</b></dd></dl>\n<dl><dt>(Cave by the Seaside)</dt>\n<dd><b>Rover:</b> A cave with dry branches... It should be here.\n<dl><dt>(Interact with the artifial moon)</dt>\n<dd><b>Rover:</b> This moon seems a bit rusty. Hopefully, it can still be lit up...</dd></dl></dd></dl>\n<dl><dd><b>Qiaomu and Hoohoo took the artificial moon you found back to the Violet Banyan.</b></dd></dl>\n<dl><dt>(Tree Stump in the Eastern Forest)</dt>\n<dd><b>Rover:</b> Then the tree stump... It should be somewhere around.\n<dl><dt>(Interact with the artifial moon)</dt>\n<dd><b>Rover:</b> A hand-carved moon full of bumps and hollows, with \"Mey all go well with you\" written on it...</dd></dl></dd></dl>\n<hr />\n<dl><dt>(Talk to Qiaomu)</dt>\n<dd><b>Qiaomu:</b> Rover, you're back! You found all of the moons!</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> It took some effort.</dd>\n<dd><b>Hoohoo:</b> *An admiring hoohoo*!</dd>\n<dd><b>Qiaomu:</b> Fantastic! No wonder they all admire you!</dd>\n<dd><b>Qiaomu:</b> Let me see. There seem to be words on these moons...</dd>\n<dd><b>Qiaomu:</b> Moon... on the tree... gives happiness... Mey all go well you... I think this person meant \"May all go well with you.\"</dd>\n<dd><b>Qiaomu:</b> Looks like a child's work. The handwriting looks a bit crooked, and it's mostly phrases of good wishes and greetings.</dd>\n<dd><b>Qiaomu:</b> I wonder who carved them... Anyway, let's hang these up!</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Let's go.</dd></dl>\n<hr />\n<dl><dd><b>Hoohoo:</b> *A very happy hoohoo*</dd>\n<dd><b>Qiaomu:</b> Rover, look! So beautiful! The entire Violet Banyan is illuminated!</dd>\n<dd><b>Qiaomu:</b> But why the artificial moons... Judging by the story in that nursery rhyme and the words on the moons, someone must have lived here long ago!</dd>\n<dd><b>Qiaomu:</b> I've read about a type of creature called \"<a href=\"/wiki/Suan%27ni\" title=\"Suan&#39;ni\">Suan'ni</a>\" that once lived this place. But unfortunately, they're nowhere to be found now.</dd>\n<dd><b>Qiaomu:</b> Theoretically, they don't speak human languages. With the limited info we have, who knows if it's true?</dd>\n<dd><b>Qiaomu:</b> Perhaps those Suan'nis hung these moons.</dd>\n<dd><b>Qiaomu:</b> Having lived in this dark place for so long, they may have yearned for light, even if it's just artificial moonlight.</dd>\n<dd><b>Qiaomu:</b> Anyway, this is just a guess. There are still many mysteries in the Dim Forest waiting for us to unveil.</dd>\n<dd><b>Hoohoo:</b> *A curious Hoohoo*</dd>\n<dd><b>Qiaomu:</b> Hoohoo's curious too! We'll keep exploring and see if we find more clues.</dd>\n<dd><b>Qiaomu:</b> Thank you so much for helping us, Rover! Hope to see you again soon!</dd>\n<dt>(Quest Complete)</dt></dl>\n</div>\n<h2><span class=\"mw-headline\" id=\"Video_Guides\">Video Guides</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<div class=\"thumb embedvideo autoResize\" style=\"width: 408px;\">\n\t\t\t<div class=\"embedvideo autoResize\" style=\"\">\n\t\t\t\t<div class=\"embedvideowrap\" style=\"width: 400px;\">\n<p>\t\t\t\t\t<iframe title=\"Play video\" src=\"//www.youtube.com/embed/8_4Ay5EXcqc?\" width=\"400\" height=\"225\" style=\"border: none;\" allowfullscreen=\"true\" loading=\"lazy\"></iframe>\n</p>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"thumbcaption\">Guide: When Moonlight Shines in the Forest</div>\n\t\t\t</div>\n\t\t</div>\n<h2><span class=\"mw-headline\" id=\"Other_Languages\">Other Languages</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<table class=\"article-table alternating-colors-table\"><tbody><tr><th>Language</th><th>Official Name</th></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji EN Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji EN Flag.png\" data-image-key=\"Emoji_EN_Flag.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/f/f5/Emoji_EN_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221541\" /></span></span></span>&#160;&#160;English</b></td><td>When Moonlight Shines in the Forest</td></tr><tr><td style=\"line-height:1em\"><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ZHS Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ZHS Flag.png\" data-image-key=\"Emoji_ZHS_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.noco