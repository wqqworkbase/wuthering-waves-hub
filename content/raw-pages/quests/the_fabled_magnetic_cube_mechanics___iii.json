nion_EXP.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0b/Item_Union_EXP.png/revision/latest/scale-to-width-down/74?cb=20240525121935\" /></a></span></span><span class=\"card-text card-font\"> 200</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-5\"><span typeof=\"mw:File\"><a href=\"/wiki/Astrite\" title=\"Astrite\"><img alt=\"Astrite\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Astrite.png\" data-image-key=\"Item_Astrite.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/1/16/Item_Astrite.png/revision/latest/scale-to-width-down/74?cb=20240523021541\" /></a></span></span><span class=\"card-text card-font\"> 15</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-3\"><span typeof=\"mw:File\"><a href=\"/wiki/Medium_Resonance_Potion\" title=\"Medium Resonance Potion\"><img alt=\"Medium Resonance Potion\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Medium Resonance Potion.png\" data-image-key=\"Item_Medium_Resonance_Potion.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d2/Item_Medium_Resonance_Potion.png/revision/latest/scale-to-width-down/74?cb=20240524152915\" /></a></span></span><span class=\"card-text card-font\"> 2</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-3\"><span typeof=\"mw:File\"><a href=\"/wiki/Medium_Energy_Core\" title=\"Medium Energy Core\"><img alt=\"Medium Energy Core\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Medium Energy Core.png\" data-image-key=\"Item_Medium_Energy_Core.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/1/18/Item_Medium_Energy_Core.png/revision/latest/scale-to-width-down/74?cb=20240524153056\" /></a></span></span><span class=\"card-text card-font\"> 2</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-3\"><span typeof=\"mw:File\"><a href=\"/wiki/Shell_Credit\" title=\"Shell Credit\"><img alt=\"Shell Credit\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Shell Credit.png\" data-image-key=\"Item_Shell_Credit.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d1/Item_Shell_Credit.png/revision/latest/scale-to-width-down/74?cb=20240523132525\" /></a></span></span><span class=\"card-text card-font\"> 8,000</span></span></div></span></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t\t\t<div class=\"wds-tab__content\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"characters\">\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Rover\" title=\"Rover\">Rover</a></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t</section>\n\n\n\n\n</section>\n</aside>\n\n<p class=\"mw-empty-elt\"></p>\n<div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Steps\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Steps</span></a></li>\n<li class=\"toclevel-1 tocsection-2\"><a href=\"#Gameplay_Notes\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">Gameplay Notes</span></a></li>\n<li class=\"toclevel-1 tocsection-3\"><a href=\"#Dialogue\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">Dialogue</span></a></li>\n<li class=\"toclevel-1 tocsection-4\"><a href=\"#Video_Guides\"><span class=\"tocnumber\">4</span> <span class=\"toctext\">Video Guides</span></a></li>\n<li class=\"toclevel-1 tocsection-5\"><a href=\"#Other_Languages\"><span class=\"tocnumber\">5</span> <span class=\"toctext\">Other Languages</span></a></li>\n<li class=\"toclevel-1 tocsection-6\"><a href=\"#Change_History\"><span class=\"tocnumber\">6</span> <span class=\"toctext\">Change History</span></a></li>\n<li class=\"toclevel-1 tocsection-7\"><a href=\"#Navigation\"><span class=\"tocnumber\">7</span> <span class=\"toctext\">Navigation</span></a></li>\n</ul>\n</div>\n\n<h2><span class=\"mw-headline\" id=\"Steps\">Steps</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ol><li>Wait for Mi'zhi to wake up.</li>\n<li>Head to the Mechanics maintenance area at the mine</li>\n<li>Talk to Mi'zhi</li>\n<li>Help Mi'zhi calibrate the Mechanics</li>\n<li>Report to Mi'zhi</li>\n<li>Help Mi'zhi calibrate the Mechanics</li>\n<li>Report to Mi'zhi</li>\n<li>Help Mi'zhi calibrate the Mechanics</li>\n<li>Report to Mi'zhi</li>\n<li>Find the chest</li></ol>\n<h2><span class=\"mw-headline\" id=\"Gameplay_Notes\">Gameplay Notes</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ul><li>This quest unlocks 24 hours after finishing <a href=\"/wiki/The_Fabled_Magnetic_Cube_Mechanics_-_II\" title=\"The Fabled Magnetic Cube Mechanics - II\">The Fabled Magnetic Cube Mechanics - II</a>, displaying \"Wait for Mi'zhi to wake up.\" before being unlocked.</li>\n<li>Completing the quest will grant the <i><a href=\"/wiki/Huanglong_I\" class=\"mw-redirect\" title=\"Huanglong I\">Huanglong I</a></i> trophy <i><a href=\"/wiki/Your_Mystery,_I%27ll_Answer\" title=\"Your Mystery, I&#39;ll Answer\">Your Mystery, I'll Answer</a></i>.</li></ul>\n<h2><span class=\"mw-headline\" id=\"Dialogue\">Dialogue</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<dd><div class=\"description-wrapper\"><div class=\"description-title\"><b><span typeof=\"mw:File\"><span><img alt=\"UI Quest\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"UI Quest.png\" data-image-key=\"UI_Quest.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0f/UI_Quest.png/revision/latest/scale-to-width-down/20?cb=20260501180345\" /></span></span> Quest Description</b></div><hr class=\"description-separator\" /><div class=\"description-content\">Mi'zhi has come to his senses. What exactly did he encounter in the abandoned mine, and did he manage to find the ultimate Mechanics he has been pursuing?</div></div></dd>\n<div class=\"dialogue\">\n<dl><dd><b>Qingshu:</b> Player, Mi'zhi is awake now, and he's looking for you.</dd>\n<dd><b>Mi'zhi:</b> Player!</dd>\n<dd><b>Mi'zhi:</b> I don't know how I could repay you. You solved the puzzles with ID recorded for me, and you saved me from the pit...</dd>\n<dd><b>Mi'zhi:</b> ... And most importantly, you helped me find the ultimate Automatic Mechanics!</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Me?</dd>\n<dd><b>Mi'zhi:</b> Yes, you! Don't look around, it's just you.</dd>\n<dd><b>Mi'zhi:</b> I went down the pit for the ultimate Magnetic Cube Mechanics, but I was just almost frozen to death.</dd>\n<dd><b>Mi'zhi:</b> The moment I entered it, the freezing air overwhelmed me, and a voice kept saying in my head that the ultimate Magnetic Cube Mechanics was just hidden in the cold and that I should touch the air.</dd>\n<dd><b>Mi'zhi:</b> And as soon as I touched the air, yowls started to crowd in mind... They sounded just like the hopeless wails human would make before dying.</dd>\n<dd><b>Mi'zhi:</b> I saw those engineers before me in a trance... They were struggling desperately... and finally consumed by the cold.</dd>\n<dd><b>Mi'zhi:</b> Looking back now, the voice calling me was maybe just a bait. Sigh... there wasn't any \"ultimate Magnetic Cube Mechanics\" down there.</dd>\n<dd><b>Mi'zhi:</b> But when I was there and caught up in the moment, I found my retreat blocked. The Ice Chrysalises swarmed the exit.</dd>\n<dd><b>Mi'zhi:</b> And when I lost conscious due to the frost, it was you, Player, that crossed my mind.</dd>\n<dd><b>Qingshu:</b> I read that the near-death experience could stimulate human's most instinctive desire.</dd>\n<dd><b>Mi'zhi:</b> Cough. I've been desiring the ultimate Magnetic Cube Mechanics all the time... ... But when I think of it now, it is just by my side!</dd>\n<dd><b>Mi'zhi:</b> It's you, Player! Whenever I think of your marvellous techniques, inspirations about Magnetic Cube Mechanics will spring out in my head.</dd>\n<dd><b>Mi'zhi:</b> May I see that techniques again?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Now?</dd>\n<dd><b>Mi'zhi:</b> Yes, now. I can't keep lying whenever I think of those techniques.</dd>\n<dd><b>Qingshu:</b> Don't take this amiss, Player. He's just the kind of person who couldn't even lie down and rest when there's something about Magnetic Cube Mechanics.</dd>\n<dd><b>Mi'zhi:</b> Yes. I just thought of a few new mechanic combinations when I was resting. They are meant for you.</dd>\n<dd><b>Mi'zhi:</b> Only your puzzle-solving brings me the most inspirations.</dd></dl>\n<hr />\n<dl><dd><b>Mi'zhi:</b> Well done. Seems like you can use some more...</dd></dl>\n<hr />\n<dl><dd><b>Mi'zhi:</b> The way you solved it... It amazed me still though I've watched this before.</dd>\n<dd><b>Mi'zhi:</b> Oh... more inspiration...</dd></dl>\n<hr />\n<dl><dd><b>Mi'zhi:</b> Perfect, so perfect...</dd>\n<dd><b>Mi'zhi:</b> The timing, the steps. You made that exact and fitted. A textbook solving.</dd>\n<dd><b>Mi'zhi:</b> Right, why don't we just write that into a textbook? My Magnetic Cube Mechanics and your techniques.</dd>\n<dd><b>Mi'zhi:</b> Only now Magnetic Cube Mechanics reached the ultimate.</dd>\n<dd><b>Mi'zhi:</b> Only the Magnetic Cube Mechanics developed step by step by myself is so fulfilling.</dd></dl>\n<hr />\n<dl><dd><b>Mi'zhi:</b> It's all thanks to you that I could have reached the ultimate Magnetic Cube Mechanics.</dd>\n<dd><b>Mi'zhi:</b> When that was discovered, all my pain was gone and all my worries fade away. I was so relieved it felt like I'm no longe sick. Thank you so much!</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> You should thank Qingshu.</dd>\n<dd><b>Mi'zhi:</b> Oh yes, I should thank Qingshu. If it weren't her who was always updating the puzzles and trying to stop me from entering the pit, I wouldn't have studied it so hard and progressed so dramatically.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> She's worried about you.\n<dl><dd><b>Mi'zhi:</b> Yes, you're right.</dd></dl></dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Can't you see other things than Magnetic Cube Mechanics?\n<dl><dd><b>Mi'zhi:</b> What, what should I see? Oh!</dd></dl></dd>\n<dd><b>Mi'zhi:</b> Yes... Got to thank Miss Qingshu.</dd>\n<dd><b>Mi'zhi:</b> I've been in my head too much and thinking about Magnetic Cube Mechanics. My messing around has caused Miss Qingshu and Player trouble.</dd>\n<dd><b>Mi'zhi:</b> Now that I have developed such great Magnetic Cube Mechanics, I should stay put and refrain from causing trouble.</dd>\n<dd><b>Mi'zhi:</b> I have saved some money privately, originally for the purpose of Magnetic Cube Mechanics studying, but now that Player has helped me find the ultimate Magnetic Cube Mechanics, you should have the money.</dd>\n<dd><b>Mi'zhi:</b> That's the treasure I talked about. I'll send you the coordinates. Don't forget to collect it.</dd>\n<dd><b>Mi'zhi:</b> And Miss Qingshu... What would you like? I don't know your favorites yet.</dd>\n<dd><b>Qingshu:</b> I don't need anything. Your health means more than anything.</dd>\n<dd><b>Mi'zhi:</b> ......</dd>\n<dd><b>Mi'zhi:</b> Then, I'll make up for it when we work together later.</dd></dl>\n</div>\n<h2><span class=\"mw-headline\" id=\"Video_Guides\">Video Guides</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<div class=\"thumb embedvideo autoResize\" style=\"width: 408px;\">\n\t\t\t<div class=\"embedvideo autoResize\" style=\"\">\n\t\t\t\t<div class=\"embedvideowrap\" style=\"width: 400px;\">\n<p>\t\t\t\t\t<iframe title=\"Play video\" src=\"//www.youtube.com/embed/5q57ERkZOl0?\" width=\"400\" height=\"225\" style=\"border: none;\" allowfullscreen=\"true\" loading=\"lazy\"></iframe>\n</p>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"thumbcaption\">Guide: The Fabled Magnetic Cube Mechanics</div>\n\t\t\t</div>\n\t\t</div>\n<h2><span class=\"mw-headline\" id=\"Other_Languages\">Other Languages</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<table class=\"article-table alternating-colors-table\"><tbody><tr><th>Language</th><th>Official Name</th></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji EN Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji EN Flag.png\" data-image-key=\"Emoji_EN_Flag.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/f/f5/Emoji_EN_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221541\" /></span></span></span>&#160;&#160;English</b></td><td>The Fabled Magnetic Cube Mechanics - III</td></tr><tr><td style=\"line-height:1em\"><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ZHS Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ZHS Flag.png\" data-image-key=\"Emoji_ZHS_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/5/5f/Emoji_ZHS_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221618\" /></span></span></span>&#160;&#160;Chinese <abbr title=\"Simplified\"><small>(S)</small></abbr></b></td><td><span lang=\"zh-Hans\">传说中的密方机关术・三</span></td></tr><tr><td style=\"line-height:1em\"><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ZHT Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAA