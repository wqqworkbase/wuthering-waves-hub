{
  "title": "Danger! Explosive!",
  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><p class=\"mw-empty-elt\">\n</p><aside role=\"region\" class=\"portable-infobox pi-background pi-border-color pi-theme-wikia pi-layout-stacked\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"title\">Danger! Explosive!</h2>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"type\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Quest Type</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Side_Quests\" class=\"mw-redirect\" title=\"Side Quests\">Side</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"startLocation\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Starting Location</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Dim_Forest\" title=\"Dim Forest\">Dim Forest</a></div>\n</div>\n<section class=\"pi-item pi-group pi-border-color\">\n\t\n\t<section class=\"pi-item pi-panel pi-border-color wds-tabber\">\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tabs__wrapper\">\n\t\t\t\t<ul class=\"wds-tabs\">\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab wds-is-current\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tRewards\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tCharacters\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tab__content wds-is-current\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"rewards\">\n\t\n\t<div class=\"pi-data-value pi-font\"><span class=\"card-list-container\"><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-5\"><span typeof=\"mw:File\"><a href=\"/wiki/Union_EXP\" title=\"Union EXP\"><img alt=\"Union EXP\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Union EXP.png\" data-image-key=\"Item_Union_EXP.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0b/Item_Union_EXP.png/revision/latest/scale-to-width-down/74?cb=20240525121935\" /></a></span></span><span class=\"card-text card-font\"> 100</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-5\"><span typeof=\"mw:File\"><a href=\"/wiki/Astrite\" title=\"Astrite\"><img alt=\"Astrite\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Astrite.png\" data-image-key=\"Item_Astrite.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/1/16/Item_Astrite.png/revision/latest/scale-to-width-down/74?cb=20240523021541\" /></a></span></span><span class=\"card-text card-font\"> 10</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-4\"><span typeof=\"mw:File\"><a href=\"/wiki/Advanced_Resonance_Potion\" title=\"Advanced Resonance Potion\"><img alt=\"Advanced Resonance Potion\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Advanced Resonance Potion.png\" data-image-key=\"Item_Advanced_Resonance_Potion.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/e/e2/Item_Advanced_Resonance_Potion.png/revision/latest/scale-to-width-down/74?cb=20240524152949\" /></a></span></span><span class=\"card-text card-font\"> 2</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-4\"><span typeof=\"mw:File\"><a href=\"/wiki/Advanced_Energy_Core\" title=\"Advanced Energy Core\"><img alt=\"Advanced Energy Core\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Advanced Energy Core.png\" data-image-key=\"Item_Advanced_Energy_Core.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/b/b5/Item_Advanced_Energy_Core.png/revision/latest/scale-to-width-down/74?cb=20240524153038\" /></a></span></span><span class=\"card-text card-font\"> 1</span></span></div><div class=\"card-container\"><span class=\"card-body\"><span class=\"card-image-container card-rarity-3\"><span typeof=\"mw:File\"><a href=\"/wiki/Shell_Credit\" title=\"Shell Credit\"><img alt=\"Shell Credit\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"74\" height=\"74\" class=\"mw-file-element lazyload\" data-image-name=\"Item Shell Credit.png\" data-image-key=\"Item_Shell_Credit.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d1/Item_Shell_Credit.png/revision/latest/scale-to-width-down/74?cb=20240523132525\" /></a></span></span><span class=\"card-text card-font\"> 6,000</span></span></div></span></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t\t\t<div class=\"wds-tab__content\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"characters\">\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Feng\" title=\"Feng\">Feng</a>, <a href=\"/wiki/Rover\" title=\"Rover\">Rover</a>, <a href=\"/wiki/Yongli\" title=\"Yongli\">Yongli</a></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t</section>\n\n\n\n\n</section>\n</aside>\n<b>Danger! Explosive!</b> is a <a href=\"/wiki/Side_Quest\" title=\"Side Quest\">Side Quest</a> that occurs in <a href=\"/wiki/Dim_Forest\" title=\"Dim Forest\">Dim Forest</a>, <a href=\"/wiki/Huanglong\" title=\"Huanglong\">Huanglong</a>, [[{{{nation}}}]]. It can be started by detonating the Explosive Charges.\n<p class=\"mw-empty-elt\"></p>\n<figure class=\"thumb  show-info-icon\" typeof=\"mw:File/Thumb\" style=\"width: 180px\"> \t<a href=\"https://static.wikia.nocookie.net/wutheringwaves/images/f/f9/Screenshot_2024-09-09_005648.png/revision/latest?cb=20240909075949\" class=\"mw-file-description image\"><img alt=\"Location of Exile Yongli.\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/f/f9/Screenshot_2024-09-09_005648.png/revision/latest/scale-to-width-down/180?cb=20240909075949\" decoding=\"async\" loading=\"lazy\" width=\"180\" height=\"121\" class=\"thumbimage\" data-image-name=\"Screenshot 2024-09-09 005648.png\" data-image-key=\"Screenshot_2024-09-09_005648.png\" data-relevant=\"1\" /></a> \t \t<figcaption class=\"thumbcaption\"> \t\t \t\t\t<a href=\"/wiki/File:Screenshot_2024-09-09_005648.png\" class=\"info-icon\"><svg><use xlink:href=\"#wds-icons-info-small\"></use></svg></a> \t\t \t\t \t\t \t\t\t<p class=\"caption\">Location of Exile Yongli.</p> \t\t \t</figcaption> </figure>\n<div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Steps\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Steps</span></a></li>\n<li class=\"toclevel-1 tocsection-2\"><a href=\"#Dialogue\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">Dialogue</span></a></li>\n<li class=\"toclevel-1 tocsection-3\"><a href=\"#Video_Guides\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">Video Guides</span></a></li>\n<li class=\"toclevel-1 tocsection-4\"><a href=\"#Other_Languages\"><span class=\"tocnumber\">4</span> <span class=\"toctext\">Other Languages</span></a></li>\n<li class=\"toclevel-1 tocsection-5\"><a href=\"#Change_History\"><span class=\"tocnumber\">5</span> <span class=\"toctext\">Change History</span></a></li>\n</ul>\n</div>\n\n<h2><span class=\"mw-headline\" id=\"Steps\">Steps</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<ol><li>Talk to Exile Yongli</li>\n<li>Collect Explosive Charges in the Exiles camp</li>\n<li>Talk to Exile Feng</li>\n<li>Collect ingredients and deliver them to Feng</li>\n<li>Collect the remaining Explosive Charges from Feng</li>\n<li>Deliver Explosive Charges</li>\n<li>Blast the Rock Wall\n<ul><li>Talk to the Exiles (0ptional)</li>\n<li>Detonate Explosive Charges</li></ul></li>\n<li>Defeat the attacking Exiles</li>\n<li>Talk to Exile Yongli</li></ol>\n<h2><span class=\"mw-headline\" id=\"Dialogue\">Dialogue</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<div class=\"dialogue\">\n<dl><dt>(Optional - Approach Yongli)</dt>\n<dd><b>Yongli:</b> Don't come any closer!</dd>\n<dd><b>Yongli:</b> Stay right there! Just stand right there and no sudden movements!</dd>\n<dd><b>Yongli:</b> Hey! I'm talking to you! Another step forward and I'll drop it! I swear I will!</dd>\n<dd><b>Yongli:</b> I've got more than enough Explosive Charges here with me. Don't push your luck, or I'll make sure you know I'm not fooling around.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" /></span></span> I'm just passing by.</dd>\n<dd><b>Yongli:</b> Do you think I'm going to fall for that? A-Anyway, this isn't a place for you. I can't guarantee your safety if you get any closer!</dd></dl>\n<dl><dt>(Optional - Approach Yongli again)</dt>\n<dd><b>Yongli:</b> Do you not understand what I'm saying?</dd>\n<dd><b>Yongli:</b> Are you trying to die? Get out of here!</dd></dl>\n<hr />\n<dl><dt>(Upon detonating the Explosive Charges)</dt>\n<dd><b>Yongli:</b> Y-Y-Y-You...</dd>\n<dd><b>Yongli:</b> What have you done!!!</dd>\n<dd><b>Yongli:</b> My Explosive Charges...</dd>\n<dd><b>Yongli:</b> You almost got me killed!</dd></dl>\n</div>\n<hr />\n<dd><div class=\"description-wrapper\"><div class=\"description-title\"><b><span typeof=\"mw:File\"><span><img alt=\"UI Quest\" src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0f/UI_Quest.png/revision/latest/scale-to-width-down/20?cb=20260501180345\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element\" data-image-name=\"UI Quest.png\" data-image-key=\"UI_Quest.png\" data-relevant=\"0\" /></span></span> Quest Description</b></div><hr class=\"description-separator\" /><div class=\"description-content\">On the hillside, Exile Yongli is surrounded by Explosive Charges. You detonated all of the charges out of impulse. Go listen to what he has to say.</div></div></dd>\n<div class=\"dialogue\">\n<dl><dt>(Talk to Yongli)</dt>\n<dd><b>Yongli:</b> The Explosive Charges I had before all got stolen by the other camps. I finally managed to collect these, and now...</dd>\n<dd><b>Yongli:</b> My future life depended on those thirty Explosive Charges!</dd>\n<dd><b>Yongli:</b> *sigh* Forget it, I might as well just suck it up. It's not like I spent hours collecting them or anything.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Why were you collecting them?</dd>\n<dd><b>Yongli:</b> With Explosive Charges, my buddies and I can blast open that rock formation under the hill.</dd>\n<dd><b>Yongli:</b> The minerals inside should be enough to pay for my medical bills in the city...</dd>\n<dd><b>Yongli:</b> Ah! I've said too much... Why did I even tell you that?!</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> How about I go collect some for you?\n<dl><dd><b>Yongli:</b> R-really? That's great! Thank you!</dd>\n<dd><b>Yongli:</b> Here's some heads up for you.</dd>\n<dd><b>Yongli:</b> Explosive Charges that are freshly picked tend to be very unstable. Even the slightest amount of vibration or change in temperature can cause them to explode.</dd>\n<dd><b>Yongli:</b> Me and my buddies went through a ton of effort processing and stabilizing those we had earlier.</dd>\n<dd><b>Yongli:</b> You definitely won't make it in time if you go pick them up now.</dd>\n<dd><b>Yongli:</b> However, the Exile camps nearby should have plenty of charges stocked up, some of them might even be ours.</dd>\n<dd><b>Yongli:</b> You can try out your luck around those camps.</dd></dl></dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Exit\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Exit.png\" data-image-key=\"Icon_Dialogue_Exit.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/6/66/Icon_Dialogue_Exit.png/revision/latest/scale-to-width-down/20?cb=20240526052042\" /></span></span> You'll get enough one day.</dd></dl>\n<dl><dt>(Optional - Talk to Yongli again)</dt>\n<dd><b>Yongli:</b> Well, that's the gist of it. Anything else you wanna know?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Where can I find Explosive Charges?\n<dl><dd><b>Yongli:</b> The Exile camps nearby should have plenty of charges stocked up. You can try out your luck there.</dd></dl></dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Exit\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Exit.png\" data-image-key=\"Icon_Dialogue_Exit.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/6/66/Icon_Dialogue_Exit.png/revision/latest/scale-to-width-down/20?cb=20240526052042\" /></span></span> I don't have anything to ask.\n<dl><dd><b>Yongli:</b> I'll leave you to it then!</dd></dl></dd></dl>\n</div>\n<hr />\n<dd><div class=\"description-wrapper\"><div class=\"description-title\"><b><span typeof=\"mw:File\"><span><img alt=\"UI Quest\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"UI Quest.png\" data-image-key=\"UI_Quest.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0f/UI_Quest.png/revision/latest/scale-to-width-down/20?cb=20260501180345\" /></span></span> Quest Description</b></div><hr class=\"description-separator\" /><div class=\"description-content\">After talking to Exile Yongli, you decide to help him by collecting Explosive Charges as compensation for your reckless behavior. There are usable Explosive Charges in the Exiles camp in the Dim Forest. Go check it out.</div></div></dd>\n<div class=\"dialogue\">\n<dl><dt>(Read transcript)</dt>\n<dd><b>Exile Supply Manager:</b> Uhh... B-Boss... I was going over our supplies, and we're missing some of the Explosive Charges we hauled a couple of days ago. Like ten or so...</dd>\n<dd><b>Exile Leader:</b> You say how many??!! Are you trying to make me end you? You had one job!</dd>\n<dd><b>Exile Supply Manager:</b> Wait! Boss!! I-I... I tracked down the one who did it!</dd>\n<dd><b>Exile Supply Manager:</b> It was that little brat <span class=\"text-help\"><b>Afeng</b></span>!</dd>\n<dd><b>Exile Supply Manager:</b> The guys told me the kid's been mumbling about some rare cooking ingredient, ever since he laid eyes on those charges. Said he wanted to cook with them or something...</dd>\n<dd><b>Exile Supply Manager:</b> They last saw him heading towards these coordinates!</dd>\n<dd><b>Exile Leader:</b> You idiot! Does that tiny brain of yours have any idea how much money those charges can make us? Get after them! NOW!</dd></dl>\n<dl><dd>Sounds like that <span class=\"text-help\"><b>Afeng</b></span> has a lot of Explosive Charges on him.</dd>\n<dd>The ones in this camp don't seem quite enough for Yongli. I should go find <span class=\"text-help\"><b>Afeng</b></span> once I'm done here.</dd></dl>\n</div>\n<hr />\n<dd><div class=\"description-wrapper\"><div class=\"description-title\"><b><span typeof=\"mw:File\"><span><img alt=\"UI Quest\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"UI Quest.png\" data-image-key=\"UI_Quest.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0f/UI_Quest.png/revision/latest/scale-to-width-down/20?cb=20260501180345\" /></span></span> Quest Description</b></div><hr class=\"description-separator\" /><div class=\"description-content\">You didn't manage to collect enough Explosive Charges for Yongli in the camp. You found out that a man named Feng stole some of the charges. Find a way to retrieve the remaining charges from him.</div></div></dd>\n<div class=\"dialogue\">\n<dl><dt>(Talk to Exile Feng)</dt>\n<dd><b>Feng:</b> Where did you come from? You... You got here because of the aroma, didn't you?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Aroma?\n<dl><dd><b>Feng:</b> It's a new recipe I just came up with, using Explosive Charges as one of the ingredients &#8212; Bomblicious.</dd>\n<dd><b>Feng:</b> And I know what you're thinking. Explosive Charges for cooking aren't the most popular choice, especially with the added risks.</dd>\n<dd><b>Feng:</b> But by correctly combining the properties of different ingredients with it, you'll be in for a treat of your lifetime.</dd>\n<dd><b>Feng:</b> I'm still missing a few key ingredients. Do you think you can help me get some?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Sure. But I want something in return.</dd>\n<dd><b>Feng:</b> What is it?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> I want ten Explosive Charges.</dd></dl></dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Arrow\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Arrow.png\" data-image-key=\"Icon_Dialogue_Arrow.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/4/41/Icon_Dialogue_Arrow.png/revision/latest/scale-to-width-down/20?cb=20240529052033\" /></span></span> I came here for the Explosive Charges.\n<dl><dd><b>Feng:</b> How did you know I had so many charges...? Ugh. Never mind...</dd></dl></dd>\n<dd><b>Feng:</b> You get me the rest of my ingredients, I complete my recipe, and the rest of the Explosive Charges are all yours.</dd>\n<dd><b>Feng:</b> I risked my life getting these out, can't let them go to waste.</dd>\n<dd><b>Feng:</b> Back to the chase. I still need <span class=\"text-help\"><b><a href=\"/wiki/Chromeshell\" title=\"Chromeshell\">Chromeshells</a>, <a href=\"/wiki/Perilla\" title=\"Perilla\">Perillas</a>, and <a href=\"/wiki/Gloom_Slough\" title=\"Gloom Slough\">Gloom Sloughs</a>. Three of each.</b></span> You think you can get them for me?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Deal.\n<dl><dd><b>Feng:</b> All right. I'll be right here.</dd></dl></dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Exit\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Exit.png\" data-image-key=\"Icon_Dialogue_Exit.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/6/66/Icon_Dialogue_Exit.png/revision/latest/scale-to-width-down/20?cb=20240526052042\" /></span></span> That's a lot of work. I think I'll pass.\n<dl><dd><b>Feng:</b> Okay then.</dd></dl></dd></dl>\n<hr />\n<dl><dt>(After submitting the required items)</dt>\n<dd><b>Feng:</b> Very nice. Didn't expect you to them this fast.</dd>\n<dd><b>Feng:</b> Now, time for the magic to happen. Just wait.</dd></dl>\n<dl><dd><b>After a brief moment, Afeng came back with a dish emitting a strange fragrance.</b></dd></dl>\n<dl><dd><b>Feng:</b> Consider this your lucky day, my friend. Not many people have the opportunity to taste such delicacy you know.</dd>\n<dd><b>Feng:</b> Go ahead. Take a mouthful.</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Is it... supposed to be in flames like that...?</dd>\n<dd><b>Feng:</b> Exactly. That's when you know you're having authentic \"Bomblicious.\"</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> I think I'll pass.\n<dl><dd><b>Feng:</b> Suit yourself. I'll enjoy it all to myself then.</dd>\n<dd><b>Feng:</b> Mmmhmm... The aroma... The wonderful texture... Ohhh...</dd></dl></dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Okay. Just one bite.\n<dl><dd><b>Feng:</b> Well? What do you think?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> It's unlike anything I've ever tasted before.</dd>\n<dd><b>Feng:</b> I knew it. No one can resist the spurring sensation.</dd>\n<dd><b>Feng:</b> Huh? Wait, your nose... You have smoke coming out of your nose...</dd></dl></dd>\n<dd><b>Feng:</b> Yes... That's the Explosive Charges doing their work. I can confidently say the new recipe is a success.</dd>\n<dd><b>Feng:</b> This recipe wouldn't have happened without you. As promised, the rest of my Explosive Charges are yours.</dd></dl>\n</div>\n<hr />\n<dd><div class=\"description-wrapper\"><div class=\"description-title\"><b><span typeof=\"mw:File\"><span><img alt=\"UI Quest\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"UI Quest.png\" data-image-key=\"UI_Quest.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0f/UI_Quest.png/revision/latest/scale-to-width-down/20?cb=20260501180345\" /></span></span> Quest Description</b></div><hr class=\"description-separator\" /><div class=\"description-content\">You helped Feng prepare a dish using Explosive Charges and got the rest of the charges. Now, bring all of the Explosive Charges you collected to Yongli.</div></div></dd>\n<div class=\"dialogue\">\n<dl><dt>(After submitting 30x Explosive Charges to Yongli)</dt>\n<dd><b>Yongli:</b> Wow. I can't believe you really came back with thirty of them!</dd>\n<dd><b>Yongli:</b> Great. Now we can proceed with our plans according to schedule.</dd>\n<dd><b>Yongli:</b> Say, you must've got a few tricks of your own if you managed to get those charges so fast. Why do you join us in our plan?</dd>\n<dd><b>Yongli:</b> If we can't get it done before nighttime, the other camps will definitely try to come seize the minerals. We could use the extra hand guarding the mining site.</dd>\n<dd><b>Yongli:</b> You help us guard the minerals, and we give you part of the cut. How does that sound?</dd>\n<dd><span class=\"mw-default-size\" typeof=\"mw:File\"><span><img alt=\"Icon Dialogue Talk\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Icon Dialogue Talk.png\" data-image-key=\"Icon_Dialogue_Talk.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/7/71/Icon_Dialogue_Talk.png/revision/latest/scale-to-width-down/20?cb=20240529051922\" /></span></span> Sounds good to me.</dd>\n<dd><b>Yongli:</b> Perfect. I need to split the Explosive Charge for my buddies. Wanna come with me?</dd>\n<dd><b>Yongli:</b> You don't wanna miss the fireworks!</dd></dl>\n</div>\n<hr />\n<dd><div class=\"description-wrapper\"><div class=\"description-title\"><b><span typeof=\"mw:File\"><span><img alt=\"UI Quest\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"UI Quest.png\" data-image-key=\"UI_Quest.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/0f/UI_Quest.png/revision/latest/scale-to-width-down/20?cb=20260501180345\" /></span></span> Quest Description</b></div><hr class=\"description-separator\" /><div class=\"description-content\">All Explosive Charges are ready. Accept Yongli's invitation and witness the detonation on-site.</div></div></dd>\n<div class=\"dialogue\">\n<dl><dt>(Optional - Talk to the Exiles)</dt>\n<dd><b>Yongli:</b> Haha. Do you want to do the honors?</dd>\n<dd><b>Yongli:</b> You looked like you knew your explosives well back there.</dd></dl>\n<dl><dt>(After detonating the Explosive Charges)</dt>\n<dd><b>Exile Leader:</b> Well, well, well. What do we have here? Looks like we got here just in time. The minerals are open for the taking.</dd>\n<dd><b>Exile Leader:</b> We appreciate you for blowing up the rocks for us.</dd>\n<dd><b>Yongli:</b> Oh, no you don't! You got away with our Explosive Charges, we're not letting you...</dd>\n<dd><b>Exile Leader:</b> Just shut yer trap. In this day and age, winner takes all. Get 'em!</dd></dl>\n<hr />\n<dl><dt>(Talk to Yongli after defeating the Exiles)</dt>\n<dd><b>Yongli:</b> Phew. Good thing we had you on our side, or else they would've gotten away with it again...</dd>\n<dd><b>Yongli:</b> Here's your cut of the minerals. We keep our word!</dd>\n<dd><b>Yongli:</b> And this box we blew out of the rocks... Take it with you as well! We wouldn't have had these minerals without you to begin with!</dd>\n<dd><b>Yongli:</b> Glad you decided to help out today. Now with these minerals, I can finally...</dd>\n<dd><b>Yongli:</b> *sigh* It's too early to say for sure. Don't wanna jinx it. Until we meet again!</dd>\n<dt>(Quest Complete)</dt></dl>\n</div>\n<p><br />\n</p>\n<h2><span class=\"mw-headline\" id=\"Video_Guides\">Video Guides</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<div class=\"thumb embedvideo autoResize\" style=\"width: 408px;\">\n\t\t\t<div class=\"embedvideo autoResize\" style=\"\">\n\t\t\t\t<div class=\"embedvideowrap\" style=\"width: 400px;\">\n<p>\t\t\t\t\t<iframe title=\"Play video\" src=\"//www.youtube.com/embed/vTucMIkXoY0?\" width=\"400\" height=\"225\" style=\"border: none;\" allowfullscreen=\"true\" loading=\"lazy\"></iframe>\n</p>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"thumbcaption\">Guide: Danger! Explosive!</div>\n\t\t\t</div>\n\t\t</div>\n<h2><span class=\"mw-headline\" id=\"Other_Languages\">Other Languages</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<table class=\"article-table alternating-colors-table\"><tbody><tr><th>Language</th><th>Official Name</th></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji EN Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji EN Flag.png\" data-image-key=\"Emoji_EN_Flag.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/f/f5/Emoji_EN_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221541\" /></span></span></span>&#160;&#160;English</b></td><td>Danger! Explosive!</td></tr><tr><td style=\"line-height:1em\"><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ZHS Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ZHS Flag.png\" data-image-key=\"Emoji_ZHS_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/5/5f/Emoji_ZHS_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221618\" /></span></span></span>&#160;&#160;Chinese <abbr title=\"Simplified\"><small>(S)</small></abbr></b></td><td><span lang=\"zh-Hans\">一触即炸</span></td></tr><tr><td style=\"line-height:1em\"><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ZHT Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ZHT Flag.png\" data-image-key=\"Emoji_ZHT_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/0/02/Emoji_ZHT_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221733\" /></span></span></span>&#160;&#160;Chinese <abbr title=\"Traditional\"><small>(T)</small></abbr></b></td><td><span lang=\"zh-Hant\">一觸即炸</span></td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji JA Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji JA Flag.png\" data-image-key=\"Emoji_JA_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/8/84/Emoji_JA_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221804\" /></span></span></span>&#160;&#160;Japanese</b></td><td><span lang=\"ja\">一触即発</span></td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji KO Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji KO Flag.png\" data-image-key=\"Emoji_KO_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/5/5d/Emoji_KO_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221837\" /></span></span></span>&#160;&#160;Korean</b></td><td><span lang=\"ko\">일촉즉발</span></td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji FR Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji FR Flag.png\" data-image-key=\"Emoji_FR_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/c/c6/Emoji_FR_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221935\" /></span></span></span>&#160;&#160;French</b></td><td>Prêt à exploser</td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji DE Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji DE Flag.png\" data-image-key=\"Emoji_DE_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/3/3b/Emoji_DE_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221959\" /></span></span></span>&#160;&#160;German</b></td><td>Achtung! Explosiv!</td></tr><tr><td><b><span class=\"flag\"><span typeof=\"mw:File\"><span><img alt=\"Emoji ES Flag\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"19\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Emoji ES Flag.png\" data-image-key=\"Emoji_ES_Flag.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/wutheringwaves/images/d/d2/Emoji_ES_Flag.png/revision/latest/scale-to-width-down/19?cb=20240529221908\" /></span></span></span>&#160;&#160;Spanish</b></td><td>¡Peligro! ¡Explosivo!</td></tr></tbody></table>\n<h2><span class=\"mw-headline\" id=\"Change_History\">Change History</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<div class=\"change-history\"><div class=\"change-history-header\"><div>Released in <b><a href=\"/wiki/Version/1.0\" title=\"Version/1.0\">Version 1.0</a></b></div><div>[<a target=\"_blank\" rel=\"noreferrer noopener\" class=\"text\" href=\"https://wutheringwaves.fandom.com/wiki/Danger!_Explosive!/Change_History?action=edit&amp;preload=Template:Change_History/Preload&amp;preloadparams%5b%5d=1.0&amp;preloadparams%5b%5d=Danger%21+Explosive%21\">Create New History</a>]</div></div></div><div style=\"clear:both; margin:0; padding:0;\"></div>\n</div>",
